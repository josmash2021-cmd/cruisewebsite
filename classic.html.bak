        <span class="c-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
        <div><span class="c-label">Horario</span>
          <span class="c-value">24 / 7</span>
          <span class="c-note">Siempre disponibles</span>
        </div>
      </div>
    </div>
    <form class="nm-card c-form reveal" id="contactForm">
      <div class="f-duo">
        <label><span>Nombre</span><input type="text" name="name" placeholder="Tu nombre" required></label>
        <label><span>Email</span><input type="email" name="email" placeholder="nombre@ejemplo.com" required></label>
      </div>
      <label><span>Asunto</span><input type="text" name="subject" placeholder="¿En qué podemos ayudarte?" required></label>
      <label><span>Mensaje</span><textarea name="message" rows="4" placeholder="Escribe tu mensaje..." required></textarea></label>
      <button type="submit" class="btn-gold">Enviar mensaje <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </form>
  </div>
</section>
</main>
