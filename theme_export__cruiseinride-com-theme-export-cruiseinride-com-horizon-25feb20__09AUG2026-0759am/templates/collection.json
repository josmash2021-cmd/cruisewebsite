{
  "sections": {
    "custom_liquid_bnaxmA": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  Luxury 3D Experience v10 - PREMIUM COPYWRITING + VISUAL EXCELLENCE\n{% endcomment %}\n\n{% assign lang = localization.language.iso_code | slice: 0, 2 | downcase %}\n\n{% case lang %}\n  {% when 'es' %}\n    {% assign t_kicker = \"NUESTROS SERVICIOS\" %}\n    {% assign t_title_1 = \"Experiencia\" %}\n    {% assign t_title_2 = \"de Lujo\" %}\n    {% assign t_card_1_h = \"Traslados al Aeropuerto\" %}\n    {% assign t_card_1_p = \"Puntualidad absoluta y monitoreo de vuelos en tiempo real para una llegada sin complicaciones.\" %}\n    {% assign t_card_1_m1 = \"Protocolo VIP\" %}\n    {% assign t_card_1_m2 = \"Puntualidad\" %}\n\n    {% assign t_card_2_h = \"Viajes Corporativos\" %}\n    {% assign t_card_2_p = \"Soluciones de transporte ejecutivo con la discreción y el profesionalismo que su negocio exige.\" %}\n    {% assign t_card_2_m1 = \"Ejecutivo\" %}\n    {% assign t_card_2_m2 = \"Confidencial\" %}\n\n    {% assign t_card_3_h = \"Eventos Especiales\" %}\n    {% assign t_card_3_p = \"Hacemos que sus bodas, galas y celebraciones trasciendan con un servicio de clase mundial.\" %}\n    {% assign t_card_3_m1 = \"Elegancia\" %}\n    {% assign t_card_3_m2 = \"Exclusivo\" %}\n\n    {% assign t_card_4_h = \"Chófer Privado\" %}\n    {% assign t_card_4_p = \"Conductores certificados y vehículos impecables dedicados exclusivamente a su seguridad y confort.\" %}\n    {% assign t_card_4_m1 = \"Certificado\" %}\n    {% assign t_card_4_m2 = \"Seguro\" %}\n  {% else %}\n    {% assign t_kicker = \"OUR SERVICES\" %}\n    {% assign t_title_1 = \"Luxury\" %}\n    {% assign t_title_2 = \"Experience\" %}\n    {% assign t_card_1_h = \"Airport Transfers\" %}\n    {% assign t_card_1_p = \"Absolute punctuality and real-time flight tracking for a seamless and stress-free arrival.\" %}\n    {% assign t_card_1_m1 = \"VIP Protocol\" %}\n    {% assign t_card_1_m2 = \"On-time\" %}\n\n    {% assign t_card_2_h = \"Corporate Travel\" %}\n    {% assign t_card_2_p = \"Executive travel solutions with the discretion and professionalism your business demands.\" %}\n    {% assign t_card_2_m1 = \"Executive\" %}\n    {% assign t_card_2_m2 = \"Discreet\" %}\n\n    {% assign t_card_3_h = \"Special Events\" %}\n    {% assign t_card_3_p = \"Ensure your weddings, galas, and celebrations transcend with a world-class chauffeur service.\" %}\n    {% assign t_card_3_m1 = \"Elegant\" %}\n    {% assign t_card_3_m2 = \"Exclusive\" %}\n\n    {% assign t_card_4_h = \"Private Chauffeur\" %}\n    {% assign t_card_4_p = \"Certified drivers and pristine vehicles dedicated exclusively to your safety and comfort.\" %}\n    {% assign t_card_4_m1 = \"Certified\" %}\n    {% assign t_card_4_m2 = \"Secure\" %}\n{% endcase %}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600;800&display=swap\" rel=\"stylesheet\">\n\n<section class=\"lux-v10\" id=\"lux-{{ section.id }}\">\n  <div class=\"lux-aura-layer\"><div class=\"lux-aura-blob\"></div></div>\n\n  <div class=\"lux-bg-wrapper\">\n    <video class=\"lux-bg-video\" autoplay muted loop playsinline preload=\"auto\">\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/cb31b737a60344fd8c84530668cbbf25.mp4\" type=\"video/mp4\" />\n    </video>\n    <div class=\"lux-bg-overlay\"></div>\n  </div>\n\n  <div class=\"lux-container\">\n    <header class=\"lux-header-hero\">\n      <div class=\"lux-kicker-line\"><span class=\"lux-kicker-text\">{{ t_kicker }}</span></div>\n      <h2 class=\"lux-liquid-title\">\n        <span class=\"lux-text-white\">{{ t_title_1 }}</span>\n        <span class=\"lux-text-gold\">{{ t_title_2 }}</span>\n      </h2>\n    </header>\n\n    <div class=\"lux-grid-v10\">\n      <article class=\"lux-card-v10\">\n        <div class=\"lux-card-inner\">\n          <div class=\"lux-card-shine\"></div>\n          <div class=\"lux-card-content\">\n            <div class=\"lux-icon-wrap\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\">\n                <path d=\"M2 12h20M13 2v20M21 8l-3-3 3-3M3 16l3 3-3 3\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/>\n              </svg>\n            </div>\n            <h3 class=\"lux-card-title\">{{ t_card_1_h }}</h3>\n            <p class=\"lux-card-desc\">{{ t_card_1_p }}</p>\n            <div class=\"lux-card-meta\"><span>{{ t_card_1_m1 }}</span><span>{{ t_card_1_m2 }}</span></div>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"lux-card-v10\">\n        <div class=\"lux-card-inner\">\n          <div class=\"lux-card-shine\"></div>\n          <div class=\"lux-card-content\">\n            <div class=\"lux-icon-wrap\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\">\n                <rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M12 12v.01M3 13h18\"/>\n              </svg>\n            </div>\n            <h3 class=\"lux-card-title\">{{ t_card_2_h }}</h3>\n            <p class=\"lux-card-desc\">{{ t_card_2_p }}</p>\n            <div class=\"lux-card-meta\"><span>{{ t_card_2_m1 }}</span><span>{{ t_card_2_m2 }}</span></div>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"lux-card-v10\">\n        <div class=\"lux-card-inner\">\n          <div class=\"lux-card-shine\"></div>\n          <div class=\"lux-card-content\">\n            <div class=\"lux-icon-wrap\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\">\n                <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/>\n              </svg>\n            </div>\n            <h3 class=\"lux-card-title\">{{ t_card_3_h }}</h3>\n            <p class=\"lux-card-desc\">{{ t_card_3_p }}</p>\n            <div class=\"lux-card-meta\"><span>{{ t_card_3_m1 }}</span><span>{{ t_card_3_m2 }}</span></div>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"lux-card-v10\">\n        <div class=\"lux-card-inner\">\n          <div class=\"lux-card-shine\"></div>\n          <div class=\"lux-card-content\">\n            <div class=\"lux-icon-wrap\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\">\n                <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4\"/>\n              </svg>\n            </div>\n            <h3 class=\"lux-card-title\">{{ t_card_4_h }}</h3>\n            <p class=\"lux-card-desc\">{{ t_card_4_p }}</p>\n            <div class=\"lux-card-meta\"><span>{{ t_card_4_m1 }}</span><span>{{ t_card_4_m2 }}</span></div>\n          </div>\n        </div>\n      </article>\n    </div>\n  </div>\n</section>\n\n<style>\n  :root {\n    --gold: #c9a23a;\n    --glass: rgba(10, 10, 15, 0.22);\n    --stroke: rgba(255, 255, 255, 0.1);\n    --ease: cubic-bezier(.22,1,.36,1);\n  }\n\n  /* Fondo negro en el wrapper de Shopify */\n  #shopify-section-{{ section.id }}{\n    background:#000 !important;\n  }\n\n .lux-v10 {\n  position: relative;\n  padding: 120px 24px;\n  background: #000;\n  color: #fff;\n  overflow: hidden;   /* ← fix scroll horizontal */\n  box-shadow:\n    0 -80px 60px -10px #000,\n    0 80px 60px -10px #000;\n}\n\n\n  .lux-bg-wrapper { position: absolute; inset: 0; z-index: 0; overflow: hidden; }\n  .lux-bg-video { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.55) contrast(1.1); }\n  .lux-bg-overlay {\n    position: absolute; inset: 0;\n    background:\n      linear-gradient(to bottom, #000 0%, rgba(0,0,0,.5) 8%, transparent 20%),\n      linear-gradient(to top, #000 0%, rgba(0,0,0,.5) 8%, transparent 20%),\n      radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.65) 100%);\n  }\n\n  .lux-aura-layer { position: absolute; inset: 0; z-index: 1; pointer-events: none; }\n  .lux-aura-blob { position: absolute; top: 10%; left: 5%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(201, 162, 58, 0.04) 0%, transparent 70%); filter: blur(60px); animation: auraFloat 12s infinite alternate ease-in-out; }\n  @keyframes auraFloat { 0% { transform: translate(0,0); } 100% { transform: translate(40px, 80px); } }\n\n  .lux-container { position: relative; max-width: 1400px; margin: 0 auto; z-index: 5; }\n\n  .lux-header-hero {\n    text-align: center;\n    margin-bottom: 70px;\n    opacity: 0;\n    transform: translateY(18px) scale(.99);\n    filter: blur(6px);\n    transition:\n      opacity .8s var(--ease),\n      transform .8s var(--ease),\n      filter .8s var(--ease);\n  }\n\n  .lux-kicker-line,\n  .lux-liquid-title {\n    opacity: 0;\n    transform: translateY(14px);\n    transition:\n      opacity .7s var(--ease),\n      transform .7s var(--ease);\n  }\n\n  .lux-kicker-line { transition-delay: .1s; }\n  .lux-liquid-title { transition-delay: .25s; }\n\n  .lux-grid-v10 {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 25px;\n    justify-items: center;\n  }\n\n  .lux-card-v10 {\n    position: relative;\n    width: 100%;\n    height: 440px;\n    cursor: default;\n    opacity: 0;\n    transform: translateY(20px) scale(.99);\n    filter: blur(6px);\n    transition:\n      opacity .75s var(--ease),\n      transform .75s var(--ease),\n      filter .75s var(--ease);\n  }\n\n  .lux-card-v10:nth-child(1) { transition-delay: .4s; }\n  .lux-card-v10:nth-child(2) { transition-delay: .55s; }\n  .lux-card-v10:nth-child(3) { transition-delay: .7s; }\n  .lux-card-v10:nth-child(4) { transition-delay: .85s; }\n\n  .lux-v10.is-visible .lux-header-hero {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n    filter: blur(0);\n  }\n  .lux-v10.is-visible .lux-kicker-line,\n  .lux-v10.is-visible .lux-liquid-title {\n    opacity: 1;\n    transform: translateY(0);\n  }\n  .lux-v10.is-visible .lux-card-v10 {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n    filter: blur(0);\n  }\n\n  .lux-kicker-line { display: flex; align-items: center; justify-content: center; gap: 15px; margin-bottom: 20px; }\n  .lux-kicker-line::before, .lux-kicker-line::after { content: \"\"; width: 30px; height: 1px; background: var(--gold); opacity: 0.4; }\n  .lux-kicker-text { font-size: 11px; letter-spacing: 0.6em; color: var(--gold); font-weight: 700; }\n  .lux-liquid-title { font-family: 'Cinzel', serif; font-size: clamp(40px, 7vw, 85px); line-height: 0.95; display: flex; flex-direction: column; align-items: center; }\n  .lux-text-gold { background: linear-gradient(to right, #c9a23a, #f1d279, #c9a23a); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shineGold 6s linear infinite; }\n  @keyframes shineGold { to { background-position: 200% center; } }\n\n  .lux-card-inner {\n    position: relative; width: 100%; height: 100%;\n    background: linear-gradient(150deg, rgba(30, 30, 35, 0.4) 0%, rgba(10, 10, 15, 0.7) 100%);\n    border-radius: 30px; padding: 45px 25px;\n    border-top: 1px solid rgba(255, 255, 255, 0.15);\n    border-left: 1px solid rgba(255, 255, 255, 0.1);\n    border-bottom: 1px solid rgba(0, 0, 0, 0.8);\n    border-right: 1px solid rgba(0, 0, 0, 0.6);\n    box-shadow: 12px 12px 24px rgba(0, 0, 0, 0.8), -4px -4px 12px rgba(255, 255, 255, 0.03), inset 1px 1px 2px rgba(255, 255, 255, 0.1), inset -1px -1px 3px rgba(0, 0, 0, 0.4);\n    backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);\n    display: flex; flex-direction: column; align-items: center; text-align: center;\n    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .lux-card-shine { position: absolute; inset: 0; background: radial-gradient(circle at var(--x, 50%) var(--y, 50%), rgba(255, 255, 255, 0.05) 0%, transparent 60%); border-radius: 30px; opacity: 0; transition: opacity 0.5s ease; pointer-events: none; }\n  .lux-card-v10:hover .lux-card-shine { opacity: 1; }\n\n  .lux-card-content { position: relative; z-index: 2; height: 100%; width: 100%; display: flex; flex-direction: column; align-items: center; }\n\n  .lux-icon-wrap {\n    width: 75px; height: 75px;\n    background: linear-gradient(135deg, rgba(201, 162, 58, 0.12), rgba(201, 162, 58, 0.02));\n    border: 1px solid rgba(201, 162, 58, 0.2);\n    border-top: 1px solid rgba(201, 162, 58, 0.4);\n    border-bottom: 1px solid rgba(0, 0, 0, 0.5);\n    border-radius: 22px; display: grid; place-items: center;\n    color: var(--gold); margin-bottom: 30px;\n    transition: background 0.5s ease, color 0.5s ease, box-shadow 0.5s ease;\n    flex-shrink: 0;\n    box-shadow: 0 8px 16px rgba(0,0,0,0.4), inset 0 2px 4px rgba(255,255,255,0.05);\n    perspective: 500px;\n  }\n\n  .lux-icon-wrap svg {\n    width: 32px; height: 32px;\n    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));\n    transition: transform 0.1s ease-out;\n    will-change: transform;\n  }\n\n  .lux-card-title { font-family: 'Cinzel', serif; font-size: 22px; margin: 0 0 15px; color: #fff; letter-spacing: 0.03em; line-height: 1.2; width: 100%; text-shadow: 0 4px 10px rgba(0,0,0,0.5); }\n  .lux-card-desc { font-size: 14.5px; color: rgba(255,255,255,0.75); margin: 0 0 25px; line-height: 1.6; flex-grow: 1; max-width: 280px; text-shadow: 0 2px 4px rgba(0,0,0,0.4); }\n\n  .lux-card-meta { display: flex; gap: 10px; margin-top: auto; justify-content: center; width: 100%; }\n  .lux-card-meta span { font-size: 9px; font-weight: 700; text-transform: uppercase; padding: 6px 14px; background: rgba(255,255,255,0.06); border-radius: 100px; border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.5); letter-spacing: 0.05em; }\n\n  .lux-card-v10:hover .lux-card-inner { border-top-color: rgba(201,162,58,0.3); background: rgba(20, 20, 25, 0.6); box-shadow: 15px 15px 30px rgba(0,0,0,0.9); }\n  .lux-card-v10:hover .lux-icon-wrap { background: var(--gold); color: #000; box-shadow: 0 10px 20px rgba(201, 162, 58, 0.3); }\n\n  @media (max-width: 1100px) { .lux-grid-v10 { grid-template-columns: repeat(2, 1fr); gap: 20px; } }\n\n  @media (max-width: 650px) {\n    .lux-v10 { padding: 40px 15px; }\n    .lux-grid-v10 { display: flex; flex-direction: column; align-items: center; gap: 30px; }\n    .lux-card-v10 { height: auto; width: 280px; max-width: 280px; margin: 0 auto; }\n    .lux-card-inner { padding: 20px 15px; border-radius: 20px; }\n    .lux-icon-wrap { width: 55px; height: 55px; margin-bottom: 12px; }\n    .lux-card-title { font-size: 20px; margin-bottom: 8px; line-height: 1.1; }\n    .lux-card-desc { font-size: 14.5px; margin-bottom: 15px; line-height: 1.3; }\n    .lux-card-meta { margin-top: 5px; }\n    .lux-card-meta span { font-size: 9px; padding: 4px 10px; }\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .lux-header-hero,\n    .lux-kicker-line,\n    .lux-liquid-title,\n    .lux-card-v10 {\n      transition: none !important;\n      opacity: 1 !important;\n      transform: none !important;\n      filter: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function() {\n    const section = document.getElementById('lux-{{ section.id }}');\n    if(!section) return;\n\n    const observer = new IntersectionObserver((entries)=>{\n      entries.forEach(entry=>{\n        if(entry.isIntersecting){\n          section.classList.add('is-visible');\n        } else {\n          section.classList.remove('is-visible');\n        }\n      });\n    },{\n      threshold: 0.15\n    });\n\n    observer.observe(section);\n\n    const c = section.querySelectorAll('.lux-card-v10');\n    if (window.innerWidth > 1024) {\n      c.forEach(card => {\n        const svg = card.querySelector('.lux-icon-wrap svg');\n        const sh = card.querySelector('.lux-card-shine');\n\n        card.addEventListener('mousemove', e => {\n          const r = card.getBoundingClientRect();\n          const x = (e.clientX - r.left) / r.width - 0.5;\n          const y = (e.clientY - r.top) / r.height - 0.5;\n\n          svg.style.transform = `rotateX(${y * -45}deg) rotateY(${x * 45}deg) scale(1.2) translateZ(10px)`;\n\n          sh.style.setProperty('--x', `${(e.clientX - r.left) / r.width * 100}%`);\n          sh.style.setProperty('--y', `${(e.clientY - r.top) / r.height * 100}%`);\n        });\n\n        card.addEventListener('mouseleave', () => {\n          svg.style.transform = `rotateX(0deg) rotateY(0deg) scale(1) translateZ(0px)`;\n          svg.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';\n          setTimeout(() => {\n            svg.style.transition = 'transform 0.1s ease-out';\n          }, 600);\n        });\n      });\n    }\n  })();\n</script>",
        "color_scheme": "scheme-58084d4c-a86e-4d0a-855e-a0966e5043f7",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
