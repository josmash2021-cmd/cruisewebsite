    "custom_liquid_yGxqUE": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<!-- VIP SERVICE SECTION (Slow Luxury Text Animations, No Scroll Animation) -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600;800&display=swap\" rel=\"stylesheet\">\n\n<section class=\"vipX\" id=\"vip-service\" aria-label=\"VIP Service\">\n\n  <!-- Background Video -->\n  <div class=\"vipX__bg\" aria-hidden=\"true\">\n    <video class=\"vipX__video\" autoplay muted loop playsinline preload=\"metadata\">\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/f3a11ffc3ca7407e9f7d62511e7da1cc.mp4\" type=\"video/mp4\">\n    </video>\n    <div class=\"vipX__overlay\"></div>\n  </div>\n\n  <div class=\"vipX__wrap\">\n    <div class=\"vipX__content\">\n      <div class=\"vipX__kicker\">VIP SERVICE</div>\n\n      <h2 class=\"vipX__title\">\n        Premium Private <span>Transportation</span>\n      </h2>\n\n      <p class=\"vipX__desc\">\n        Enjoy a first-class experience with our exclusive VIP transportation service.\n        Designed for airport transfers, executive travel, special events, and luxury comfort.\n        Professional drivers. Absolute privacy. Maximum elegance.\n      </p>\n\n      <a href=\"/products/vip-service\" class=\"vipX__btn\">\n        BOOK YOUR RIDE NOW\n      </a>\n    </div>\n  </div>\n</section>\n\n<style>\n:root{\n  --gold1:#f5d77a;\n  --gold2:#d4af37;\n  --gold3:#b98d1c;\n}\n\n/* SECTION (sin transición de scroll, fijo) */\n.vipX{\n  position:relative;\n  min-height:100vh;\n  padding:120px 20px;\n  color:white;\n  overflow:hidden;\n\n  opacity:1;\n  transform:none;\n  filter:none;\n}\n\n/* Background */\n.vipX__bg{\n  position:absolute;\n  inset:0;\n  z-index:-2;\n  overflow:hidden;\n  background:#000;\n}\n\n.vipX__video{\n  position:absolute;\n  inset:0;\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  transform:none;\n}\n\n/* Sombreado superior + inferior */\n.vipX__overlay{\n  position:absolute;\n  inset:0;\n  background:\n    linear-gradient(to bottom,\n      rgba(0,0,0,1) 0%,\n      rgba(0,0,0,.85) 12%,\n      rgba(0,0,0,.55) 25%,\n      rgba(0,0,0,0) 45%\n    ),\n    linear-gradient(to top,\n      rgba(0,0,0,1) 0%,\n      rgba(0,0,0,.90) 15%,\n      rgba(0,0,0,.60) 30%,\n      rgba(0,0,0,0) 55%\n    ),\n    radial-gradient(circle at 50% 35%,\n      rgba(212,175,55,.15),\n      transparent 60%\n    );\n}\n\n/* Content */\n.vipX__wrap{\n  max-width:1000px;\n  margin:auto;\n  text-align:center;\n  position:relative;\n  z-index:2;\n}\n\n/* =========\n   ANIMACIÓN LENTA (solo al cargar)\n   ========= */\n.vipX__content{\n  --ease: cubic-bezier(.2,.8,.2,1);\n  opacity:0;\n  transform: translateY(22px);\n  filter: blur(6px);\n  animation: vipIn 2.2s var(--ease) forwards;\n}\n\n.vipX__kicker,\n.vipX__title,\n.vipX__desc,\n.vipX__btn{\n  opacity:0;\n  transform: translateY(18px);\n  animation: vipUp 2.2s var(--ease) forwards;\n}\n\n/* Stagger */\n.vipX__kicker{ animation-delay: .20s; }\n.vipX__title { animation-delay: .40s; }\n.vipX__desc  { animation-delay: .62s; }\n.vipX__btn   { animation-delay: .85s; }\n\n@keyframes vipIn{\n  to{\n    opacity:1;\n    transform: translateY(0);\n    filter: blur(0);\n  }\n}\n@keyframes vipUp{\n  to{\n    opacity:1;\n    transform: translateY(0);\n  }\n}\n\n/* Typography */\n.vipX__kicker{\n  letter-spacing:.45em;\n  font-size:12px;\n  color:var(--gold2);\n  margin-bottom:20px;\n  font-family:\"Inter\", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n  text-transform:uppercase;\n}\n\n.vipX__title{\n  font-family:\"Cinzel\", serif;\n  font-size:clamp(48px,5vw,82px);\n  line-height:1.05;\n  margin:0;\n}\n.vipX__title span{ color:var(--gold2); }\n\n.vipX__desc{\n  max-width:700px;\n  margin:30px auto;\n  opacity:.75;\n  line-height:1.7;\n  font-family:\"Inter\", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n}\n\n/* Button */\n.vipX__btn{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  margin-top:30px;\n  height:45px;\n  padding:0 20px;\n  border-radius:14px;\n  text-decoration:none;\n\n  font-weight:800;\n  letter-spacing:.25em;\n  font-size:12px;\n  text-transform:uppercase;\n  font-family:\"Inter\", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n\n  background:linear-gradient(135deg,var(--gold1) 0%,var(--gold2) 40%,var(--gold3) 100%);\n  color:#111;\n  border:1px solid rgba(255,215,120,.6);\n\n  box-shadow:\n    0 0 0 1px rgba(255,215,120,.2),\n    0 20px 45px rgba(212,175,55,.35),\n    0 30px 80px rgba(0,0,0,.7);\n\n  transition:transform .3s ease, box-shadow .3s ease;\n}\n\n.vipX__btn:hover{\n  transform:translateY(-4px);\n  box-shadow:\n    0 0 25px rgba(255,215,120,.6),\n    0 25px 60px rgba(212,175,55,.5),\n    0 40px 100px rgba(0,0,0,.8);\n}\n\n/* Reduce motion */\n@media (prefers-reduced-motion: reduce){\n  .vipX__content,\n  .vipX__kicker,\n  .vipX__title,\n  .vipX__desc,\n  .vipX__btn{\n    animation:none !important;\n    opacity:1 !important;\n    transform:none !important;\n    filter:none !important;\n  }\n}\n</style>",
