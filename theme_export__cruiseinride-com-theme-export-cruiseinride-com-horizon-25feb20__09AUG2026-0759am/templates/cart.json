      "settings": {
        "custom_liquid": "<!-- CONTACT SECTION – FULL CLEAN VERSION -->\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap\" rel=\"stylesheet\">\n\n<section class=\"contactX\" id=\"contact\" aria-label=\"Contact\">\n\n  <!-- VIDEO BACKGROUND -->\n  <div class=\"contactX__bg\" aria-hidden=\"true\">\n    <video class=\"contactX__video\" autoplay muted loop playsinline preload=\"metadata\">\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/f3a11ffc3ca7407e9f7d62511e7da1cc.mp4\" type=\"video/mp4\">\n    </video>\n    <div class=\"contactX__overlay\"></div>\n  </div>\n\n  <div class=\"contactX__wrap\">\n\n    <header class=\"contactX__head\">\n      <div class=\"contactX__kicker\">CONTACT</div>\n      <h2 class=\"contactX__title\">\n        We are here to <span class=\"contactX__accent\">serve you</span>\n      </h2>\n    </header>\n\n    <div class=\"contactX__grid\">\n\n      <!-- INFO CARDS -->\n      <div class=\"contactX__cards\">\n\n        <!-- PHONE -->\n        <div class=\"contactX__card\">\n          <div class=\"contactX__icon contactX__icon--outline\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n              <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2\n              19.86 19.86 0 0 1-8.63-3.07\n              19.5 19.5 0 0 1-6-6\n              19.86 19.86 0 0 1-3.07-8.67\n              A2 2 0 0 1 4.11 2h3\n              a2 2 0 0 1 2 1.72\n              c.12.89.33 1.76.63 2.6\n              a2 2 0 0 1-.45 2.11L8.09 9.91\n              a16 16 0 0 0 6 6l1.48-1.48\n              a2 2 0 0 1 2.11-.45\n              c.84.3 1.71.51 2.6.63\n              A2 2 0 0 1 22 16.92z\"/>\n            </svg>\n          </div>\n          <div class=\"contactX__cardTitle\">Phone</div>\n          <div class=\"contactX__cardText\">+1 (659) 305-2974</div>\n        </div>\n\n        <!-- EMAIL -->\n        <div class=\"contactX__card\">\n          <div class=\"contactX__icon contactX__icon--outline\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n              <rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/>\n              <path d=\"M3 7l9 6 9-6\"/>\n            </svg>\n          </div>\n          <div class=\"contactX__cardTitle\">Email</div>\n          <div class=\"contactX__cardText\">royalpurplecorp@gmail.com</div>\n        </div>\n\n        <!-- HOURS -->\n        <div class=\"contactX__card contactX__card--wide\">\n          <div class=\"contactX__icon contactX__icon--circle\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n              <path d=\"M12 7v5l3 2\"/>\n            </svg>\n          </div>\n          <div class=\"contactX__cardTitle\">Hours</div>\n          <div class=\"contactX__cardText\">24/7</div>\n        </div>\n\n      </div>\n\n      <!-- FORM -->\n      <aside class=\"contactX__panel\">\n        <div class=\"contactX__panelTitle\">Send us a message</div>\n\n        <form class=\"contactX__form\">\n          <div class=\"contactX__row\">\n            <input class=\"contactX__input\" placeholder=\"Your name\" required>\n            <input class=\"contactX__input\" type=\"email\" placeholder=\"your@email.com\" required>\n          </div>\n\n          <input class=\"contactX__input\" placeholder=\"Message subject\">\n          <textarea class=\"contactX__textarea\" placeholder=\"Write your message...\" required></textarea>\n\n          <button class=\"contactX__btn\" type=\"submit\">\n            SEND MESSAGE ✈\n          </button>\n        </form>\n      </aside>\n\n    </div>\n  </div>\n</section>\n\n<style>\n:root{\n  --gold:#c9a23a;\n}\n\n/* SECTION */\n.contactX{\n  position:relative;\n  min-height:95vh;\n  padding:100px 16px;\n  color:white;\n  overflow:hidden;\n  font-family:\"Inter\",sans-serif;\n}\n\n/* Background */\n.contactX__bg{\n  position:absolute;\n  inset:0;\n  z-index:-2;\n  background:#000;\n}\n.contactX__video{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n}\n.contactX__overlay{\n  position:absolute;\n  inset:0;\n  background:\n    linear-gradient(to bottom,rgba(0,0,0,1) 0%,rgba(0,0,0,.6) 25%,transparent 45%),\n    linear-gradient(to top,rgba(0,0,0,1) 0%,rgba(0,0,0,.7) 25%,transparent 55%),\n    radial-gradient(circle at 50% 18%,rgba(201,162,58,.14),transparent 62%);\n}\n\n/* Layout */\n.contactX__wrap{\n  max-width:1100px;\n  margin:auto;\n  text-align:center;\n}\n.contactX__kicker{\n  letter-spacing:.4em;\n  font-size:12px;\n  color:var(--gold);\n}\n.contactX__title{\n  font-family:\"Cinzel\",serif;\n  font-size:clamp(34px,8vw,70px);\n}\n.contactX__accent{\n  color:var(--gold);\n}\n\n/* Grid */\n.contactX__grid{\n  display:grid;\n  grid-template-columns:1fr 1.3fr;\n  gap:40px;\n}\n@media(max-width:980px){\n  .contactX__grid{grid-template-columns:1fr;}\n}\n\n/* Cards */\n.contactX__cards{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:18px;\n}\n@media(max-width:520px){\n  .contactX__cards{grid-template-columns:1fr;}\n}\n\n.contactX__card{\n  background:rgba(20,22,25,.55);\n  backdrop-filter:blur(12px);\n  border:1px solid rgba(255,255,255,.14);\n  border-radius:16px;\n  padding:26px 20px;\n  text-align:center;\n  box-shadow:0 20px 60px rgba(0,0,0,.65);\n}\n.contactX__card--wide{\n  grid-column:1/-1;\n}\n@media(max-width:520px){\n  .contactX__card--wide{grid-column:auto;}\n}\n\n.contactX__icon{\n  width:60px;height:60px;\n  margin:0 auto 14px;\n  border-radius:16px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  background:var(--gold);\n  color:black;\n  font-size:22px;\n}\n\n.contactX__icon--outline{\n  background:transparent;\n  border:1px solid var(--gold);\n  color:var(--gold);\n}\n\n.contactX__icon--circle{\n  border-radius:999px;\n  border:1px solid var(--gold);\n  background:rgba(0,0,0,.15);\n  color:var(--gold);\n}\n\n.contactX__cardTitle{\n  font-family:\"Cinzel\";\n  font-size:17px;\n  margin-bottom:6px;\n}\n.contactX__cardText{\n  opacity:.75;\n  font-size:14px;\n}\n\n/* Panel */\n.contactX__panel{\n  background:rgba(20,22,25,.55);\n  backdrop-filter:blur(12px);\n  border:1px solid rgba(255,255,255,.14);\n  border-radius:16px;\n  padding:26px;\n  text-align:center;\n  box-shadow:0 26px 70px rgba(0,0,0,.7);\n}\n.contactX__panelTitle{\n  font-family:\"Cinzel\";\n  margin-bottom:18px;\n  font-size:20px;\n}\n\n/* FORM */\n.contactX__form{\n  display:flex;\n  flex-direction:column;\n  gap:14px;\n}\n.contactX__row{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:14px;\n}\n@media(max-width:600px){\n  .contactX__row{grid-template-columns:1fr;}\n}\n\n.contactX__input,\n.contactX__textarea{\n  background:#ffffff !important;\n  border:1px solid rgba(0,0,0,.15) !important;\n  padding:14px;\n  border-radius:10px;\n  color:#000 !important;\n  font-weight:500;\n  outline:none;\n}\n\n.contactX__input::placeholder,\n.contactX__textarea::placeholder{\n  color:rgba(0,0,0,.45);\n}\n\n.contactX__input:focus,\n.contactX__textarea:focus{\n  border:1px solid var(--gold) !important;\n}\n\n.contactX__btn{\n  background:var(--gold);\n  color:black;\n  height:54px;\n  border-radius:12px;\n  font-weight:800;\n  letter-spacing:.2em;\n  cursor:pointer;\n  border:none;\n  transition:.25s;\n}\n.contactX__btn:hover{\n  transform:translateY(-3px);\n}\n</style>",
