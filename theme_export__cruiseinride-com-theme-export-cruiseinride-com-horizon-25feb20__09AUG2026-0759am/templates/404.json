    "custom_liquid_JL99eM": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% assign current_lang = localization.language.iso_code | default: shop.locale | slice: 0,2 | downcase %}\n{% if current_lang != 'es' %}{% assign current_lang = 'en' %}{% endif %}\n\n<!-- CONTACT SECTION -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600;800&display=swap\" rel=\"stylesheet\">\n\n<section class=\"contactX\" id=\"contact-{{ section.id }}\" aria-label=\"{% if current_lang == 'es' %}Contacto{% else %}Contact{% endif %}\" data-lang=\"{{ current_lang }}\">\n\n  <div class=\"contactX__bg\" aria-hidden=\"true\">\n    <video class=\"contactX__video\" autoplay muted loop playsinline preload=\"auto\">\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/f3a11ffc3ca7407e9f7d62511e7da1cc.mp4\" type=\"video/mp4\">\n    </video>\n    <div class=\"contactX__overlay\"></div>\n    <div class=\"contactX__sharpen\"></div>\n    <div class=\"contactX__vignette\"></div>\n  </div>\n\n  <div class=\"contactX__wrap\">\n\n    <header class=\"contactX__head\">\n      <div class=\"contactX__kicker\" data-text-en=\"CONTACT\" data-text-es=\"CONTACTO\">\n        {% if current_lang == 'es' %}CONTACTO{% else %}CONTACT{% endif %}\n      </div>\n      <h2 class=\"contactX__title\">\n        {% if current_lang == 'es' %}\n          Estamos aquí para <span class=\"contactX__accent\">servirte</span>\n        {% else %}\n          We are here to <span class=\"contactX__accent\">serve you</span>\n        {% endif %}\n      </h2>\n      <div class=\"contactX__divider\" aria-hidden=\"true\">\n        <span></span>\n        <span>◆</span>\n        <span></span>\n      </div>\n    </header>\n\n    <div class=\"contactX__grid\">\n\n      <div class=\"contactX__cards\">\n\n        <!-- PHONE -->\n        <div class=\"contactX__card\" data-animate=\"card-up\" data-delay=\"0\">\n          <div class=\"contactX__card-glow\"></div>\n          <div class=\"contactX__icon contactX__icon--outline\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n              <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.86 19.86 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.89.33 1.76.63 2.6a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.48-1.48a2 2 0 0 1 2.11-.45c.84.3 1.71.51 2.6.63A2 2 0 0 1 22 16.92z\"/>\n            </svg>\n          </div>\n          <div class=\"contactX__cardTitle\" data-text-en=\"Phone\" data-text-es=\"Teléfono\">\n            {% if current_lang == 'es' %}Teléfono{% else %}Phone{% endif %}\n          </div>\n          <div class=\"contactX__cardText\">\n            <a href=\"tel:+16593052974\">+1 (659) 305-2974</a>\n          </div>\n          <div class=\"contactX__card-action\">\n            <a href=\"https://wa.me/16593052974\" target=\"_blank\" class=\"contactX__whatsapp\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"/>\n              </svg>\n              {% if current_lang == 'es' %}WhatsApp{% else %}WhatsApp{% endif %}\n            </a>\n          </div>\n        </div>\n\n        <!-- EMAIL -->\n        <div class=\"contactX__card\" data-animate=\"card-up\" data-delay=\"150\">\n          <div class=\"contactX__card-glow\"></div>\n          <div class=\"contactX__icon contactX__icon--outline\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n              <rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/>\n              <path d=\"M3 7l9 6 9-6\"/>\n            </svg>\n          </div>\n          <div class=\"contactX__cardTitle\" data-text-en=\"Email\" data-text-es=\"Correo\">\n            {% if current_lang == 'es' %}Correo{% else %}Email{% endif %}\n          </div>\n          <div class=\"contactX__cardText\">\n            <a href=\"mailto:SUPPORT@CRUISEINRIDE.COM\">SUPPORT@CRUISEINRIDE.COM</a>\n          </div>\n          <div class=\"contactX__card-action\">\n            <button class=\"contactX__copy\" onclick=\"navigator.clipboard.writeText('SUPPORT@CRUISEINRIDE.COM'); this.textContent='{% if current_lang == 'es' %}¡Copiado!{% else %}Copied!{% endif %}'; setTimeout(() => this.textContent='{% if current_lang == 'es' %}Copiar{% else %}Copy{% endif %}', 2000)\">\n              {% if current_lang == 'es' %}Copiar{% else %}Copy{% endif %}\n            </button>\n          </div>\n        </div>\n\n        <!-- HOURS -->\n        <div class=\"contactX__card contactX__card--wide\" data-animate=\"card-up\" data-delay=\"300\">\n          <div class=\"contactX__card-glow\"></div>\n          <div class=\"contactX__icon contactX__icon--circle\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n              <path d=\"M12 7v5l3 2\"/>\n            </svg>\n          </div>\n          <div class=\"contactX__cardTitle\" data-text-en=\"Hours\" data-text-es=\"Horario\">\n            {% if current_lang == 'es' %}Horario{% else %}Hours{% endif %}\n          </div>\n          <div class=\"contactX__cardText contactX__cardText--highlight\">24/7</div>\n          <div class=\"contactX__card-subtext\" data-text-en=\"Always available for you\" data-text-es=\"Siempre disponibles para ti\">\n            {% if current_lang == 'es' %}Siempre disponibles para ti{% else %}Always available for you{% endif %}\n          </div>\n        </div>\n\n      </div>\n\n      <!-- FORM -->\n      <aside class=\"contactX__panel\" data-animate=\"fade-up\" data-delay=\"450\">\n        <div class=\"contactX__panel-glow\"></div>\n        <div class=\"contactX__panelTitle\" data-text-en=\"Send us a message\" data-text-es=\"Envíanos un mensaje\">\n          {% if current_lang == 'es' %}Envíanos un mensaje{% else %}Send us a message{% endif %}\n        </div>\n\n        <form class=\"contactX__form\" action=\"https://formspree.io/f/YOUR_FORM_ID\" method=\"POST\">\n          <div class=\"contactX__row\">\n            <div class=\"contactX__field\">\n              <input class=\"contactX__input\" name=\"name\" placeholder=\"{% if current_lang == 'es' %}Tu nombre{% else %}Your name{% endif %}\" required>\n              <label class=\"contactX__label\">{% if current_lang == 'es' %}Nombre{% else %}Name{% endif %}</label>\n            </div>\n            <div class=\"contactX__field\">\n              <input class=\"contactX__input\" name=\"email\" type=\"email\" placeholder=\"{% if current_lang == 'es' %}tu@email.com{% else %}your@email.com{% endif %}\" required>\n              <label class=\"contactX__label\">Email</label>\n            </div>\n          </div>\n\n          <div class=\"contactX__field\">\n            <input class=\"contactX__input\" name=\"subject\" placeholder=\"{% if current_lang == 'es' %}Asunto del mensaje{% else %}Message subject{% endif %}\">\n            <label class=\"contactX__label\" data-text-en=\"Subject\" data-text-es=\"Asunto\">{% if current_lang == 'es' %}Asunto{% else %}Subject{% endif %}</label>\n          </div>\n\n          <div class=\"contactX__field\">\n            <textarea class=\"contactX__textarea\" name=\"message\" placeholder=\"{% if current_lang == 'es' %}Escribe tu mensaje...{% else %}Write your message...{% endif %}\" required></textarea>\n            <label class=\"contactX__label\" data-text-en=\"Message\" data-text-es=\"Mensaje\">{% if current_lang == 'es' %}Mensaje{% else %}Message{% endif %}</label>\n          </div>\n\n          <button class=\"contactX__btn\" type=\"submit\">\n            <span class=\"contactX__btn-text\" data-text-en=\"SEND MESSAGE\" data-text-es=\"ENVIAR MENSAJE\">\n              {% if current_lang == 'es' %}ENVIAR MENSAJE{% else %}SEND MESSAGE{% endif %}\n            </span>\n            <span class=\"contactX__btn-icon\">✈</span>\n            <span class=\"contactX__btn-shine\"></span>\n          </button>\n        </form>\n      </aside>\n\n    </div>\n  </div>\n</section>\n\n<style>\n:root{\n  --gold:#c9a23a;\n  --gold-light:#f5d77a;\n  --gold-dark:#b98d1c;\n  --ease:cubic-bezier(.16,1,.3,1);\n  --ease-back:cubic-bezier(.34,1.56,.64,1);\n  --tSlow:2400ms;\n  --tMed:1700ms;\n}\n\n/* Fondo negro en el wrapper de Shopify */\n#shopify-section-{{ section.id }}{\n  background:#000 !important;\n}\n\n.contactX{\n  position:relative;\n  isolation:isolate;\n  z-index:1;\n  min-height:95vh;\n  padding:120px 16px;\n  margin-top:0;\n  margin-bottom:0;\n  color:white;\n  overflow:visible;\n  box-shadow:\n    0 -60px 40px -10px #000;\n  font-family:\"Inter\",sans-serif;\n}\n\n/* GRADIENT BLEND — 300px de alto, negro solido largo */\n.contactX::before,\n.contactX::after{\n  content:'';\n  position:absolute;\n  left:0;\n  right:0;\n  height:150px;\n  z-index:3;\n  pointer-events:none;\n}\n.contactX::before{\n  top:-80px;\n  background:linear-gradient(to bottom,\n    #000 0%,\n    #000 40%,\n    rgba(0,0,0,.6) 70%,\n    transparent 100%\n  );\n}\n.contactX::after{\n  bottom:0;\n  background:linear-gradient(to top,\n    #000 0%,\n    rgba(0,0,0,.6) 40%,\n    rgba(0,0,0,.3) 70%,\n    transparent 100%\n  );\n}\n\n.contactX__bg{\n  position:absolute;\n  inset:0;\n  z-index:-1;\n  background:#000;\n  overflow:hidden;\n}\n\n.contactX__video{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  transform:scale(1.02);\n  filter:contrast(1.2) saturate(1.15) brightness(1.08);\n  image-rendering:-webkit-optimize-contrast;\n  image-rendering:crisp-edges;\n  -webkit-transform:translateZ(0);\n  transform:translateZ(0);\n  backface-visibility:hidden;\n  will-change:transform;\n}\n\n.contactX__overlay{\n  position:absolute;\n  inset:0;\n  background:\n    linear-gradient(to bottom,rgba(0,0,0,.85) 0%,rgba(0,0,0,.4) 20%,transparent 45%),\n    linear-gradient(to top,rgba(0,0,0,.85) 0%,rgba(0,0,0,.5) 20%,transparent 50%),\n    radial-gradient(circle at 50% 18%,rgba(201,162,58,.14),transparent 62%);\n}\n\n.contactX__sharpen{\n  position:absolute;\n  inset:0;\n  backdrop-filter:contrast(1.1) saturate(1.05);\n  pointer-events:none;\n  opacity:0.3;\n}\n\n.contactX__vignette{\n  position:absolute;\n  inset:0;\n  background:radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,.4) 100%);\n  pointer-events:none;\n}\n\n.contactX__wrap{\n  max-width:1100px;\n  margin:auto;\n  text-align:center;\n  position:relative;\n  z-index:2;\n}\n\n.contactX__head{\n  margin-bottom:50px;\n}\n.contactX__kicker{\n  letter-spacing:.45em;\n  font-size:12px;\n  color:var(--gold);\n  font-weight:600;\n  margin-bottom:15px;\n  display:inline-block;\n  padding:8px 16px;\n  border:1px solid rgba(201,162,58,.3);\n  border-radius:50px;\n  background:rgba(201,162,58,.1);\n  backdrop-filter:blur(10px);\n}\n.contactX__title{\n  font-family:\"Cinzel\",serif;\n  font-size:clamp(34px,8vw,70px);\n  margin:0;\n  line-height:1.1;\n}\n.contactX__accent{\n  color:var(--gold);\n  position:relative;\n  display:inline-block;\n}\n.contactX__accent::after{\n  content:'';\n  position:absolute;\n  bottom:-5px;\n  left:0;\n  right:0;\n  height:3px;\n  background:linear-gradient(90deg, transparent, var(--gold), transparent);\n  border-radius:3px;\n}\n\n.contactX__divider{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  gap:15px;\n  margin-top:25px;\n}\n.contactX__divider span:first-child,\n.contactX__divider span:last-child{\n  width:80px;\n  height:1px;\n  background:linear-gradient(90deg, transparent, var(--gold), transparent);\n}\n.contactX__divider span:nth-child(2){\n  color:var(--gold);\n  font-size:12px;\n  animation:diamondRotate 4s linear infinite;\n}\n\n@keyframes diamondRotate{\n  0%{ transform:rotate(0deg); }\n  100%{ transform:rotate(360deg); }\n}\n\n.contactX__grid{\n  display:grid;\n  grid-template-columns:1fr 1.3fr;\n  gap:40px;\n  align-items:start;\n}\n@media(max-width:980px){\n  .contactX__grid{grid-template-columns:1fr;}\n}\n\n.contactX__cards{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:18px;\n}\n@media(max-width:520px){\n  .contactX__cards{grid-template-columns:1fr;}\n}\n\n.contactX__card{\n  position:relative;\n  background:rgba(20,22,25,.55);\n  backdrop-filter:blur(12px);\n  border:1px solid rgba(255,255,255,.14);\n  border-radius:20px;\n  padding:30px 22px;\n  text-align:center;\n  box-shadow:0 20px 60px rgba(0,0,0,.65);\n  overflow:hidden;\n  transition:\n    transform var(--tMed) var(--ease),\n    border-color var(--tMed) var(--ease),\n    box-shadow var(--tMed) var(--ease);\n  will-change:transform;\n}\n\n.contactX__card-glow{\n  position:absolute;\n  inset:-2px;\n  background:radial-gradient(ellips