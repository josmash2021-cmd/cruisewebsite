      "settings": {
        "custom_liquid": "{% assign current_lang = localization.language.iso_code | default: shop.locale | slice: 0,2 | downcase %}\n{% if current_lang != 'es' %}{% assign current_lang = 'en' %}{% endif %}\n\n<!-- CONTACT SECTION -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600;800&display=swap\" rel=\"stylesheet\">\n\n<section class=\"contactX\" id=\"contact-{{ section.id }}\" aria-label=\"{% if current_lang == 'es' %}Contacto{% else %}Contact{% endif %}\" data-lang=\"{{ current_lang }}\">\n\n  <div class=\"contactX__bg\" aria-hidden=\"true\">\n    <video class=\"contactX__video\" autoplay muted loop playsinline preload=\"metadata\">\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/f3a11ffc3ca7407e9f7d62511e7da1cc.mp4\" type=\"video/mp4\">\n    </video>\n    <div class=\"contactX__overlay\"></div>\n    <div class=\"contactX__sharpen\"></div>\n    <div class=\"contactX__vignette\"></div>\n  </div>\n\n  <div class=\"contactX__wrap\">\n\n    <header class=\"contactX__head\">\n      <div class=\"contactX__kicker\">\n        {% if current_lang == 'es' %}CONTACTO{% else %}CONTACT{% endif %}\n      </div>\n      <h2 class=\"contactX__title\">\n        {% if current_lang == 'es' %}\n          Estamos aquí para <span class=\"contactX__accent\">servirte</span>\n        {% else %}\n          We are here to <span class=\"contactX__accent\">serve you</span>\n        {% endif %}\n      </h2>\n      <div class=\"contactX__divider\" aria-hidden=\"true\">\n        <span></span>\n        <span>◆</span>\n        <span></span>\n      </div>\n    </header>\n\n    <div class=\"contactX__grid\">\n\n      <div class=\"contactX__cards\">\n\n        <div class=\"contactX__card\">\n          <div class=\"contactX__icon contactX__icon--outline\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n              <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.86 19.86 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.89.33 1.76.63 2.6a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.48-1.48a2 2 0 0 1 2.11-.45c.84.3 1.71.51 2.6.63A2 2 0 0 1 22 16.92z\"/>\n            </svg>\n          </div>\n          <div class=\"contactX__cardTitle\">\n            {% if current_lang == 'es' %}Teléfono{% else %}Phone{% endif %}\n          </div>\n          <div class=\"contactX__cardText\">\n            <a href=\"tel:+16593052974\">+1 (659) 305-2974</a>\n          </div>\n          <div class=\"contactX__card-action\">\n            <a href=\"https://wa.me/16593052974\" target=\"_blank\" class=\"contactX__whatsapp\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"/>\n              </svg>\n              {% if current_lang == 'es' %}WhatsApp{% else %}WhatsApp{% endif %}\n            </a>\n          </div>\n        </div>\n\n        <div class=\"contactX__card\">\n          <div class=\"contactX__icon contactX__icon--outline\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n              <rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/>\n              <path d=\"M3 7l9 6 9-6\"/>\n            </svg>\n          </div>\n          <div class=\"contactX__cardTitle\">\n            {% if current_lang == 'es' %}Correo{% else %}Email{% endif %}\n          </div>\n          <div class=\"contactX__cardText\">\n            <a href=\"mailto:SUPPORT@CRUISEINRIDE.COM\">SUPPORT@CRUISEINRIDE.COM</a>\n          </div>\n          <div class=\"contactX__card-action\">\n            <button class=\"contactX__copy\" onclick=\"navigator.clipboard.writeText('SUPPORT@CRUISEINRIDE.COM'); this.textContent='{% if current_lang == 'es' %}¡Copiado!{% else %}Copied!{% endif %}'; setTimeout(() => this.textContent='{% if current_lang == 'es' %}Copiar{% else %}Copy{% endif %}', 2000)\">\n              {% if current_lang == 'es' %}Copiar{% else %}Copy{% endif %}\n            </button>\n          </div>\n        </div>\n\n        <div class=\"contactX__card contactX__card--wide\">\n          <div class=\"contactX__icon contactX__icon--circle\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n              <path d=\"M12 7v5l3 2\"/>\n            </svg>\n          </div>\n          <div class=\"contactX__cardTitle\">\n            {% if current_lang == 'es' %}Horario{% else %}Hours{% endif %}\n          </div>\n          <div class=\"contactX__cardText contactX__cardText--highlight\">24/7</div>\n          <div class=\"contactX__card-subtext\">\n            {% if current_lang == 'es' %}Siempre disponibles para ti{% else %}Always available for you{% endif %}\n          </div>\n        </div>\n\n      </div>\n\n      <aside class=\"contactX__panel\">\n        <div class=\"contactX__panelTitle\">\n          {% if current_lang == 'es' %}Envíanos un mensaje{% else %}Send us a message{% endif %}\n        </div>\n\n        <form class=\"contactX__form\" action=\"https://formspree.io/f/YOUR_FORM_ID\" method=\"POST\">\n          <div class=\"contactX__row\">\n            <div class=\"contactX__field\">\n              <input class=\"contactX__input\" name=\"name\" placeholder=\"{% if current_lang == 'es' %}Tu nombre{% else %}Your name{% endif %}\" required>\n            </div>\n            <div class=\"contactX__field\">\n              <input class=\"contactX__input\" name=\"email\" type=\"email\" placeholder=\"{% if current_lang == 'es' %}tu@email.com{% else %}your@email.com{% endif %}\" required>\n            </div>\n          </div>\n\n          <div class=\"contactX__field\">\n            <input class=\"contactX__input\" name=\"subject\" placeholder=\"{% if current_lang == 'es' %}Asunto del mensaje{% else %}Message subject{% endif %}\">\n          </div>\n\n          <div class=\"contactX__field\">\n            <textarea class=\"contactX__textarea\" name=\"message\" placeholder=\"{% if current_lang == 'es' %}Escribe tu mensaje...{% else %}Write your message...{% endif %}\" required></textarea>\n          </div>\n\n          <button class=\"contactX__btn\" type=\"submit\">\n            <span class=\"contactX__btn-text\">\n              {% if current_lang == 'es' %}ENVIAR MENSAJE{% else %}SEND MESSAGE{% endif %}\n            </span>\n            <span class=\"contactX__btn-icon\">✈</span>\n          </button>\n        </form>\n      </aside>\n\n    </div>\n  </div>\n</section>\n\n<style>\n:root{\n  --gold:#c9a23a;\n  --gold-light:#f5d77a;\n  --gold-dark:#b98d1c;\n}\n\n#shopify-section-{{ section.id }}{ background:#000 !important; }\n\n.contactX{\n  position:relative;isolation:isolate;z-index:1;\n  min-height:95vh;padding:120px 16px;\n  color:white;overflow:visible;\n  box-shadow:0 -60px 40px -10px #000;\n  font-family:\"Inter\",sans-serif;\n}\n.contactX::before,.contactX::after{\n  content:'';position:absolute;left:0;right:0;height:150px;z-index:3;pointer-events:none;\n}\n.contactX::before{top:-80px;background:linear-gradient(to bottom,#000 0%,#000 40%,rgba(0,0,0,.6) 70%,transparent 100%);}\n.contactX::after{bottom:0;background:linear-gradient(to top,#000 0%,rgba(0,0,0,.6) 40%,rgba(0,0,0,.3) 70%,transparent 100%);}\n\n.contactX__bg{position:absolute;inset:0;z-index:-1;background:#000;overflow:hidden;}\n.contactX__video{\n  width:100%;height:100%;object-fit:cover;\n  transform:scale(1.02) translateZ(0);\n  filter:contrast(1.2) saturate(1.15) brightness(1.08);\n  backface-visibility:hidden;\n}\n.contactX__overlay{\n  position:absolute;inset:0;\n  background:\n    linear-gradient(to bottom,rgba(0,0,0,.85) 0%,rgba(0,0,0,.4) 20%,transparent 45%),\n    linear-gradient(to top,rgba(0,0,0,.85) 0%,rgba(0,0,0,.5) 20%,transparent 50%),\n    radial-gradient(circle at 50% 18%,rgba(201,162,58,.14),transparent 62%);\n}\n.contactX__sharpen{position:absolute;inset:0;backdrop-filter:contrast(1.1) saturate(1.05);pointer-events:none;opacity:.3;}\n.contactX__vignette{position:absolute;inset:0;background:radial-gradient(ellipse at center,transparent 50%,rgba(0,0,0,.4) 100%);pointer-events:none;}\n\n.contactX__wrap{max-width:1100px;margin:auto;text-align:center;position:relative;z-index:2;}\n\n.contactX__head{margin-bottom:50px;}\n.contactX__kicker{\n  letter-spacing:.45em;font-size:12px;color:var(--gold);font-weight:600;\n  margin-bottom:15px;display:inline-block;padding:8px 16px;\n  border:1px solid rgba(201,162,58,.3);border-radius:50px;\n  background:rgba(201,162,58,.1);\n}\n.contactX__title{font-family:\"Cinzel\",serif;font-size:clamp(34px,8vw,70px);margin:0;line-height:1.1;}\n.contactX__accent{color:var(--gold);position:relative;display:inline-block;}\n.contactX__accent::after{\n  content:'';position:absolute;bottom:-5px;left:0;right:0;height:3px;\n  background:linear-gradient(90deg,transparent,var(--gold),transparent);border-radius:3px;\n}\n.contactX__divider{display:flex;align-items:center;justify-content:center;gap:15px;margin-top:25px;}\n.contactX__divider span:first-child,\n.contactX__divider span:last-child{width:80px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);}\n.contactX__divider span:nth-child(2){color:var(--gold);font-size:12px;}\n\n.contactX__grid{display:grid;grid-template-columns:1fr 1.3fr;gap:40px;align-items:start;}\n@media(max-width:980px){.contactX__grid{grid-template-columns:1fr;}}\n\n.contactX__cards{display:grid;grid-template-columns:1fr 1fr;gap:18px;}\n\n.contactX__card{\n  position:relative;background:rgba(20,22,25,.55);backdrop-filter:blur(12px);\n  border:1px solid rgba(255,255,255,.14);border-radius:20px;padding:30px 22px;\n  text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.65);overflow:hidden;\n}\n.contactX__card--wide{grid-column:1/-1;}\n\n.contactX__icon{\n  width:60px;height:60px;margin:0 auto 16px;border-radius:16px;\n  display:flex;align-items:center;justify-content:center;\n  background:var(--gold);color:black;font-size:22px;\n  box-shadow:0 10px 30px rgba(201,162,58,.2);\n}\n.contactX__icon--outline{background:transparent;border:2px solid var(--gold);color:var(--gold);}\n.contactX__icon--circle{border-radius:999px;border:2px solid var(--gold);background:rgba(0,0,0,.15);color:var(--gold);}\n\n.contactX__cardTitle{font-family:\"Cinzel\";font-size:18px;font-weight:600;margin-bottom:8px;color:#fff;}\n.contactX__cardText{opacity:.85;font-size:14px;font-weight:500;}\n.contactX__cardText a{color:inherit;text-decoration:none;}\n.contactX__cardText--highlight{font-size:28px;font-weight:700;color:var(--gold);text-shadow:0 0 20px rgba(201,162,58,.3);}\n.contactX__card-subtext{font-size:12px;opacity:.6;margin-top:5px;}\n\n.contactX__card-action{margin-top:15px;}\n.contactX__whatsapp,.contactX__copy{\n  display:inline-flex;align-items:center;gap:8px;padding:8px 16px;\n  border-radius:25px;font-size:12px;font-weight:600;letter-spacing:.05em;\n  text-transform:uppercase;text-decoration:none;cursor:pointer;border:none;\n}\n.contactX__whatsapp{background:#25D366;color:white;}\n.contactX__copy{background:rgba(201,162,58,.2);color:var(--gold);border:1px solid rgba(201,162,58,.4);}\n\n.contactX__panel{\n  position:relative;background:rgba(20,22,25,.55);backdrop-filter:blur(12px);\n  border:1px solid rgba(255,255,255,.14);border-radius:20px;padding:35px;\n  text-align:left;box-shadow:0 26px 70px rgba(0,0,0,.7);overflow:hidden;\n}\n.contactX__panelTitle{font-family:\"Cinzel\";margin-bottom:25px;font-size:22px;font-weight:600;color:#fff;text-align:center;position:relative;}\n.contactX__panelTitle::after{\n  content:'';position:absolute;bottom:-10px;left:50%;transform:translateX(-50%);\n  width:60px;height:2px;\n  background:linear-gradient(90deg,transparent,var(--gold),transparent);\n}\n\n.contactX__form{display:flex;flex-direction:column;gap:20px;}\n.contactX__row{display:grid;grid-template-columns:1fr 1fr;gap:20px;}\n\n.contactX__field{position:relative;}\n\n.contactX__input,.contactX__textarea,\n.contactX input[type=\"text\"],.contactX input[type=\"email\"],.contactX textarea{\n  display:block !important;width:100% !important;\n  background:rgba(0,0,0,.4) !important;\n  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);\n  border:1px solid rgba(255,255,255,.2) !important;\n  padding:16px;border-radius:12px;\n  color:var(--gold) !important;font-weight:500;font-size:16px;\n  font-family:\"Inter\",sans-serif;outline:none !important;\n  -webkit-appearance:none;appearance:none;\n  box-sizing:border-box !important;\n}\n.contactX__input:focus,.contactX__textarea:focus,.contactX inp