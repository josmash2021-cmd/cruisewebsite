.vrLT__step.is-active .vrLT__dot{background:#fff;border-color:#E8C547;transform:scale(1.25);box-shadow:0 0 0 5px rgba(232,197,71,.18),0 0 18px rgba(232,197,71,.65);animation:vrLTpulse2 1.9s infinite}
@keyframes vrLTpulse2{0%,100%{box-shadow:0 0 0 5px rgba(232,197,71,.15),0 0 18px rgba(232,197,71,.6)}50%{box-shadow:0 0 0 8px rgba(232,197,71,.25),0 0 24px rgba(232,197,71,.8)}}
.vrLT__stepLbl{font:700 9px/1.1 'Inter',sans-serif;color:rgba(255,255,255,.45);letter-spacing:.08em;text-transform:uppercase;text-align:center;white-space:nowrap;transition:color .35s}
