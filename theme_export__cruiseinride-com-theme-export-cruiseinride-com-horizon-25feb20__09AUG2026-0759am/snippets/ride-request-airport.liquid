.vrLT__driver{display:flex;align-items:center;gap:14px;padding:16px 22px;border-top:1px solid rgba(255,255,255,.05);border-bottom:1px solid rgba(255,255,255,.05);background:rgba(255,255,255,.015)}
.vrLT__avatarRing{position:relative;width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#E8C547,#fff4c6 50%,#d4af37);padding:2px;flex-shrink:0}
