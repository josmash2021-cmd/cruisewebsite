.vrApt__dirCard--v .vrApt__dirTitle{font-family:'Poppins',sans-serif;font-size:20px;font-weight:700;color:#fff;letter-spacing:-.02em;line-height:1.25;}
.vrApt__dirCard--v .vrApt__dirSub{font-size:12px;color:rgba(255,255,255,.5);max-width:240px;}
.vrApt__dirIcon--big{position:relative;width:min(55%,190px)!important;height:auto!important;aspect-ratio:1/1!important;border-radius:22px;background:rgba(255,255,255,.04)!important;border:1px solid rgba(232,197,71,.18);backdrop-filter:blur(20px) saturate(140%);-webkit-backdrop-filter:blur(20px) saturate(140%);overflow:hidden;display:flex;align-items:center;justify-content:center;padding:14px;box-shadow:0 6px 20px rgba(0,0,0,.45),0 0 0 4px rgba(232,197,71,.06),inset 0 1px 0 rgba(255,255,255,.05);transition:border-color 180ms,box-shadow 180ms;}
.vrApt__dirIcon--big::after{content:'\2192';position:absolute;right:8px;top:8px;width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#E8C547,#FBE47A);color:#0a0e1a;font-size:13px;font-weight:900;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(232,197,71,.5),inset 0 1px 0 rgba(255,255,255,.5);z-index:3;}
.vrApt__dirCard--v{width:100%!important;max-width:100%!important;padding:10px 0!important;}
.vrApt__dirIconImg{width:100%;height:100%;object-fit:contain;display:block;filter:drop-shadow(0 8px 20px rgba(0,0,0,.55));}

/* Speed flight animation */
@keyframes vrAptFlyTo{
  0%{transform:translateX(0) translateY(0) rotate(0deg);}
  50%{transform:translateX(10px) translateY(-8px) rotate(2deg);}
  100%{transform:translateX(0) translateY(0) rotate(0deg);}
}
@keyframes vrAptFlyFrom{
  0%{transform:translateX(0) translateY(0) rotate(0deg);}
  50%{transform:translateX(-10px) translateY(4px) rotate(-2deg);}
  100%{transform:translateX(0) translateY(0) rotate(0deg);}
}
.vrApt__dirCard[data-vrapt-dir="to"] .vrApt__dirIconImg{animation:vrAptFlyTo 4.5s ease-in-out infinite;transform-origin:center;will-change:transform;}
.vrApt__dirCard[data-vrapt-dir="from"] .vrApt__dirIconImg{animation:vrAptFlyFrom 4.5s ease-in-out infinite;transform-origin:center;will-change:transform;}

/* Plane motion effect — subtle idle hover + radial glow trail (no streak lines) */
.vrApt__dirCard[data-vrapt-dir="to"] .vrApt__dirIconImg{animation:vrAptPlaneTo 3.6s ease-in-out infinite;transform-origin:center;}
.vrApt__dirCard[data-vrapt-dir="from"] .vrApt__dirIconImg{animation:vrAptPlaneFrom 3.6s ease-in-out infinite;transform-origin:center;}
@keyframes vrAptPlaneTo{0%,100%{transform:translate(0,0) rotate(0);}50%{transform:translate(4px,-5px) rotate(1.5deg);}}
@keyframes vrAptPlaneFrom{0%,100%{transform:translate(0,0) rotate(0);}50%{transform:translate(-4px,-4px) rotate(-1.5deg);}}
/* Soft glowing trail — single smooth ellipse that follows the plane direction */
.vrApt__dirIcon--big{position:relative;isolation:isolate;}
.vrApt__dirCard[data-vrapt-dir] .vrApt__dirIconImg{position:relative;z-index:2;}
.vrApt__dirCard[data-vrapt-dir] .vrApt__dirIcon--big::before{
  content:'';position:absolute;inset:15% 0;pointer-events:none;z-index:1;
  background:radial-gradient(ellipse 55% 40% at 50% 50%,rgba(232,197,71,.35) 0%,rgba(232,197,71,.18) 25%,rgba(255,255,255,.08) 50%,transparent 75%);
  filter:blur(8px);
  opacity:0;
  animation:vrAptGlow 3.6s ease-in-out infinite;
}
@keyframes vrAptGlow{
  0%,100%{opacity:0;transform:scale(.85);}
  50%{opacity:1;transform:scale(1.08);}
}
@media(prefers-reduced-motion:reduce){
  .vrApt__dirCard[data-vrapt-dir] .vrApt__dirIcon--big::before,
  .vrApt__dirCard .vrApt__dirIconImg{animation:none!important;}
}

/* Full-screen step body fills viewport */
.vrApt.vrApt--full .vrApt__body{flex:1;display:flex;flex-direction:column;padding-bottom:32px;}
.vrApt.vrApt--full .vrApt__step--full{flex:1;display:flex;flex-direction:column;}

/* ── Step 1 — Airport search + list ─────────────────────────── */
.vrApt__searchBox {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  background: var(--vrApt-surface);
  border: 1px solid var(--vrApt-border);
  border-radius: 14px;
  margin-bottom: 12px;
}
.vrApt__searchIcon {
  color: var(--vrApt-text-2);
  flex-shrink: 0;
}
.vrApt__searchInput {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--vrApt-text);
  font-size: 15px;
  font-family: inherit;
  min-width: 0;
}
.vrApt__searchInput::placeholder { color: var(--vrApt-text-3); }
.vrApt__searchClear {
  width: 24px;
  height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.08);
  border: none;
  border-radius: 50%;
  color: var(--vrApt-text-2);
  cursor: pointer;
  padding: 0;
  flex-shrink: 0;
}

.vrApt__airportList {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.vrApt__airportTile {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  background: var(--vrApt-surface);
  border: 1px solid var(--vrApt-border);
  border-radius: 16px;
  color: var(--vrApt-text);
  cursor: pointer;
  font-family: inherit;
  text-align: left;
  width: 100%;
  transition: background-color 160ms var(--vrApt-ease-out), border-color 160ms var(--vrApt-ease-out), transform 120ms var(--vrApt-ease-out);
}
.vrApt__airportTile:active { transform: scale(0.985); }
.vrApt__airportTile:hover { background: rgba(255,255,255,.04); }
.vrApt__airportCode {
  width: 48px;
  height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(66,133,244,.10);
  color: var(--vrApt-blue);
  border-radius: 14px;
  font-size: 14px;
  font-weight: 900;
  letter-spacing: 0.02em;
  flex-shrink: 0;
}
.vrApt__airportMeta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.vrApt__airportName {
  font-size: 14px;
  font-weight: 700;
  color: var(--vrApt-text);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.vrApt__airportCount {
  font-size: 12px;
  color: var(--vrApt-text-2);
  line-height: 1.3;
}
.vrApt__airportSurcharge {
  padding: 4px 8px;
  background: rgba(232,197,71,.12);
  color: var(--vrApt-gold);
  border-radius: 8px;
  font-size: 11px;
  font-weight: 700;
  flex-shrink: 0;
}
.vrApt__airportChev {
  color: var(--vrApt-text-2);
  display: inline-flex;
  flex-shrink: 0;
}

.vrApt__empty {
  padding: 40px 20px;
  text-align: center;
  color: var(--vrApt-text-2);
}
.vrApt__empty p { margin: 12px 0 0; font-size: 14px; }
.vrApt__empty svg { opacity: 0.4; }

/* ── Airport badge (step 2 header) ──────────────────────────── */
.vrApt__airportBadge {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  margin-bottom: 14px;
  background: rgba(66,133,244,.06);
  border: 1px solid rgba(66,133,244,.15);
  border-radius: 14px;
}
.vrApt__airportBadge__icon {
  color: var(--vrApt-blue);
  flex-shrink: 0;
}
.vrApt__airportBadge__code {
  font-size: 14px;
  font-weight: 900;
  color: var(--vrApt-blue);
  flex-shrink: 0;
}
.vrApt__airportBadge__name {
  font-size: 13px;
  color: var(--vrApt-text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vrApt__sectionHeader {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--vrApt-text-2);
  margin: 0 0 10px 2px;
}

/* ── Step 2a — Airline list ─────────────────────────────────── */
.vrApt__airlineList {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.vrApt__airlineTile {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  background: var(--vrApt-surface);
  border: 1px solid var(--vrApt-border);
  border-radius: 14px;
  color: var(--vrApt-text);
  cursor: pointer;
  font-family: inherit;
  text-align: left;
  width: 100%;
  transition: background-color 180ms linear, border-color 180ms linear, border-width 180ms linear;
}
.vrApt__airlineTile.is-selected {
  background: rgba(66,133,244,.12);
  border-color: var(--vrApt-blue);
  border-width: 1.5px;
  padding: 13.5px 15.5px; /* compensate for border growth */
}
.vrApt__airlineTileIcon {
  width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.08);
  color: var(--vrApt-text-2);
  border-radius: 10px;
  flex-shrink: 0;
}
.vrApt__airlineTile.is-selected .vrApt__airlineTileIcon {
  background: rgba(66,133,244,.12);
  color: var(--vrApt-blue);
}
.vrApt__airlineTileText {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.vrApt__airlineTileName {
  font-size: 14px;
  font-weight: 600;
  color: var(--vrApt-text);
  line-height: 1.3;
}
.vrApt__airlineTile.is-selected .vrApt__airlineTileName {
  color: var(--vrApt-blue);
  font-weight: 700;
}
.vrApt__airlineTileTerm {
  font-size: 11px;
  color: var(--vrApt-text-2);
  line-height: 1.3;
}
.vrApt__airlineTileBadge {
  padding: 3px 8px;
  background: rgba(66,133,244,.12);
  color: var(--vrApt-blue);
  border-radius: 8px;
  font-size: 10px;
  font-weight: 600;
  flex-shrink: 0;
}
.vrApt__airlineTileCheck {
  color: var(--vrApt-blue);
  display: inline-flex;
  flex-shrink: 0;
}
.vrApt__airlineTileChev {
  color: var(--vrApt-text-2);
  display: inline-flex;
  flex-shrink: 0;
}

/* Fallback card for unknown airport */
.vrApt__fallbackCard {
  padding: 16px;
  background: rgba(232,197,71,.07);
  border: 1px solid rgba(232,197,71,.20);
  border-radius: 14px;
  text-align: center;
  color: var(--vrApt-text);
}
.vrApt__fallbackCard svg { color: var(--vrApt-gold); margin-bottom: 10px; }
.vrApt__fallbackCard p {
  margin: 0 0 16px;
  font-size: 13px;
  color: var(--vrApt-text-2);
  line-height: 1.5;
}
.vrApt__continueBtn {
  padding: 12px 24px;
  background: var(--vrApt-blue);
  color: #fff;
  border: none;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
}

/* ── Step 2b — Terminal chips + door tiles ──────────────────── */
.vrApt__terminalWrap {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}
.vrApt__terminalChip {
  padding: 10px 14px;
  background: var(--vrApt-surface);
  border: 1px solid var(--vrApt-border);
  border-radius: 12px;
  color: var(--vrApt-text);
  font-size: 13px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  transition: background-color 180ms linear, border-color 180ms linear, border-width 180ms linear, color 180ms linear;
}
.vrApt__terminalChip.is-selected {
  background: rgba(232,197,71,.12);
  border-color: var(--vrApt-green);
  border-width: 1.5px;
  color: var(--vrApt-green);
  font-weight: 700;
  padding: 9.5px 13.5px;
}

.vrApt__doorSection[hidden] { display: none; }
.vrApt__doorSection { animation: vrApt-fadeIn 200ms var(--vrApt-ease-out); }

.vrApt__doorList {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.vrApt__doorTile {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  background: var(--vrApt-surface);
  border: 1px solid var(--vrApt-border);
  border-radius: 14px;
  color: var(--vrApt-text);
  cursor: pointer;
  font-family: inherit;
  text-align: left;
  width: 100%;
  transition: background-color 180ms linear, border-color 180ms linear, border-width 180ms linear;
}
.vrApt__doorTile.is-selected {
  background: rgba(232,197,71,.08);
  border-color: rgba(232,197,71,.45);
  border-width: 1.5px;
  padding: 13.5px;
}
.vrApt__doorIcon {
  color: var(--vrApt-text-2);
  flex-shrink: 0;
}
.vrApt__doorTile.is-selected .vrApt__doorIcon { color: var(--vrApt-gold); }
.vrApt__doorName {
  flex: 1;
  font-size: 14px;
  font-weight: 500;
  color: var(--vrApt-text);
}
.vrApt__doorTile.is-selected .vrApt__doorName { color: var(--vrApt-gold); font-weight: 700; }
.vrApt__doorCheck { color: var(--vrApt-gold); display: inline-flex; flex-shrink: 0; }

/* ── Step 3 — Confirm ───────────────────────────────────────── */
.vrApt__summary {
  padding: 16px;
  border-radius: 16px;
  margin-bottom: 12px;
}
.vrApt__summary.is-to {
  background: rgba(66,133,244,.06);
  border: 1px solid rgba(66,133,244,.18);
}
.vrApt__summary.is-from {
  background: rgba(232,197,71,.06);
  border: 1px solid rgba(232,197,71,.18);
}
.vrApt__summaryRow {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 4px 0;
  font-size: 13px;
}
.vrApt__summaryRow svg {
  color: var(--vrApt-text-2);
  flex-shrink: 0;
  margin-top: 1px;
}
.vrApt__summaryRow--gold svg { color: var(--vrApt-gold); }
.vrApt__summaryRowLabel { color: var(--vrApt-text-2); margin-right: 4px; }
.vrApt__summaryRowValue { color: var(--vrApt-text); font-weight: 600; flex: 1; word-break: break-word; }
.vrApt__summaryRow--gold .vrApt__summaryRowValue { color: var(--vrApt-gold); }

.vrApt__note {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  margin-bottom: 16px;
  border-radius: 12px;
  font-size: 12px;
  color: var(--vrApt-text-2);
  line-height: 1.4;
}
.vrApt__note.is-to   { background: rgba(66,133,244,.06); }
.vrApt__note.is-from { background: rgba(232,197,71,.06); }
.vrApt__note svg { flex-shrink: 0; }
.vrApt__note.is-to svg   { color: var(--vrApt-blue); }
.vrApt__note.is-from svg { color: var(--vrApt-green); }

.vrApt__flightBlock { margin-bottom: 20px; }
.vrApt__flightLabel {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--vrApt-text-2);
  margin-bottom: 8px;
}
.vrApt__flightLabel.is-error { color: var(--vrApt-red); }
.vrApt__flightInput {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  background: var(--vrApt-surface);
  border: 1px solid var(--vrApt-border);
  border-radius: 14px;
}
.vrApt__flightInput.is-error { border-color: rgba(239,68,68,.6); }
.vrApt__flightInput svg {
  color: var(--vrApt-blue);
  flex-shrink: 0;
}
.vrApt__flightField {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--vrApt-text);
  font-size: 15px;
  font-family: inherit;
  min-width: 0;
}
.vrApt__flightField::placeholder { color: var(--vrApt-text-3); }
.vrApt__flightError {
  margin-top: 6px;
  font-size: 12px;
  color: var(--vrApt-red);
}
.vrApt__flightHint {
  margin: 8px 0 0;
  font-size: 12px;
  color: var(--vrApt-text-2);
  line-height: 1.4;
}

.vrApt__confirmBtn {
  width: 100%;
  height: 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: none;
  border-radius: 16px;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: -0.005em;
  font-family: inherit;
  cursor: pointer;
  transition: transform 120ms var(--vrApt-ease-out);
}
.vrApt__confirmBtn:active { transform: scale(0.985); }
.vrApt__confirmBtn.is-to {
  background: linear-gradient(to right, var(--vrApt-gold), var(--vrApt-gold-light));
  color: rgba(0,0,0,.87);
  box-shadow: 0 4px 12px rgba(232,197,71,.35);
}
.vrApt__confirmBtn.is-from {
  background: linear-gradient(to right, var(--vrApt-green), var(--vrApt-green-light));
  color: #fff;
  box-shadow: 0 4px 12px rgba(232,197,71,.35);
}

/* ── Reduced motion ─────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .vrApt *,
  .vrApt *::before,
  .vrApt *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* ── Small screens ──────────────────────────────────────────── */
@media (max-width: 480px) {
  .vrApt__title { font-size: 18px; }
  .vrApt__dirCard { padding: 18px; }
  .vrApt__dirTitle { font-size: 15px; }
  .vrApt__dirIcon { width: 48px; height: 48px; }
  .vrApt__sheet { max-height: 92vh; }
}

/* ═══ Location picker — extras (connector line, pickup gold mask, map-icon glow) ═══ */
/* Connector lives as pseudo-element on the pickup dot so it's always glued to the
   dot's bottom edge. Its height spans the gap + reaches the dropoff dot below. */
.vipRide__locPicker__connector{display:none!important;}
.vipRide__locPicker__dot--pickup::after{
  content:'';
  position:absolute;
  left:50%;
  /* Small gap between the circle and the start of the line */
  top:calc(100% + 4px);
  transform:translateX(-50%);
  width:2px;
  height:28px;
  background:linear-gradient(180deg,#E8C547,#ffffff);
  border-radius:2px;
  pointer-events:none;
  box-shadow:0 0 6px rgba(232,197,71,.45);
  z-index:1;
}
.vipRide__locPicker__field--pickup{position:relative;}
.vipRide__locPicker__mask{position:absolute;left:34px;top:50%;transform:translateY(-50%);color:#E8C547;font-size:15px;font-weight:600;pointer-events:none;text-shadow:0 0 10px rgba(232,197,71,.25);display:none;}
.vipRide__locPicker__field--pickup.is-masked .vipRide__locPicker__mask{display:block;}
.vipRide__locPicker__field--pickup.is-masked .vipRide__locPicker__input--pickup{color:transparent!important;caret-color:transparent;}
.vipRide__locPicker__shortcutIcon--map{background:#fff!important;border-color:rgba(255,255,255,.35)!important;color:#E8C547!important;box-shadow:0 6px 18px rgba(0,0,0,.45),0 2px 6px rgba(232,197,71,.25),inset 0 1px 0 rgba(255,255,255,.9)!important;}
.vipRide__locPicker__shortcutIcon--map svg{filter:drop-shadow(0 1px 2px rgba(232,197,71,.55)) drop-shadow(0 0 4px rgba(232,197,71,.35));}

/* Later overlay: blurry glass background + fade-in */
.vipRide__laterOverlay{background:rgba(10,17,40,.7)!important;backdrop-filter:blur(28px) saturate(160%)!important;-webkit-backdrop-filter:blur(28px) saturate(160%)!important;transition:opacity 380ms cubic-bezier(.33,1,.68,1)}
.vipRide__laterOverlay.is-entering{opacity:0}

/* Morph animation — card expands into overlay */
.vrMorph{position:fixed;z-index:9991;background:rgba(10,17,40,.7);backdrop-filter:blur(28px) saturate(160%);-webkit-backdrop-filter:blur(28px) saturate(160%);box-shadow:0 6px 24px rgba(0,0,0,.5);pointer-events:none;transition:all 620ms cubic-bezier(.33,1,.68,1);will-change:top,left,width,height,border-radius,opacity}
/* Gold pulse on dropoff marker when placed */
.vipRide__marker--pulse{position:relative}
.vipRide__marker--pulse::before{content:'';position:absolute;left:50%;top:100%;transform:translate(-50%,-50%);width:36px;height:36px;border-radius:50%;background:radial-gradient(circle,rgba(232,197,71,.6) 0%,rgba(232,197,71,0) 70%);animation:vrPinPulse 1.6s cubic-bezier(.33,1,.68,1) 2;pointer-events:none}
@keyframes vrPinPulse{0%{transform:translate(-50%,-50%) scale(.6);opacity:.9}100%{transform:translate(-50%,-50%) scale(2.4);opacity:0}}
/* Later card icons: glass frame + gold arrow badge (matches Airport sheet) */
.vipRide__laterCard__icon{position:relative!important;background:rgba(255,255,255,.04)!important;border:1px solid rgba(232,197,71,.18)!important;backdrop-filter:blur(20px) saturate(140%)!important;-webkit-backdrop-filter:blur(20px) saturate(140%)!important;padding:10px!important;box-shadow:0 6px 20px rgba(0,0,0,.45),0 0 0 4px rgba(232,197,71,.06),inset 0 1px 0 rgba(255,255,255,.05)!important;transition:border-color 180ms,box-shadow 180ms!important}
