{%- comment -%} v-perf-cleanup-{{ 'now' | date: '%s%N' }} {%- endcomment -%}
{%- assign _cl = request.locale.iso_code | default: shop.locale | slice: 0,2 | downcase -%}
{%- if _cl != 'es' -%}{%- assign _cl = 'en' -%}{%- endif -%}

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="vrLTg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#fff4c6"/><stop offset="50%" stop-color="#E8C547"/><stop offset="100%" stop-color="#d4af37"/></linearGradient><symbol id="vRIcoMap" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M12 2a7 7 0 017 7c0 5-7 13-7 13S5 14 5 9a7 7 0 017-7z"/><circle cx="12" cy="9" r="2.5" fill="currentColor"/></symbol><symbol id="vRIcoChat" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M21 12a8 8 0 01-11.3 7.3L4 21l1.7-5.7A8 8 0 1121 12z"/><circle cx="9" cy="12" r="1" fill="currentColor"/><circle cx="12" cy="12" r="1" fill="currentColor"/><circle cx="15" cy="12" r="1" fill="currentColor"/></symbol><symbol id="vRIcoStar" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l2.95 6.37L22 9.42l-5 4.94L18.18 22 12 18.5 5.82 22 7 14.36 2 9.42l7.05-1.05z"/></symbol><symbol id="vRIcoGift" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></symbol></defs></svg>

<!-- ═══ GUEST INFO MODAL — shown before payment if not logged in ═══ -->
<div class="vrGi" data-vr-guest hidden>
  <div class="vrGi__scrim" data-vr-guest-scrim></div>
  <div class="vrGi__sheet" data-vr-guest-sheet role="dialog" aria-modal="true" aria-labelledby="vrGiTitle">
    <div class="vrGi__handle" aria-hidden="true"></div>
    <div class="vrGi__header">
      <h3 class="vrGi__title" id="vrGiTitle">{% if _cl == 'es' %}Tus datos{% else %}Your info{% endif %}</h3>
      <button type="button" class="vrGi__close" data-vr-guest-close aria-label="{% if _cl == 'es' %}Cerrar{% else %}Close{% endif %}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <p class="vrGi__sub">{% if _cl == 'es' %}El chofer necesita esto para contactarte durante el viaje.{% else %}The driver needs this to contact you during the ride.{% endif %}</p>
    <div class="vrGi__body">
      <div class="vrGi__row">
        <label class="vrGi__field">
          <input type="text" class="vrGi__in" data-vr-guest-first autocomplete="given-name" placeholder=" " maxlength="40">
          <span class="vrGi__lbl">{% if _cl == 'es' %}Nombre{% else %}First name{% endif %}</span>
        </label>
        <label class="vrGi__field">
          <input type="text" class="vrGi__in" data-vr-guest-last autocomplete="family-name" placeholder=" " maxlength="40">
          <span class="vrGi__lbl">{% if _cl == 'es' %}Apellido{% else %}Last name{% endif %}</span>
        </label>
      </div>
      <label class="vrGi__field">
        <input type="email" class="vrGi__in" data-vr-guest-email autocomplete="email" placeholder=" " inputmode="email" maxlength="80" required>
        <span class="vrGi__lbl">Email</span>
      </label>
      <label class="vrGi__field">
        <input type="tel" class="vrGi__in" data-vr-guest-phone autocomplete="tel" placeholder=" " inputmode="tel" maxlength="20">
        <span class="vrGi__lbl">{% if _cl == 'es' %}Teléfono (opcional){% else %}Phone (optional){% endif %}</span>
      </label>
      <p class="vrGi__hint2">{% if _cl == 'es' %}Te enviaremos la confirmacion y actualizaciones de tu viaje por correo.{% else %}We&rsquo;ll email you booking confirmation and ride updates.{% endif %}</p>
      <div class="vrGi__err" data-vr-guest-err hidden></div>
    </div>
    <button type="button" class="vrGi__submit" data-vr-guest-submit>{% if _cl == 'es' %}Continuar{% else %}Continue{% endif %}</button>
  </div>
</div>

<!-- ═══ LIVE TRIP TRACKER v2 — premium w/ blur, animated ETA, chat ═══ -->
<div class="vrLT" data-vr-livetracker hidden>
  <div class="vrLT__bgBlur"></div>
  <div class="vrLT__card">
    <div class="vrLT__liveBadge"><span class="vrLT__liveDot"></span><span data-vrlt-live-lbl>{% if _cl == 'es' %}EN VIVO{% else %}LIVE{% endif %}</span></div>
    <div class="vrLT__hero">
      <div class="vrLT__heroGlow"></div>
      <div class="vrLT__statusPill" data-vrlt-status-pill><span class="vrLT__pulse"></span><span class="vrLT__statusTxt" data-vrlt-status-txt>{% if _cl == 'es' %}Conductor en camino{% else %}Driver on the way{% endif %}</span></div>
      <div class="vrLT__etaWrap">
        <svg class="vrLT__ring" viewBox="0 0 120 120" aria-hidden="true"><circle class="vrLT__ringBg" cx="60" cy="60" r="52"/><circle class="vrLT__ringFg" data-vrlt-ring cx="60" cy="60" r="52"/></svg>
        <div class="vrLT__carOrbit" data-vrlt-car><svg viewBox="0 0 24 24" width="20" height="20" fill="#0a0a0a" aria-hidden="true"><path d="M5 11l1.5-4.5A2 2 0 018.4 5h7.2a2 2 0 011.9 1.5L19 11h1.5a.5.5 0 01.5.5V14a1 1 0 01-1 1h-1v2a1 1 0 01-1 1h-1a1 1 0 01-1-1v-2H8v2a1 1 0 01-1 1H6a1 1 0 01-1-1v-2H4a1 1 0 01-1-1v-2.5a.5.5 0 01.5-.5H5zm2-1h10l-.9-2.7a.5.5 0 00-.5-.3H8.4a.5.5 0 00-.5.3L7 10zm0 3.5a1 1 0 100-2 1 1 0 000 2zm10 0a1 1 0 100-2 1 1 0 000 2z"/></svg></div>
        <div class="vrLT__etaCenter"><span class="vrLT__etaCurr" data-vrlt-eta-min>5</span><div class="vrLT__etaUnit" data-vrlt-eta-lbl>{% if _cl == 'es' %}min llegando{% else %}min away{% endif %}</div></div>
      </div>
      <div class="vrLT__ringHint">{% if _cl == 'es' %}Progreso hasta tu recogida{% else %}Progress to pickup{% endif %}</div>
      <div class="vrLT__dist"><span data-vrlt-dist>— mi</span><span class="vrLT__distSep">·</span><span data-vrlt-updated>{% if _cl == 'es' %}actualizado ahora{% else %}updated now{% endif %}</span></div>
    </div>

    <div class="vrLT__timeline">
      <div class="vrLT__tlTrack"><div class="vrLT__tlDash"></div><div class="vrLT__tlFill" data-vrlt-tlfill></div><div class="vrLT__tlFlow" data-vrlt-tlflow></div></div>
      <div class="vrLT__steps">
        <div class="vrLT__step is-active" data-vrlt-step="enroute"><span class="vrLT__dot"><svg class="vrLT__check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L20 7" fill="none" stroke="#0a0a0a" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="vrLT__stepLbl">{% if _cl == 'es' %}En camino{% else %}En route{% endif %}</span></div>
        <div class="vrLT__step" data-vrlt-step="arrived"><span class="vrLT__dot"><svg class="vrLT__check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L20 7" fill="none" stroke="#0a0a0a" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="vrLT__stepLbl">{% if _cl == 'es' %}Llegó{% else %}Arrived{% endif %}</span></div>
        <div class="vrLT__step" data-vrlt-step="intrip"><span class="vrLT__dot"><svg class="vrLT__check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L20 7" fill="none" stroke="#0a0a0a" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="vrLT__stepLbl">{% if _cl == 'es' %}En viaje{% else %}In trip{% endif %}</span></div>
        <div class="vrLT__step" data-vrlt-step="finished"><span class="vrLT__dot"><svg class="vrLT__check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L20 7" fill="none" stroke="#0a0a0a" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="vrLT__stepLbl">{% if _cl == 'es' %}Terminado{% else %}Finished{% endif %}</span></div>
      </div>
    </div>

    <div class="vrLT__driver">
      <div class="vrLT__avatarRing"><div class="vrLT__avatar" data-vrlt-driver-photo></div></div>
      <div class="vrLT__driverInfo">
        <div class="vrLT__driverName" data-vrlt-driver-name>—</div>
        <div class="vrLT__driverMeta">
          <span class="vrLT__rating" data-vrlt-driver-rating-wrap hidden><svg width="12" height="12" viewBox="0 0 24 24" fill="#E8C547"><path d="M12 2l2.95 6.37L22 9.42l-5 4.94L18.18 22 12 18.5 5.82 22 7 14.36 2 9.42l7.05-1.05z"/></svg><span data-vrlt-driver-rating>—</span></span>
          <span class="vrLT__vehicle" data-vrlt-vehicle>—</span>
        </div>
      </div>
      <div class="vrLT__plate" data-vrlt-plate hidden>—</div>
    </div>

    <div class="vrLT__actions">
      <button type="button" class="vrLT__aBtn vrLT__aBtn--primary" data-vrlt-act-call><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg><span>{% if _cl == 'es' %}Llamar al conductor{% else %}Call driver{% endif %}</span></button>
      <button type="button" class="vrLT__aBtn vrLT__aBtn--chat" data-vrlt-act-msg><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg><span data-vrlt-msg-lbl>{% if _cl == 'es' %}Chat{% else %}Chat{% endif %}</span><span class="vrLT__unread" data-vrlt-unread hidden>0</span></button>
    </div>

    <button type="button" class="vrLT__continue" data-vrlt-continue>{% if _cl == 'es' %}Descarga la app para tracking en vivo{% else %}Download app for live tracking{% endif %} →</button>
  </div>

  <!-- Chat fullscreen panel -->
  <div class="vrLT__chat" data-vrlt-chat hidden>
    <div class="vrLT__chatHead">
      <button type="button" class="vrLT__chatBack" data-vrlt-chat-back aria-label="Back"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
      <div class="vrLT__chatHeadInfo"><div class="vrLT__chatName" data-vrlt-chat-name>—</div><div class="vrLT__chatSub" data-vrlt-chat-sub><span class="vrLT__chatOnlineDot"></span>{% if _cl == 'es' %}En línea{% else %}Online{% endif %}</div></div>
      <div class="vrLT__chatAvatar" data-vrlt-chat-avatar></div>
    </div>
    <div class="vrLT__chatBody" data-vrlt-chat-body></div>
    <form class="vrLT__chatForm" data-vrlt-chat-form autocomplete="off">
      <input type="text" class="vrLT__chatInput" data-vrlt-chat-input placeholder="{% if _cl == 'es' %}Escribe un mensaje…{% else %}Type a message…{% endif %}" maxlength="500">
      <button type="submit" class="vrLT__chatSend" aria-label="Send"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg></button>
    </form>
  </div>
</div>

<style>
/* ═══ Guest info modal — floating ═══ */
.vrGi{position:fixed;inset:0;z-index:99998;display:flex;align-items:flex-end;justify-content:center;pointer-events:none;padding:14px 14px calc(env(safe-area-inset-bottom,0) + 14px);font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;}
.vrGi[hidden]{display:none!important;}
.vrGi__scrim{position:absolute;inset:0;background:rgba(0,0,0,.55);opacity:0;transition:opacity 320ms cubic-bezier(.33,1,.68,1);pointer-events:auto;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);}
.vrGi.is-open .vrGi__scrim{opacity:1;}
.vrGi__sheet{position:relative;width:100%;max-width:500px;background:#111318;border-radius:22px;transform:translateY(24px) scale(.985);opacity:0;transition:transform 360ms cubic-bezier(.33,1,.68,1),opacity 260ms cubic-bezier(.33,1,.68,1);pointer-events:auto;padding:18px 22px 22px;box-shadow:0 20px 60px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.05);color:#fff;}
.vrGi.is-open .vrGi__sheet{transform:translateY(0) scale(1);opacity:1;}
.vrGi__handle{display:none;}
.vrGi__header{display:flex;align-items:center;gap:12px;margin-bottom:4px;}
.vrGi__title{flex:1;font-size:20px;font-weight:800;margin:0;letter-spacing:-.01em;}
.vrGi__close{width:34px;height:34px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);border:none;border-radius:50%;color:rgba(255,255,255,.7);cursor:pointer;padding:0;transition:background 160ms;}
.vrGi__close:hover{background:rgba(255,255,255,.1);}
.vrGi__sub{margin:0 0 16px;font-size:13px;color:rgba(255,255,255,.55);line-height:1.4;}
.vrGi__hint2{margin:-4px 0 4px 4px;font-size:11px;color:rgba(232,197,71,.75);font-weight:500;font-style:italic;}
.vrGi__body{display:flex;flex-direction:column;gap:10px;margin-bottom:18px;}
.vrGi__row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}

/* Floating label field — Stripe style */
.vrGi__field{position:relative;display:block;}
.vrGi__in{width:100%;background:#1A1D24!important;background-color:#1A1D24!important;-webkit-appearance:none!important;appearance:none!important;-webkit-text-fill-color:#fff;border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:22px 14px 8px;color:#fff!important;font-size:15px;font-weight:500;font-family:inherit;outline:none;transition:border-color 180ms,background 180ms;box-shadow:none!important;caret-color:#E8C547;}
.vrGi__in::placeholder{color:transparent;}
.vrGi__in:-webkit-autofill,.vrGi__in:-webkit-autofill:hover,.vrGi__in:-webkit-autofill:focus{-webkit-text-fill-color:#fff;-webkit-box-shadow:0 0 0 1000px #1A1D24 inset!important;box-shadow:0 0 0 1000px #1A1D24 inset!important;caret-color:#E8C547;transition:background-color 5000s ease-in-out 0s;}
.vrGi__in:focus{border-color:#E8C547;background:#1E2128!important;background-color:#1E2128!important;}
.vrGi__lbl{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:rgba(255,255,255,.45);font-size:15px;font-weight:500;letter-spacing:0;text-transform:none;pointer-events:none;transition:top 180ms cubic-bezier(.33,1,.68,1),font-size 180ms cubic-bezier(.33,1,.68,1),color 180ms,transform 180ms cubic-bezier(.33,1,.68,1);transform-origin:left center;}
/* Floating state: when input is focused OR has content */
.vrGi__in:focus+.vrGi__lbl,
.vrGi__in:not(:placeholder-shown)+.vrGi__lbl{
  top:10px;transform:translateY(0);font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:rgba(232,197,71,.85);
}
.vrGi__in:not(:focus):not(:placeholder-shown)+.vrGi__lbl{color:rgba(255,255,255,.5);}
.vrGi__field.is-error .vrGi__in{border-color:rgba(239,68,68,.7);}
.vrGi__field.is-error .vrGi__lbl{color:#EF4444!important;}
.vrGi__err{font-size:12px;color:#EF4444;line-height:1.4;}
.vrGi__err[hidden]{display:none;}
.vrGi__submit{width:100%;height:52px;border:none;border-radius:14px;background:linear-gradient(to right,#E8C547,#FBE47A);color:#0a0e1a;font-size:15px;font-weight:800;letter-spacing:-.005em;font-family:inherit;cursor:pointer;box-shadow:0 4px 14px rgba(232,197,71,.3);transition:transform 140ms,opacity 140ms;}
.vrGi__submit:active{transform:scale(.985);}
.vrGi__submit:disabled{opacity:.4;cursor:not-allowed;}
@media (max-width:480px){.vrGi__row{grid-template-columns:1fr 1fr;}.vrGi__title{font-size:18px;}}
@media (prefers-reduced-motion:reduce){.vrGi *,.vrGi *::before,.vrGi *::after{transition-duration:.01ms!important;}}
.vR-app__offer{display:inline-flex;align-items:center;gap:8px;padding:7px 14px 7px 8px;border-radius:999px;background:linear-gradient(135deg,rgba(232,197,71,.16),rgba(232,197,71,.06));border:1px solid rgba(232,197,71,.42);margin:0 0 6px;animation:vRfu 1s cubic-bezier(.22,1,.36,1) .4s both;box-shadow:0 4px 18px rgba(232,197,71,.14)}
.vR-app__offer__tag{font:800 9.5px/1 Inter,sans-serif;letter-spacing:.14em;padding:4px 8px;border-radius:999px;background:#E8C547;color:#0a0a0a}
.vR-app__offer__txt{font:500 12.5px/1.25 Inter,sans-serif;color:#f4e7b4}
.vR-app__feats{list-style:none;margin:6px 0 2px;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:7px 10px;width:100%;max-width:320px;animation:vRfu 1s cubic-bezier(.22,1,.36,1) .85s both}
.vR-app__feat{display:flex;align-items:center;gap:8px;font:500 12px/1.25 Inter,sans-serif;color:rgba(255,255,255,.78);padding:8px 10px;border-radius:11px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08)}
.vR-app__feat i{width:28px;height:28px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:8px;background:linear-gradient(135deg,rgba(232,197,71,.22),rgba(232,197,71,.08));border:1px solid rgba(232,197,71,.32);color:#E8C547}
.vR-app__feat i svg{width:16px;height:16px;display:block}
/* Coming-soon ribbon for app-store buttons */
.vR-app__store--cs{position:relative;overflow:hidden;cursor:default;opacity:.88;pointer-events:none}
.vR-app__store--cs .vR-app__ribbon{position:absolute;top:10px;right:-32px;transform:rotate(35deg);background:linear-gradient(135deg,#E8C547,#d4af37);color:#0a0a0a;font:800 8.5px/1 'Inter',sans-serif;letter-spacing:.1em;text-transform:uppercase;padding:3px 34px;box-shadow:0 2px 6px rgba(0,0,0,.35);z-index:2;pointer-events:none;white-space:nowrap}
.vR-app__store--cs:hover{transform:none;background:rgba(255,255,255,.06)}
/* ═══ Live Trip Tracker v2 ═══ */
.vrLT{position:fixed;inset:0;z-index:2147483646;display:flex;align-items:center;justify-content:center;padding:16px;font-family:'Poppins',-apple-system,sans-serif;opacity:0;transition:opacity .45s cubic-bezier(.33,1,.68,1);overflow-y:auto}
.vrLT[hidden]{display:none!important}
.vrLT.is-open{opacity:1}
.vrLT__bgBlur{position:fixed;inset:0;background:#050505;z-index:-1}
.vrLT__card{position:relative;width:100%;max-width:440px;background:linear-gradient(180deg,rgba(20,20,24,.6),rgba(8,8,12,.8));border-radius:24px;border:1px solid rgba(255,255,255,.08);box-shadow:0 24px 64px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.08);transform:translateY(26px) scale(.96);transition:transform .55s cubic-bezier(.22,1,.36,1);overflow:hidden;color:#fff;margin:auto}
.vrLT.is-open .vrLT__card{transform:translateY(0) scale(1)}
.vrLT__liveBadge{position:absolute;top:16px;left:16px;display:inline-flex;align-items:center;gap:6px;padding:5px 10px 5px 8px;border-radius:999px;background:rgba(0,0,0,.45);border:1px solid rgba(110,229,137,.35);font:700 9.5px/1 'Inter',sans-serif;color:#6ee589;letter-spacing:.14em;z-index:2}
.vrLT__liveDot{width:6px;height:6px;border-radius:50%;background:#6ee589;box-shadow:0 0 8px rgba(110,229,137,.8);animation:vrLTliveDot 1.4s infinite}
@keyframes vrLTliveDot{0%,100%{opacity:1}50%{opacity:.4}}
.vrLT__hero{position:relative;padding:36px 24px 20px;text-align:center;overflow:hidden}
.vrLT__heroGlow{position:absolute;inset:-40% -20% 0;background:radial-gradient(ellipse at 50% 0%,rgba(232,197,71,.22),transparent 55%);pointer-events:none}
.vrLT__statusPill{position:relative;display:inline-flex;align-items:center;gap:8px;padding:7px 14px 7px 10px;border-radius:999px;background:rgba(232,197,71,.12);border:1px solid rgba(232,197,71,.45);font:700 10.5px/1 'Inter',sans-serif;color:#E8C547;letter-spacing:.12em;text-transform:uppercase;transition:all .4s}
.vrLT__statusPill.is-arrived{background:rgba(110,229,137,.14);border-color:rgba(110,229,137,.5);color:#6ee589}
.vrLT__statusPill.is-arrived .vrLT__pulse{background:#6ee589;box-shadow:0 0 0 0 rgba(110,229,137,.55)}
.vrLT__pulse{width:7px;height:7px;border-radius:50%;background:#E8C547;box-shadow:0 0 0 0 rgba(232,197,71,.55);animation:vrLTpulse 1.6s infinite}
@keyframes vrLTpulse{0%{box-shadow:0 0 0 0 rgba(232,197,71,.55)}70%{box-shadow:0 0 0 14px rgba(232,197,71,0)}100%{box-shadow:0 0 0 0 rgba(232,197,71,0)}}
.vrLT__etaWrap{position:relative;width:190px;height:190px;margin:16px auto 4px}
.vrLT__ring{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
.vrLT__ringBg{fill:none;stroke:rgba(255,255,255,.06);stroke-width:3}
.vrLT__ringFg{fill:none;stroke:url(#vrLTg);stroke-width:3;stroke-linecap:round;stroke-dasharray:326.73;stroke-dashoffset:326.73;transition:stroke-dashoffset 1.2s cubic-bezier(.33,1,.68,1);filter:drop-shadow(0 0 8px rgba(232,197,71,.5))}
.vrLT__carOrbit{display:none!important}
.vrLT__carOrbit svg{display:block}
.vrLT__etaCenter{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none}
