<!-- ═══════════════════════════════════════════════════════════════════
     VIP RIDE — AIRPORT SHEET (HTML)
     1:1 replica of Flutter airport_terminal_sheet.dart (4 steps)
     Lives inside #vipRide-{{ section.id }} — NOT appended to <body>.
     Hidden by default; shown via window.__vrAptOpen(callbacks).
     ═══════════════════════════════════════════════════════════════════ -->
<div class="vrApt" data-vrapt hidden>
  {% if section.settings.airport_bg_video != blank %}
  <div class="vrApt__bgVideo" aria-hidden="true">
    {{ section.settings.airport_bg_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'auto' }}
    <div class="vrApt__bgOverlay"></div>
  </div>
  {% endif %}
  <!-- Scrim (barrier dim) -->
  <div class="vrApt__scrim" data-vrapt-scrim></div>

  <!-- Sheet container -->
  <div class="vrApt__sheet" data-vrapt-sheet role="dialog" aria-modal="true" aria-labelledby="vrAptTitle">
    <!-- Drag handle -->
    <div class="vrApt__handle" aria-hidden="true"></div>

    <!-- Header -->
    <div class="vrApt__header">
      <button type="button" class="vrApt__backBtn" data-vrapt-back hidden aria-label="Back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </button>

      <span class="vrApt__headerIcon" data-vrapt-header-icon aria-hidden="true">
        <!-- Default: connecting airports -->
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M15 12l-3-9-3 9v4.5l3 1.5 3-1.5V12zm-6 8l-6 3v-2l6-3v2zm12 0l6 3v-2l-6-3v2z"/>
        </svg>
      </span>

      <h3 class="vrApt__title" id="vrAptTitle" data-vrapt-title>Choose your airport trip</h3>

      <span class="vrApt__codePill" data-vrapt-code-pill hidden></span>

      <button type="button" class="vrApt__closeBtn" data-vrapt-close aria-label="Back">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </button>
    </div>

    <!-- Progress bar (4 segments) -->
    <div class="vrApt__progress" data-vrapt-progress hidden>
      <div class="vrApt__progressSeg" data-seg="0"></div>
      <div class="vrApt__progressSeg" data-seg="1"></div>
      <div class="vrApt__progressSeg" data-seg="2"></div>
      <div class="vrApt__progressSeg" data-seg="3"></div>
    </div>

    <!-- Body (fades between steps) -->
    <div class="vrApt__body" data-vrapt-body>

      <!-- ── STEP 0 — Direction picker (full-screen, no frame) ─── -->
      <div class="vrApt__step vrApt__step--full" data-step="0">
        <div class="vrApt__dirList vrApt__dirList--v">
          <!-- TO AIRPORT -->
          <button type="button" class="vrApt__dirCard vrApt__dirCard--v" data-vrapt-dir="to">
            <span class="vrApt__dirIcon vrApt__dirIcon--big">
              {% if section.settings.apt_to_icon != blank %}
                {{ section.settings.apt_to_icon | image_url: width: 512 | image_tag: loading: 'eager', class: 'vrApt__dirIconImg', alt: 'To airport' }}
              {% else %}
                <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.5 19h19v2h-19zm19.57-9.36c-.21-.8-1.04-1.28-1.84-1.06L14.92 10l-6.9-6.43-1.93.51 4.14 7.17-4.97 1.33-1.97-1.54-1.45.39 1.82 3.16.77 1.33 1.6-.43 5.31-1.42 4.35-1.16 5.65-1.51c.82-.22 1.3-1.04 1.08-1.84z"/></svg>
              {% endif %}
            </span>
            <span class="vrApt__dirTitle">Take me TO the airport</span>
            <span class="vrApt__dirSub">I'm flying out</span>
          </button>

          <!-- FROM AIRPORT -->
          <button type="button" class="vrApt__dirCard vrApt__dirCard--v" data-vrapt-dir="from">
            <span class="vrApt__dirIcon vrApt__dirIcon--big">
              {% if section.settings.apt_from_icon != blank %}
                {{ section.settings.apt_from_icon | image_url: width: 512 | image_tag: loading: 'eager', class: 'vrApt__dirIconImg', alt: 'From airport' }}
              {% else %}
                <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.5 19h19v2h-19zm16.84-6.13c.8.22 1.63-.26 1.84-1.06.22-.8-.26-1.63-1.06-1.85l-5.31-1.42-2.76-9.02-1.93-.51v8.28L5.15 6.41l-.39 1.45 2.85 4.95 11.73 3.11z"/></svg>
              {% endif %}
