    };
    var back=document.querySelector('[data-vrlt-chat-back]');if(back)back.onclick=function(e){e.preventDefault();_closeChat();};
    var form=document.querySelector('[data-vrlt-chat-form]'),inp=document.querySelector('[data-vrlt-chat-input]'),sendBtn=form?form.querySelector('.vrLT__chatSend'):null;
    var doSend=function(e){
      if(e){e.preventDefault();e.stopPropagation();}
      if(!inp)return;
      var v=(inp.value||'').trim();
      if(!v)return;
      inp.value='';
      _sendMessage(v);
      try{inp.focus();}catch(_){}
    };
    if(form)form.addEventListener('submit',doSend);
    if(sendBtn)sendBtn.addEventListener('click',doSend);
    /* Enter-key fallback for browsers/keyboards that don't fire form submit */
    if(inp)inp.addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey){doSend(e);}});
  }
  function _applyStatusPayload(d){
    lastUpdatedAt=Date.now();
    var raw=(d.raw_status||d.status||'').toLowerCase();
    if(raw.indexOf('driver_en_route')>=0||raw==='accepted'||raw==='driver_assigned')_setStep('enroute');
    else if(raw.indexOf('arrived')>=0)_setStep('arrived');
    else if(raw==='in_trip'||raw==='on_trip'||raw==='in_progress')_setStep('intrip');
    else if(raw==='completed'||raw==='ended'){_setStep('completed');clearInterval(pollIv);try{localStorage.removeItem('vr_active_booking');}catch(_){}setTimeout(function(){if(onContinueCb){try{onContinueCb();}catch(_){}}setTimeout(_close,60);},2500);return;}
    else if(raw==='cancelled'||raw==='canceled'){clearInterval(pollIv);try{localStorage.removeItem('vr_active_booking');}catch(_){}_close();if(window.__vrNoDriverShow){var reason=(d.cancelled_by==='dispatch'||d.cancelled_by==='admin'||d.driver_name||d.driver_id)?'dispatch_cancelled':'no_driver';window.__vrNoDriverShow(null,reason);}return;}
    /* In arrived state the grace timer owns the display — don't pipe ETA through */
    if(currentStep!=='arrived' && d.eta_minutes!==undefined&&d.eta_minutes!==null)_setETAFull(d.eta_minutes);
    if(d.distance_miles!==undefined)_setDist(d.distance_miles);
    if(d.driver_name)driverName=d.driver_name;
    if(d.driver_phone)driverPhone=d.driver_phone;
    if(d.driver_photo_url&&d.driver_photo_url!==driverPhotoUrl){driverPhotoUrl=d.driver_photo_url;_setDriver(d);}
  }
  function _startPoll(){
    if(pollIv)clearInterval(pollIv);
    if(!bookingIdRef||!api||!key)return;
    var tick=function(){
      fetch(api+'/bookings/web/'+bookingIdRef+'/status',{headers:{'Authorization':'Bearer '+key}})
      .then(function(r){return r.json();}).then(function(d){if(d)_applyStatusPayload(d);}).catch(function(){});
    };
    tick();
    pollIv=setInterval(tick,4000);
    if(updatedIv)clearInterval(updatedIv);
    updatedIv=setInterval(_setUpdatedLabel,1000);
    /* Background chat poll for unread badge */
    if(chatPollIv)clearInterval(chatPollIv);
    chatPollIv=setInterval(function(){if(!chatOpen)_fetchChat(false);},3500);
  }
  function _close(){
    if(pollIv){clearInterval(pollIv);pollIv=null;}
    if(chatPollIv){clearInterval(chatPollIv);chatPollIv=null;}
    if(updatedIv){clearInterval(updatedIv);updatedIv=null;}
    if(!root)return;
    root.classList.remove('is-open');
    try{document.body.style.overflow='';}catch(_){}
    setTimeout(function(){root.setAttribute('hidden','')},420);
  }
  window.__vrLTShow=function(driverData,bookingId,apiBase,webKey,onContinue){
    root=document.querySelector('[data-vr-livetracker]');
    if(!root)return;
    /* Move to <body> to escape any parent stacking context (Shopify header, etc.) */
    if(root.parentNode!==document.body)document.body.appendChild(root);
    var chatEl=root.querySelector('[data-vrlt-chat]');
    if(chatEl&&chatEl.parentNode!==document.body)document.body.appendChild(chatEl);
    card=_q('.vrLT__card');chatPanel=document.querySelector('[data-vrlt-chat]');
    bookingIdRef=bookingId||null;api=apiBase||'';key=webKey||'';onContinueCb=onContinue||null;
    unreadCount=0;lastMsgId=0;lastSeenId=0;chatOpen=false;
    if(chatPanel)chatPanel.setAttribute('hidden','');
    _setDriver(driverData||{});
    var initial=(driverData&&driverData.eta_minutes)||5;
    _setETAFull(initial);
    _setDist((driverData&&driverData.distance_miles)||null);
    currentStep='';_setStep('enroute');
    _wireActions();
    /* DIRECT hard-wire for chat button — multiple event types, bypass any delegation issue */
    try{
      var msgBtnDirect=root.querySelector('[data-vrlt-act-msg]');
      if(msgBtnDirect){
        var _openChatDirect=function(ev){
          if(ev){ev.preventDefault();ev.stopPropagation();}
          try{_openChat();}catch(err){try{console.warn('[vrLT] openChat err',err);}catch(_){}}
        };
        msgBtnDirect.onclick=_openChatDirect;
        msgBtnDirect.ontouchend=_openChatDirect;
        msgBtnDirect.addEventListener('click',_openChatDirect,false);
        msgBtnDirect.addEventListener('touchend',_openChatDirect,{passive:false});
        msgBtnDirect.style.touchAction='manipulation';
        msgBtnDirect.style.cursor='pointer';
      }
    }catch(_){}
    try{document.body.style.overflow='hidden';}catch(_){}
    root.removeAttribute('hidden');
    requestAnimationFrame(function(){root.classList.add('is-open');});
    _startPoll();
  };
  window.__vrLTClose=_close;
})();
</script>
