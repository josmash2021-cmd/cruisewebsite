.vrLT__etaCurr.is-anim{animation:vrLTflip .55s cubic-bezier(.34,1.36,.64,1)}
@keyframes vrLTflip{0%{transform:translateY(50%) scale(.7);opacity:0}60%{transform:translateY(-6%) scale(1.05);opacity:1}100%{transform:translateY(0) scale(1);opacity:1}}
.vrLT__etaUnit{font:700 10.5px/1 'Inter',sans-serif;color:#d4af37;letter-spacing:.2em;text-transform:uppercase;margin-top:8px;text-align:center}
.vrLT__ringHint{text-align:center;font:500 10.5px/1 'Inter',sans-serif;color:rgba(255,255,255,.4);letter-spacing:.1em;text-transform:uppercase;margin:4px 0 2px}
.vrLT__dist{font:500 12px/1 'Inter',sans-serif;color:rgba(255,255,255,.55);letter-spacing:.04em;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:6px}
.vrLT__distSep{opacity:.4}
.vrLT__timeline{position:relative;padding:18px 22px 20px}
.vrLT__steps{position:relative;display:flex;justify-content:space-between;align-items:flex-start}
.vrLT__tlTrack{position:absolute;top:24px;left:36px;right:36px;height:3px;z-index:0;transform:translateY(-50%);background:rgba(255,255,255,.1);border-radius:2px;overflow:hidden}
.vrLT__tlDash{display:none}
.vrLT__tlFill{position:absolute;top:0;left:0;bottom:0;width:0%;background:linear-gradient(90deg,#d4af37,#E8C547 50%,#fff4c6);border-radius:2px;transition:width 450ms cubic-bezier(.22,1,.36,1);box-shadow:0 0 10px rgba(232,197,71,.5);will-change:width}
.vrLT__tlFill::after{content:"";position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);background-size:40% 100%;background-repeat:no-repeat;animation:vrLTshimmer 2.4s ease-in-out infinite}
@keyframes vrLTshimmer{0%{background-position:-60% 0}100%{background-position:160% 0}}
.vrLT__tlFlow{display:none}
.vrLT__step{display:flex;flex-direction:column;align-items:center;gap:10px;flex:0 0 auto;position:relative;z-index:1}
.vrLT__dot{width:20px;height:20px;border-radius:50%;background:#13161e;border:2px solid rgba(255,255,255,.2);transition:all .4s cubic-bezier(.34,1.56,.64,1);box-sizing:border-box;display:flex;align-items:center;justify-content:center;position:relative}
.vrLT__check{width:12px;height:12px;opacity:0;transform:scale(.3);transition:opacity .3s ease,transform .45s cubic-bezier(.34,1.56,.64,1)}
.vrLT__step.is-done .vrLT__dot{background:#E8C547;border-color:#E8C547;box-shadow:0 0 10px rgba(232,197,71,.55)}
.vrLT__step.is-done .vrLT__check{opacity:1;transform:scale(1)}
.vrLT__step.just-done .vrLT__dot{animation:vrLTbounce .6s cubic-bezier(.34,1.56,.64,1)}
.vrLT__step.just-done .vrLT__stepLbl{animation:vrLTlblBounce .6s cubic-bezier(.34,1.56,.64,1)}
@keyframes vrLTbounce{0%{transform:scale(.7)}50%{transform:scale(1.35)}100%{transform:scale(1)}}
