    plane:         '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>',
    door:          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 4h3a2 2 0 0 1 2 2v14"/><path d="M2 20h3"/><path d="M13 20h9"/><path d="M10 12v.01"/><path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z"/></svg>',
    pin:           '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s-8-7.58-8-13a8 8 0 0 1 16 0c0 5.42-8 13-8 13z"/><circle cx="12" cy="9" r="3"/></svg>',
    money:         '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
    hail:          '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.5 6c.83 0 1.5-.67 1.5-1.5S19.33 3 18.5 3 17 3.67 17 4.5 17.67 6 18.5 6zM14 8l-4.5 4.5 1.41 1.41L14 10.83l3.09 3.08L14 17v5h2v-3.66L18.41 16 22 19.59 23.41 18.17 20 15l-3-3 3-3 1.41 1.41 2.41-2.41-4.41-4.41-2.41 2.41 1.41 1.41L14 8zM7.5 17.5c0-1.38-1.12-2.5-2.5-2.5s-2.5 1.12-2.5 2.5S3.62 20 5 20s2.5-1.12 2.5-2.5z"/></svg>',
    place:         '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>',
    check:         '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>',
    checkCircle:   '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>',
    chevron:       '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>',
    airline:       '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>',
    ticket:        '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>'
  };

  /* ── Helpers ─────────────────────────────────────────────── */
  function $(sel){ return root.querySelector(sel); }
  function $$(sel){ return Array.prototype.slice.call(root.querySelectorAll(sel)); }
  function esc(s){ return String(s).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  }); }
  function fire(cb, arg){ try { if (typeof cb === 'function') cb(arg); } catch(e){ console.warn('[vrApt] callback err', e); } }

  /* ── Cache DOM refs (once) ───────────────────────────────── */
  function _cache(){
    root = document.querySelector('[data-vrapt]');
    if (!root) return false;
    scrim       = $('[data-vrapt-scrim]');
    sheet       = $('[data-vrapt-sheet]');
    backBtn     = $('[data-vrapt-back]');
    closeBtn    = $('[data-vrapt-close]');
    headerIcon  = $('[data-vrapt-header-icon]');
    title       = $('[data-vrapt-title]');
    codePill    = $('[data-vrapt-code-pill]');
    progress    = $('[data-vrapt-progress]');
    progressSegs= $$('.vrApt__progressSeg');
    body        = $('[data-vrapt-body]');
    step0       = $('[data-step="0"]');
    step1       = $('[data-step="1"]');
    step2a      = $('[data-step="2-airline"]');
    step2b      = $('[data-step="2-door"]');
    step3       = $('[data-step="3"]');
    searchInput = $('[data-vrapt-search]');
    searchClear = $('[data-vrapt-search-clear]');
    airportList = $('[data-vrapt-airport-list]');
    emptyEl     = $('[data-vrapt-empty]');
    emptyQ      = $('[data-vrapt-empty-q]');
    airportBadge  = $('[data-vrapt-airport-badge]');
    airportBadge2 = $('[data-vrapt-airport-badge-2]');
    airlineList = $('[data-vrapt-airline-list]');
    airlineFallback = $('[data-vrapt-airline-fallback]');
    airlineContinueBtn = $('[data-vrapt-airline-continue]');
    terminalWrap= $('[data-vrapt-terminal-wrap]');
    doorSection = $('[data-vrapt-door-section]');
    doorList    = $('[data-vrapt-door-list]');
    summaryEl   = $('[data-vrapt-summary]');
    noteEl      = $('[data-vrapt-note]');
    flightLabel = $('[data-vrapt-flight-label]');
    flightInputBox = $('[data-vrapt-flight-input]');
    flightField = $('[data-vrapt-flight]');
    flightError = $('[data-vrapt-flight-error]');
    confirmBtn  = $('[data-vrapt-confirm]');
    confirmText = $('[data-vrapt-confirm-text]');
    return true;
  }

  /* ── Step visibility + header sync ───────────────────────── */
  function _stepEl(){
    if (_step === 0) return step0;
    if (_step === 1) return step1;
    if (_step === 2) return _direction === 'to' ? step2a : step2b;
    if (_step === 3) return step3;
    return null;
  }

  function _showStep(newStep, animate){
    var from = _stepEl();
    _step = newStep;
    var to = _stepEl();

    /* Hide all steps, then show target */
    [step0, step1, step2a, step2b, step3].forEach(function(el){
      if (el) { el.setAttribute('hidden',''); el.classList.remove('is-exiting'); }
    });

    if (animate && from && from !== to) {
      /* Fade-out animation runs on the OUT element, then we swap */
      from.classList.add('is-exiting');
      from.removeAttribute('hidden');
      window.setTimeout(function(){
        from.classList.remove('is-exiting');
        from.setAttribute('hidden','');
        if (to) {
          to.removeAttribute('hidden');
          /* re-trigger fade-in animation */
          void to.offsetWidth;
        }
      }, STEP_OUT_MS);
    } else if (to) {
      to.removeAttribute('hidden');
    }

    /* Full-screen mode on ALL steps — data-vrapt-step lets CSS target each step */
    if(root){root.classList.add('vrApt--full');root.setAttribute('data-vrapt-step',String(_step));}
    _syncHeader();
    _syncProgress();
    _syncBack();
    _renderStep();
  }

  function _syncHeader(){
    /* Title */
    if (_step === 0) title.textContent = t('title0');
    else if (_step === 1) title.textContent = t('title1');
    else if (_step === 2) title.textContent = _direction === 'to' ? t('title2_to') : t('title2_from');
    else if (_step === 3) title.textContent = t('title3');

    /* Header icon color */
    if (_direction && _step > 0) {
      headerIcon.innerHTML = _direction === 'to' ? ICON.flightTakeoff.replace('width="18"','width="24"').replace('height="18"','height="24"')
                                                 : ICON.flightLand.replace('width="18"','width="24"').replace('height="18"','height="24"');
      if (_direction === 'from') headerIcon.classList.add('is-green');
      else headerIcon.classList.remove('is-green');
    } else {
      headerIcon.innerHTML = ICON.connecting;
      headerIcon.classList.remove('is-green');
    }

    /* Code pill */
    if (_airport && _step > 1) {
      codePill.textContent = _airport.code;
      codePill.removeAttribute('hidden');
    } else {
      codePill.setAttribute('hidden','');
    }
  }

  function _syncProgress(){
    if (_step === 0) {
      progress.setAttribute('hidden','');
      return;
    }
    progress.removeAttribute('hidden');
    progressSegs.forEach(function(seg, i){
      seg.classList.remove('is-complete','is-active');
      if (i < _step) seg.classList.add('is-complete');
      else if (i === _step) seg.classList.add('is-active');
    });
  }

  function _syncBack(){
    if (_step > 0) backBtn.removeAttribute('hidden');
    else backBtn.setAttribute('hidden','');
  }

  /* ── Render each step's content ──────────────────────────── */
  function _renderStep(){
    if (_step === 1) _renderAirportList(searchInput.value || '');
    else if (_step === 2 && _direction === 'to') _renderAirlineStep();
    else if (_step === 2 && _direction === 'from') _renderTerminalDoorStep();
    else if (_step === 3) _renderConfirmStep();
  }

  /* Step 1 */
  function _renderAirportList(query){
    var list = window.__VR_AIRPORTS || [];
    var q = (query || '').trim().toUpperCase();
    var filtered = !q ? list : list.filter(function(a){
      return a.code.indexOf(q) !== -1
          || a.name.toUpperCase().indexOf(q) !== -1
          || (a.cityState || '').toUpperCase().indexOf(q) !== -1;
    });

    if (!filtered.length) {
      airportList.innerHTML = '';
      emptyQ.textContent = query;
      emptyEl.removeAttribute('hidden');
      return;
    }
    emptyEl.setAttribute('hidden','');

    var html = '';
    for (var i = 0; i < filtered.length; i++) {
      var a = filtered[i];
      var n = a.terminals.length;
      var suffix = n === 1 ? t('terminal_suffix') : t('terminals_suffix');
      html += '<button type="button" class="vrApt__airportTile" data-vrapt-airport-idx="' + esc(a.code) + '">' +
                '<span class="vrApt__airportCode">' + esc(a.code) + '</span>' +
                '<div class="vrApt__airportMeta">' +
                  '<div class="vrApt__airportName">' + esc(a.name) + '</div>' +
                  '<div class="vrApt__airportCount">' + n + ' ' + suffix + (a.cityState ? ' · ' + esc(a.cityState) : '') + '</div>' +
                '</div>' +
                (a.surcharge ? '<span class="vrApt__airportSurcharge">+$' + a.surcharge + '</span>' : '') +
                '<span class="vrApt__airportChev">' + ICON.chevron + '</span>' +
              '</button>';
    }
    airportList.innerHTML = html;
  }

  /* Step 2a — airline picker */
  function _renderAirlineStep(){
    /* Badge */
    airportBadge.innerHTML = _airportBadgeHtml(_airport);

    /* Collect unique airlines across all terminals */
    var seen = {};
    var airlines = [];
    _airport.terminals.forEach(function(term){
      (term.airlines || []).forEach(function(air){
        if (!seen[air]) { seen[air] = term; airlines.push({ name: air, term: term }); }
      });
    });
    airlines.sort(function(a,b){ return a.name.localeCompare(b.name); });

    if (!airlines.length) {
      airlineList.innerHTML = '';
      airlineFallback.removeAttribute('hidden');
      return;
    }
    airlineFallback.setAttribute('hidden','');

    var html = '';
    for (var i = 0; i < airlines.length; i++) {
      var it = airlines[i];
      var selected = _airline === it.name;
      html += '<button type="button" class="vrApt__airlineTile ' + (selected ? 'is-selected':'') + '" data-vrapt-airline="' + esc(it.name) + '">' +
                '<span class="vrApt__airlineTileIcon">' + ICON.airline + '</span>' +
                '<div class="vrApt__airlineTileText">' +
                  '<div class="vrApt__airlineTileName">' + esc(it.name) + '</div>' +
                  '<div class="vrApt__airlineTileTerm">' + esc(it.term.name) + '</div>' +
                '</div>' +
                (selected
                  ? '<span class="vrApt__airlineTileBadge">' + esc(t('auto_selected')) + '</span><span class="vrApt__airlineTileCheck">' + ICON.checkCircle + '</span>'
                  : '<span class="vrApt__airlineTileChev">' + ICON.chevron + '</span>') +
              '</button>';
    }
    airlineList.innerHTML = html;
  }

  /* Step 2b — terminal + door picker */
  function _renderTerminalDoorStep(){
    airportBadge2.innerHTML = _airportBadgeHtml(_airport);

    var terms = _airport.terminals || [];
    var termHtml = '';
    for (var i = 0; i < terms.length; i++) {
      var t0 = terms[i];
      var sel = _terminal && _terminal.name === t0.name;
      termHtml += '<button type="button" class="vrApt__terminalChip ' + (sel ? 'is-selected':'') + '" data-vrapt-term-idx="' + i + '">' +
                    esc(t0.name) +
                  '</button>';
    }
    terminalWrap.innerHTML = termHtml;

    if (_terminal) {
      doorSection.removeAttribute('hidden');
      var doors = _terminal.doors || [];
      var dHtml = '';
      for (var j = 0; j < doors.length; j++) {
        var d = doors[j];
        var dsel = _door === d;
        dHtml += '<button type="button" class="vrApt__doorTile ' + (dsel ? 'is-selected':'') + '" data-vrapt-door="' + esc(d) + '">' +
                   '<span class="vrApt__doorIcon">' + ICON.pin + '</span>' +
                   '<span class="vrApt__doorName">' + esc(d) + '</span>' +
                   (dsel ? '<span class="vrApt__doorCheck">' + ICON.checkCircle + '</span>' : '') +
                 '</button>';
      }
      doorList.innerHTML = dHtml;
    } else {
      doorSection.setAttribute('hidden','');
      doorList.innerHTML = '';
    }
  }

  function _airportBadgeHtml(a){
    return '<span class="vrApt__airportBadge__icon">' + ICON.plane + '</span>' +
           '<span class="vrApt__airportBadge__code">' + esc(a.code) + '</span>' +
           '<span class="vrApt__airportBadge__name">' + esc(a.name) + '</span>';
  }

  /* Step 3 — confirm */
  function _renderConfirmStep(){
    var isFrom = _direction === 'from';

    summaryEl.className = 'vrApt__summary ' + (isFrom ? 'is-from' : 'is-to');
    var rows = '';
    rows += _summaryRow(ICON.plane, t('airport_lbl') + ':', _airport.code + ' — ' + _airport.name);
    if (_terminal) rows += _summaryRow(ICON.door, t('terminal_lbl') + ':', _terminal.name);
    if (_airline)  rows += _summaryRow(ICON.airline, t('airline_lbl') + ':', _airline);
    if (_door)     rows += _summaryRow(ICON.pin, t('door_lbl') + ':', _door);
    if (_airport.surcharge) rows += _summaryRow(ICON.money, t('surcharge_lbl') + ':', '+$' + _airport.surcharge, true);
    summaryEl.innerHTML = rows;

    noteEl.className = 'vrApt__note ' + (isFrom ? 'is-from' : 'is-to');
    noteEl.innerHTML = (isFrom ? ICON.hail : ICON.place) + '<span>' + (isFrom ? t('note_from') : t('note_to')) + '</span>';

    /* Flight input */
    flightLabel.textContent = isFrom ? t('flight_required') : t('flight_optional');
    flightLabel.classList.toggle('is-error', _flightError);
    flightInputBox.classList.toggle('is-error', _flightError);
    flightError.textContent = t('flight_error');
    if (_flightError) flightError.removeAttribute('hidden'); else flightError.setAttribute('hidden','');
    var hintEl = root.querySelector('.vrApt__flightHint');
    if (hintEl) hintEl.textContent = t('flight_hint');

    /* Confirm button */
    confirmBtn.className = 'vrApt__confirmBtn ' + (isFrom ? 'is-from' : 'is-to');
    confirmText.textContent = isFrom ? t('confirm_from') : t('confirm_to');
  }

  function _summaryRow(icon, label, value, gold){
    var cls = 'vrApt__summaryRow' + (gold ? ' vrApt__summaryRow--gold' : '');
    return '<div class="' + cls + '">' +
             icon +
             '<span class="vrApt__summaryRowLabel">' + esc(label) + '</span>' +
             '<span class="vrApt__summaryRowValue">' + esc(value) + '</span>' +
           '</div>';
  }

  /* ── Event binding (once) ────────────────────────────────── */
  var _bound = false;
  function _bind(){
    if (_bound) return;
    _bound = true;

    /* Scrim + close = dismiss */
    scrim.addEventListener('click', _close);
    closeBtn.addEventListener('click', function(){window.__vrAptGoHome=true;_close();});

    /* Back */
    backBtn.addEventListener('click', _back);

    /* Step 0 — direction cards */
    $$('[data-vrapt-dir]').forEach(function(card){
      card.addEventListener('click', function(){
        _direction = card.getAttribute('data-vrapt-dir');
        _showStep(1, true);
      });
    });

    /* Step 1 — search */
    searchInput.addEventListener('input', function(){
      var q = searchInput.value;
      if (q) searchClear.removeAttribute('hidden'); else searchClear.setAttribute('hidden','');
      if (_searchDebounce) window.clearTimeout(_searchDebounce);
      _searchDebounce = window.setTimeout(function(){ _renderAirportList(q); }, 120);
    });
    searchClear.addEventListener('click', function(){
      searchInput.value = '';
      searchClear.setAttribute('hidden','');
      _renderAirportList('');
      try { searchInput.focus(); } catch(_){}
    });

    /* Step 1 — airport tile click (delegated) */
    airportList.addEventListener('click', function(e){
      var tile = e.target.closest('[data-vrapt-airport-idx]');
      if (!tile) return;
      var code = tile.getAttribute('data-vrapt-airport-idx');
      var ap = (window.__VR_AIRPORTS || []).find(function(a){ return a.code === code; });
      if (!ap) return;
      _airport = ap;
      _terminal = null;
      _airline = null;
      _door = null;
      _showStep(2, true);
    });

    /* Step 2a — airline tile click (delegated) */
    airlineList.addEventListener('click', function(e){
      var tile = e.target.closest('[data-vrapt-airline]');
      if (!tile) return;
      var name = tile.getAttribute('data-vrapt-airline');
      _airline = name;
      /* Auto-select matching terminal */
      for (var i = 0; i < _airport.terminals.length; i++) {
        if ((_airport.terminals[i].airlines || []).indexOf(name) !== -1) {
          _terminal = _airport.terminals[i]; break;
        }
      }
      _renderAirlineStep();
      if (_advanceTimer) window.clearTimeout(_advanceTimer);
      _advanceTimer = window.setTimeout(function(){ _showStep(3, true); }, ADVANCE_DELAY_MS);
    });

    /* Step 2a fallback — continue without airline */
    airlineContinueBtn.addEventListener('click', function(){
      _airline = null; _terminal = null;
      _showStep(3, true);
    });

    /* Step 2b — terminal chip (delegated) */
    terminalWrap.addEventListener('click', function(e){
      var chip = e.target.closest('[data-vrapt-term-idx]');
      if (!chip) return;
      var idx = parseInt(chip.getAttribute('data-vrapt-term-idx'), 10);
      _terminal = _airport.terminals[idx];
      _door = null;
      _renderTerminalDoorStep();
    });

    /* Step 2b — door tile (delegated) */
    doorList.addEventListener('click', function(e){
      var tile = e.target.closest('[data-vrapt-door]');
      if (!tile) return;
      _door = tile.getAttribute('data-vrapt-door');
      _renderTerminalDoorStep();
      if (_advanceTimer) window.clearTimeout(_advanceTimer);
      _advanceTimer = window.setTimeout(function(){ _showStep(3, true); }, ADVANCE_DELAY_MS);
    });

    /* Step 3 — flight input */
    flightField.addEventListener('input', function(){
      if (_flightError) {
        _flightError = false;
        flightLabel.classList.remove('is-error');
        flightInputBox.classList.remove('is-error');
        flightError.setAttribute('hidden','');
      }
    });

    /* Step 3 — confirm */
    confirmBtn.addEventListener('click', function(){
      var isFrom = _direction === 'from';
      var flight = (flightField.value || '').trim().toUpperCase();
      if (isFrom && !flight) {
        _flightError = true;
        _renderConfirmStep();
        return;
      }
      _emitConfirm(flight);
      _close(true);
    });

    /* Escape key */
    root.addEventListener('keydown', function(e){
      if (e.key === 'Escape' || e.keyCode === 27) _close();
    });

    /* Update placeholders that depend on locale (first render) */
    searchInput.placeholder = t('search_ph');
  }

  /* ── Emit confirm in the shape expected by _vrAptOpen ────── */
  function _emitConfirm(flight){
    /* Contract from 005_09-28-46_260627b.liquid:2916-2925:
       s.airport = [code, name, cityState, surchargeUSD, lat, lng]
       s.terminal = string
       s.airline = [name]  (only if type='to')
       s.door = string     (only if type='from')
       s.type = 'to' | 'from'
       s.flight = string                                         */
    var a = _airport;
    var payload = {
      airport: [a.code, a.name, a.cityState || '', a.surcharge || 0, a.lat, a.lng],
      terminal: _terminal ? _terminal.name : null,
      airline:  (_direction === 'to' && _airline) ? [_airline] : null,
      door:     (_direction === 'from' && _door) ? _door : null,
      type:     _direction,
      flight:   flight || ''
    };
    /* Stash flight globally for the existing Liquid __vrAptGetFlight() hook */
