        /* ── Actions ── */
        +'.vrSched__actions{display:flex;flex-direction:column;gap:8px}'
        +'.vrSched__btnCancel{width:100%;padding:13px 16px;border-radius:100px;background:transparent;border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.7);font:600 12px/1 sans-serif;letter-spacing:.05em;cursor:pointer;transition:all .2s;text-transform:uppercase}'
        +'.vrSched__btnCancel:hover{background:rgba(255,255,255,.04);color:#fff;border-color:rgba(255,255,255,.2)}'
        /* ── Home preview pill (premium minimal) ── */
        +'#vrSchedPreview{position:fixed;top:calc(var(--vip-nav-h,72px) + 18px);left:50%;transform:translateX(-50%);z-index:99997;background:linear-gradient(180deg,#141414,#0a0a0a);border:1px solid rgba(232,197,71,.22);border-radius:100px;padding:8px 14px 8px 8px;display:inline-flex;align-items:center;gap:12px;cursor:pointer;box-shadow:0 10px 32px rgba(0,0,0,.55),0 0 0 1px rgba(0,0,0,.3) inset,0 1px 0 rgba(232,197,71,.08) inset;font-family:\'Poppins\',\'Inter\',-apple-system,sans-serif;color:#fff;max-width:calc(100vw - 24px);animation:vrSchedPrvIn .55s cubic-bezier(.22,1,.36,1) both;transition:transform .25s cubic-bezier(.22,1,.36,1),border-color .25s,box-shadow .25s}'
        +'#vrSchedPreview::before{content:"";position:absolute;inset:-1px;border-radius:100px;padding:1px;background:linear-gradient(135deg,rgba(232,197,71,.4),rgba(232,197,71,0) 40%,rgba(232,197,71,0) 60%,rgba(232,197,71,.4));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none;opacity:.6;transition:opacity .3s}'
        +'#vrSchedPreview:hover{transform:translateX(-50%) translateY(-2px);border-color:rgba(232,197,71,.4);box-shadow:0 14px 40px rgba(0,0,0,.65),0 0 24px rgba(232,197,71,.14),0 0 0 1px rgba(0,0,0,.3) inset,0 1px 0 rgba(232,197,71,.12) inset}'
        +'#vrSchedPreview:hover::before{opacity:1}'
        +'#vrSchedPreview:active{transform:translateX(-50%) translateY(0) scale(.98)}'
        +'#vrSchedPreview[hidden]{display:none!important}'
        +'@keyframes vrSchedPrvIn{from{opacity:0;transform:translateX(-50%) translateY(-14px) scale(.95)}to{opacity:1;transform:translateX(-50%) translateY(0) scale(1)}}'
        /* Icon badge */
        +'#vrSchedPreview .vrSchedPrv__ico{position:relative;width:30px;height:30px;border-radius:50%;background:radial-gradient(circle at 30% 30%,rgba(232,197,71,.25),rgba(232,197,71,.06) 70%);border:1px solid rgba(232,197,71,.35);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#E8C547;box-shadow:0 2px 8px rgba(232,197,71,.15)}'
        +'#vrSchedPreview .vrSchedPrv__ico::after{content:"";position:absolute;inset:-2px;border-radius:50%;border:1px solid rgba(232,197,71,.4);opacity:0;animation:vrSchedPing 2.4s ease-out infinite}'
        +'@keyframes vrSchedPing{0%{opacity:.6;transform:scale(1)}100%{opacity:0;transform:scale(1.5)}}'
        /* Text split: countdown + separator + date */
        +'#vrSchedPreview .vrSchedPrv__txt{display:inline-flex;align-items:baseline;gap:8px;white-space:nowrap;overflow:hidden;min-width:0}'
        +'#vrSchedPreview .vrSchedPrv__time{font:800 14px/1 sans-serif;color:#E8C547;letter-spacing:.02em;font-variant-numeric:tabular-nums;text-shadow:0 0 16px rgba(232,197,71,.35)}'
        +'#vrSchedPreview .vrSchedPrv__sep{display:inline-block;width:3px;height:3px;border-radius:50%;background:rgba(255,255,255,.3);transform:translateY(-3px)}'
        +'#vrSchedPreview .vrSchedPrv__when{font:500 12.5px/1 sans-serif;color:rgba(255,255,255,.75);letter-spacing:.01em}'
        /* Arrow */
        +'#vrSchedPreview .vrSchedPrv__arrow{width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;color:rgba(232,197,71,.85);font:800 16px/1 sans-serif;transition:transform .2s}'
        +'#vrSchedPreview:hover .vrSchedPrv__arrow{transform:translateX(3px);color:#E8C547}'
      ;
      document.head.appendChild(s);
    }

    function buildCard(){
      if(cardEl)return;
      cardEl=document.createElement('div');cardEl.id='vrSched';cardEl.setAttribute('hidden','');
      cardEl.innerHTML='<div id="vrSchedCard">'
        +'<div class="vrSched__head">'
          +'<div class="vrSched__badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><span data-vrsch-badge>Scheduled Ride</span></div>'
          +'<button type="button" class="vrSched__close" data-vrsch-close aria-label="Close"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg></button>'
        +'</div>'
        +'<div class="vrSched__timerWrap">'
          +'<svg class="vrSched__ring" viewBox="0 0 160 160"><circle class="vrSched__ringBg" cx="80" cy="80" r="76"/><circle class="vrSched__ringFg" data-vrsch-ring cx="80" cy="80" r="76" stroke-dasharray="477.52" stroke-dashoffset="0"/></svg>'
          +'<div class="vrSched__timerInner">'
            +'<div class="vrSched__timerVal" data-vrsch-val>--:--</div>'
            +'<div class="vrSched__timerSub" data-vrsch-sub>UNTIL PICKUP</div>'
          +'</div>'
        +'</div>'
        +'<div class="vrSched__finding" data-vrsch-finding><div class="vrSched__spinner"></div><div class="vrSched__findingTxt" data-vrsch-finding-txt>Finding driver…</div></div>'
        +'<div class="vrSched__when" data-vrsch-when>—</div>'
        +'<div class="vrSched__route">'
          +'<div class="vrSched__routeRow"><span class="vrSched__dot vrSched__dot--pu"></span><div><div class="vrSched__rowLbl" data-vrsch-lbl-pu>Pickup</div><div class="vrSched__rowTxt" data-vrsch-pu>—</div></div></div>'
          +'<div class="vrSched__routeRow"><span class="vrSched__dot vrSched__dot--dr"></span><div><div class="vrSched__rowLbl" data-vrsch-lbl-dr>Dropoff</div><div class="vrSched__rowTxt" data-vrsch-dr>—</div></div></div>'
        +'</div>'
        +'<div class="vrSched__driver" data-vrsch-driver>'
          +'<div class="vrSched__drPhoto" data-vrsch-dr-photo>👤</div>'
          +'<div class="vrSched__drInfo"><div class="vrSched__drName" data-vrsch-dr-name>—</div><div class="vrSched__drMeta" data-vrsch-dr-meta>—</div></div>'
        +'</div>'
        +'<div class="vrSched__hint"><svg class="vrSched__hintIco" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg><span data-vrsch-hint>You\'ll receive an email confirmation once your driver is assigned.</span></div>'
        +'<div class="vrSched__actions">'
          +'<button type="button" class="vrSched__btnCancel" data-vrsch-cancel>Cancel Reservation</button>'
        +'</div>'
      +'</div>';
      document.body.appendChild(cardEl);
      cardEl.querySelector('[data-vrsch-close]').addEventListener('click',hide);
      cardEl.querySelector('[data-vrsch-cancel]').addEventListener('click',onCancel);
      cardEl.addEventListener('click',function(e){if(e.target===cardEl)hide();});
    }

    function buildPreview(){
      if(preveEl)return;
      preveEl=document.createElement('div');preveEl.id='vrSchedPreview';preveEl.setAttribute('hidden','');
      preveEl.innerHTML='<div class="vrSchedPrv__ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>'
        +'<div class="vrSchedPrv__txt"><span class="vrSchedPrv__time" data-vrsch-prv-time>—</span><span class="vrSchedPrv__sep"></span><span class="vrSchedPrv__when" data-vrsch-prv-when>Tap to view</span></div>'
        +'<span class="vrSchedPrv__arrow">›</span>';
      document.body.appendChild(preveEl);
      preveEl.addEventListener('click',show);
    }

    function fmtWhen(d){
      if(!d)return '—';
      try{
        var now=new Date(),isSame=function(a,b){return a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate();};
        var tomorrow=new Date(now);tomorrow.setDate(now.getDate()+1);
        var hh=d.getHours(),mm=d.getMinutes(),ap=hh>=12?'PM':'AM';hh=hh%12||12;
        var tStr=hh+':'+(mm<10?'0'+mm:mm)+' '+ap;
        if(isSame(d,now))return 'Today at '+tStr;
        if(isSame(d,tomorrow))return 'Tomorrow at '+tStr;
        var days=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
        var months=['January','February','March','April','May','June','July','August','September','October','November','December'];
        return days[d.getDay()]+' '+d.getDate()+' '+months[d.getMonth()]+', '+tStr;
      }catch(_){return '—';}
    }
    function fmtCountdown(ms){
      if(ms<=0)return '00:00';
      var tot=Math.floor(ms/1000),h=Math.floor(tot/3600),m=Math.floor((tot%3600)/60),s=tot%60;
      var d=Math.floor(h/24);
      if(d>=1){return d+'d '+(h%24)+'h';}
      if(h>=1){return h+'h '+(m<10?'0'+m:m)+'m';}
      return (m<10?'0'+m:m)+':'+(s<10?'0'+s:s);
    }
    function tick(){
      if(!cardEl||!schedAt)return;
      var now=Date.now(),target=new Date(schedAt).getTime(),diff=target-now;
      var valEl=cardEl.querySelector('[data-vrsch-val]'),subEl=cardEl.querySelector('[data-vrsch-sub]'),ringEl=cardEl.querySelector('[data-vrsch-ring]'),findEl=cardEl.querySelector('[data-vrsch-finding]');
      /* Update preview too */
      if(preveEl){
        var prvTime=preveEl.querySelector('[data-vrsch-prv-time]'),prvWhen=preveEl.querySelector('[data-vrsch-prv-when]');
        if(prvTime)prvTime.textContent=fmtCountdown(diff);
        if(prvWhen)prvWhen.textContent='Scheduled ride';
      }
      /* Finding driver state: ≤20min before pickup and no driver yet */
      var hasDriver=!!(meta&&meta.driver_name);
      var twentyMin=20*60*1000;
      if(diff<=twentyMin && !hasDriver && !findingMode){
        findingMode=true;
        if(findEl)findEl.classList.add('is-active');
        if(valEl)valEl.style.opacity='.35';
        if(subEl)subEl.textContent='';
      } else if(findingMode && hasDriver){
        findingMode=false;
        if(findEl)findEl.classList.remove('is-active');
        if(valEl)valEl.style.opacity='1';
        if(subEl)subEl.textContent='UNTIL PICKUP';
      }
      if(valEl)valEl.textContent=fmtCountdown(diff);
      /* Ring: fills proportionally. Full ring = 60 minutes window */
      if(ringEl){
        var winMs=60*60*1000,prog=Math.max(0,Math.min(1,1-(diff/winMs)));
        var circ=477.52;
        ringEl.style.strokeDashoffset=String(circ*(1-prog));
      }
    }

    function pollStatus(){
      if(!bookingId||!apiBase||!webKey)return;
      /* Skip polling for TEMP booking IDs — backend won't know them */
      if(typeof bookingId==='string' && bookingId.indexOf('TEMP-')===0)return;
      fetch(apiBase+'/bookings/web/'+bookingId+'/status',{headers:{'Authorization':'Bearer '+webKey}})
        .then(function(r){
          /* Don't clear on 4xx/5xx — keep the card with saved data */
          if(!r.ok){return null;}
          return r.json();
        })
        .then(function(d){
          if(!d)return; /* Keep card on network/auth failure */
          meta=d;
          var st=(d.status||'').toLowerCase();
          /* Only clear when backend EXPLICITLY returns a terminal status */
          if(st==='completed'||st==='cancelled'||st==='canceled'){localStorage.removeItem('vr_active_booking');hide();if(preveEl)preveEl.setAttribute('hidden','');if(pollIv){clearInterval(pollIv);pollIv=null;}if(tickIv){clearInterval(tickIv);tickIv=null;}return;}
          /* Transition to Live Tracker when driver starts trip or arrives */
          if(st==='in_trip'||st==='in_progress'||st==='on_trip'||st==='arrived'){
            fadeToTracker(d);return;
          }
          renderDriver(d);
        }).catch(function(){/* Network error — keep card visible, try again next poll */});
    }
    var _schedDriverEmailSent=false;
    function renderDriver(d){
      if(!cardEl||!d)return;
      var drEl=cardEl.querySelector('[data-vrsch-driver]');
      var hasDriver=!!d.driver_name;
      if(hasDriver){
        drEl.classList.add('is-active');
        var nEl=cardEl.querySelector('[data-vrsch-dr-name]'),mEl=cardEl.querySelector('[data-vrsch-dr-meta]'),pEl=cardEl.querySelector('[data-vrsch-dr-photo]');
        if(nEl)nEl.textContent=d.driver_name;
        var rating=d.driver_rating?('★ '+Number(d.driver_rating).toFixed(1)):'';
        var vehicle=[d.vehicle_make,d.vehicle_model].filter(Boolean).join(' ')||'';
        var plate=d.vehicle_plate?(' · '+d.vehicle_plate):'';
        if(mEl)mEl.innerHTML=(rating?'<b>'+rating+'</b>':'')+(rating&&vehicle?' · ':'')+(vehicle||'')+plate;
        if(pEl){if(d.driver_photo_url)pEl.innerHTML='<img src="'+d.driver_photo_url+'" alt="">';else pEl.textContent=(d.driver_name||'?').charAt(0).toUpperCase();}
        /* Update hint */
        var hint=cardEl.querySelector('[data-vrsch-hint]');
        if(hint)hint.textContent='Your driver is confirmed. We\'ll notify you when they\'re on the way.';
        /* Email 2: scheduled driver assigned (only once per session) */
        if(!_schedDriverEmailSent && typeof window.__vrSendSchedDriverAssigned==='function'){
          _schedDriverEmailSent=true;
          try{window.__vrSendSchedDriverAssigned(d);}catch(_){}
        }
      } else {
        drEl.classList.remove('is-active');
      }
    }
    function fadeToTracker(d){
      if(!cardEl)return;
      /* Email 3: scheduled driver en route */
      if(typeof window.__vrSendSchedEnRoute==='function'){try{window.__vrSendSchedEnRoute(d);}catch(_){}}
      cardEl.style.transition='opacity .5s ease';
      cardEl.style.opacity='0';
      setTimeout(function(){
        hide();
        if(preveEl)preveEl.setAttribute('hidden','');
        if(window.__vrLTShow)window.__vrLTShow(d,bookingId,apiBase,webKey,function(){});
      },500);
    }
    function onCancel(){
      if(!confirm('Cancel this reservation? The hold on your card will be released.'))return;
      if(window.__vrCancelBooking)window.__vrCancelBooking(apiBase,webKey);
      try{localStorage.removeItem('vr_active_booking');}catch(_){}
      if(pollIv){clearInterval(pollIv);pollIv=null;}
      if(tickIv){clearInterval(tickIv);tickIv=null;}
      hide();if(preveEl)preveEl.setAttribute('hidden','');
    }
    function show(){
      injectCss();buildCard();
      if(!cardEl)return;
      /* Populate from meta/saved */
      var puEl=cardEl.querySelector('[data-vrsch-pu]'),drEl=cardEl.querySelector('[data-vrsch-dr]'),whEl=cardEl.querySelector('[data-vrsch-when]');
      if(puEl)puEl.textContent=(meta&&meta.pickup&&(meta.pickup.address||meta.pickup))||(saved&&saved.pickup)||'—';
      if(drEl)drEl.textContent=(meta&&meta.dropoff&&(meta.dropoff.address||meta.dropoff))||(saved&&saved.dropoff)||'—';
      if(whEl&&schedAt)whEl.textContent=fmtWhen(new Date(schedAt));
      cardEl.removeAttribute('hidden');
      if(meta)renderDriver(meta);
      tick();if(tickIv)clearInterval(tickIv);tickIv=setInterval(tick,1000);
    }
    function hide(){
      if(cardEl){cardEl.setAttribute('hidden','');cardEl.style.opacity='';}
      if(tickIv){clearInterval(tickIv);tickIv=null;}
      _shown=false;
    }

    var saved=null,_shown=false;
    window.__vrSchedShow=function(savedObj,currentMeta,api,key){
      if(_shown && cardEl && !cardEl.hasAttribute('hidden')) return;
      _shown=true;
      saved=savedObj||{};meta=currentMeta||null;apiBase=api;webKey=key;bookingId=saved.id;schedAt=saved.scheduled_at;
      injectCss();buildPreview();show();
      if(preveEl){
        var prvWhen=preveEl.querySelector('[data-vrsch-prv-when]');
        if(prvWhen)prvWhen.textContent=fmtWhen(new Date(schedAt));
        preveEl.removeAttribute('hidden');
      }
      if(pollIv)clearInterval(pollIv);pollIv=setInterval(pollStatus,5000);
    };
    window.__vrSchedHide=function(){hide();if(preveEl)preveEl.setAttribute('hidden','');if(pollIv){clearInterval(pollIv);pollIv=null;}};

    /* ── Auto-resume on page load/refresh (independent of map init) ── */
    function autoResume(){
      try{
        var raw=localStorage.getItem('vr_active_booking');
        if(!raw)return;
        var parsed=JSON.parse(raw);
        if(!parsed||!parsed.id||!parsed.scheduled_at)return;
        /* Only clean up if the scheduled time is way past (>3 days) to avoid accidentally losing active rides */
        var schedTime=new Date(parsed.scheduled_at).getTime();
        if(Date.now()-schedTime>3*24*60*60*1000){localStorage.removeItem('vr_active_booking');return;}
        var api='https://cruise-api-proxy.cruise-api.workers.dev';
        var key=(window.__vrWebKey||'');
        var isTempId=typeof parsed.id==='string' && parsed.id.indexOf('TEMP-')===0;
        /* For TEMP IDs, skip fetch and show card with saved data only */
        if(isTempId){window.__vrSchedShow(parsed,{},api,key);return;}
        /* Fetch current status from backend; if network fails, still show card with saved data */
        fetch(api+'/bookings/web/'+parsed.id+'/status',{headers:key?{'Authorization':'Bearer '+key}:{}})
          .then(function(r){return r.ok?r.json():null;})
          .then(function(d){
            /* Network/auth failure → still show the card with whatever we have saved */
            if(!d){window.__vrSchedShow(parsed,{},api,key);return;}
            var s=(d.status||'').toLowerCase();
            /* Only clear on EXPLICIT terminal status from backend */
            if(s==='completed'||s==='cancelled'||s==='canceled'){localStorage.removeItem('vr_active_booking');return;}
            if(s==='in_trip'||s==='in_progress'||s==='on_trip'||s==='arrived'){
              if(window.__vrLTShow)window.__vrLTShow(d,parsed.id,api,key,function(){});
              return;
            }
            window.__vrSchedShow(parsed,d,api,key);
          })
          .catch(function(){window.__vrSchedShow(parsed,{},api,key);});
      }catch(_){}
    }
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(autoResume,400);});
    else setTimeout(autoResume,400);
    /* Belt and suspenders: also try at 1.5s and 3s */
    setTimeout(autoResume,1500);
    setTimeout(autoResume,3000);
  })();
</script>
