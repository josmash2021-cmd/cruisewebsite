<script>
/* Scheduled Card: runs on BOTH mobile and desktop */
(function(){
  var isMobile=window.innerWidth<900;
  if(isMobile)return; /* Mobile card is injected by separate IIFE below */
  function buildHomeBar(){
    if(document.getElementById('vrDeskBar')) return null;
    var bar=document.createElement('div');
    bar.id='vrDeskBar';
    bar.innerHTML='<div class="vrdb__left">'
      +'<h2 class="vrdb__title" data-vrdb-title>¿A dónde?</h2>'
      +'<div class="vrdb__switch" data-vrdb-switch>'
        +'<span class="vrdb__switchSlide" aria-hidden="true"></span>'
        +'<button type="button" class="vrdb__switchBtn is-active" data-vrdb-mode="now">⚡ <span data-vrdb-now>Ahora</span></button>'
        +'<button type="button" class="vrdb__switchBtn" data-vrdb-mode="later">🕐 <span data-vrdb-later>Programar</span></button>'
      +'</div>'
      +'</div>'
      +'<button type="button" class="vrdb__arrow" data-vrdb-go aria-label="Continue">›</button>';
    document.body.appendChild(bar);
    function syncLabels(){
      var realTitle=document.querySelector('[data-vipride-compact-heading]');
      var realNow=document.querySelector('[data-vipride-mode-now]');
      var realLater=document.querySelector('[data-vipride-mode-schedule]');
      if(realTitle) bar.querySelector('[data-vrdb-title]').textContent=realTitle.textContent;
      if(realNow) bar.querySelector('[data-vrdb-now]').textContent=realNow.textContent;
      if(realLater) bar.querySelector('[data-vrdb-later]').textContent=realLater.textContent;
    }
    syncLabels();
    setTimeout(syncLabels, 500);
    setTimeout(syncLabels, 1500);
    /* Click anywhere on the bar opens locPicker (except switch and arrow) */
    bar.addEventListener('click',function(e){
      if(e.target.closest('[data-vrdb-switch]')||e.target.closest('[data-vrdb-go]'))return;
      var real=document.querySelector('[data-vipride-open-locpicker]');
      if(real) real.click();
    });
    bar.querySelector('[data-vrdb-go]').addEventListener('click',function(e){
      e.stopPropagation();
      var real=document.querySelector('[data-vipride-compact-next]');
      if(real) real.click();
    });
    bar.querySelectorAll('[data-vrdb-mode]').forEach(function(btn){
      btn.addEventListener('click',function(e){
        e.stopPropagation();
        var mode=btn.getAttribute('data-vrdb-mode');
        bar.querySelectorAll('.vrdb__switchBtn').forEach(function(p){p.classList.remove('is-active');});
        btn.classList.add('is-active');
        var sw=bar.querySelector('[data-vrdb-switch]');
        if(sw){sw.classList.toggle('is-later',mode==='later');}
        var real=document.querySelector('[data-vipride-compact-mode-btn][data-compact-mode="'+mode+'"]');
        if(real) real.click();
      });
    });
    return bar;
  }
  function buildRideBar(){
    if(document.getElementById('vrDeskBarRide')) return null;
    var bar=document.createElement('div');
    bar.id='vrDeskBarRide';
    bar.innerHTML='<h3 class="vrdbr__title" data-vrdbr-title>Elige un vehículo</h3>'
      +'<div class="vrdbr__cards" data-vrdbr-cards></div>'
      +'<div class="vrdbr__detail" data-vrdbr-detail hidden>'
        +'<div class="vrdbr__detailDesc" data-vrdbr-detail-desc></div>'
        +'<div class="vrdbr__detailRow">'
          +'<div class="vrdbr__detailMeta"><span data-vrdbr-detail-eta>--</span><span class="vrdbr__detailSep">•</span><span data-vrdbr-detail-seats>--</span></div>'
          +'<div class="vrdbr__detailPrice" data-vrdbr-detail-price>--</div>'
        +'</div>'
      +'</div>'
      +'<div class="vrdbr__actions">'
      +'<button type="button" class="vrdbr__payBtn" data-vrdbr-pay><span data-vrdbr-pay-label>Método de Pago</span> ›</button>'
      +'<button type="button" class="vrdbr__reqBtn" data-vrdbr-req disabled translate="no"><span data-vrdbr-req-label translate="no">REQUEST NOW</span></button>'
      +'</div>';
    document.body.appendChild(bar);
    function syncFromOriginal(){
      try {
      var realTitle=document.querySelector('[data-vipride-prices-title]');
      if(realTitle) bar.querySelector('[data-vrdbr-title]').textContent=realTitle.textContent;
      var realCards=document.querySelectorAll('[data-vipride-card]');
      var cardsContainer=bar.querySelector('[data-vrdbr-cards]');
      if(!cardsContainer) return;
      if(realCards.length && cardsContainer.children.length !== realCards.length){
        cardsContainer.innerHTML='';
        realCards.forEach(function(rc,idx){
          var clone=document.createElement('button');
          clone.type='button';
          /* Reuse the exact mobile rideCard classes + inner HTML for identical look */
          clone.className=rc.className;
          if(rc.getAttribute('data-disabled')==='true') clone.setAttribute('data-disabled','true');
          clone.setAttribute('data-vrdbr-mirror',String(idx));
          clone.innerHTML=rc.innerHTML;
          clone.addEventListener('click',function(e){e.preventDefault();rc.click();});
          cardsContainer.appendChild(clone);
        });
      } else {
        realCards.forEach(function(rc,idx){
          var clone=cardsContainer.children[idx];
          if(!clone) return;
          /* Keep clone in sync with the real card */
          if(rc.className!==clone.className) clone.className=rc.className;
          var rcDis=rc.getAttribute('data-disabled')==='true' || rc.disabled;
          if(rcDis){clone.setAttribute('data-disabled','true');clone.disabled=true;}
          else{clone.removeAttribute('data-disabled');clone.disabled=false;}
          /* Sync price text */
          var rPrice=rc.querySelector('[data-vipride-card-price]');
          var cPrice=clone.querySelector('[data-vipride-card-price]');
          if(rPrice&&cPrice&&cPrice.textContent!==rPrice.textContent) cPrice.textContent=rPrice.textContent;
          /* Sync eta text */
          var rEta=rc.querySelector('[data-vipride-eta]');
          var cEta=clone.querySelector('[data-vipride-eta]');
          if(rEta&&cEta&&cEta.textContent!==rEta.textContent) cEta.textContent=rEta.textContent;
          /* Sync active */
          if(rc.classList.contains('is-active')) clone.classList.add('is-active');
          else clone.classList.remove('is-active');
        });
      }
      /* Show actions (payment + request) only when a vehicle is selected */
      var realActions=document.querySelector('[data-vipride-action-btns]');
      var cloneActions=bar.querySelector('.vrdbr__actions');
      var actionsVisible=realActions&&!realActions.hasAttribute('hidden');
      if(cloneActions){
        if(actionsVisible) cloneActions.style.display='';
        else cloneActions.style.display='none';
      }
      var realPay=document.querySelector('[data-vipride-rc-heading]');
      var cloneLab=bar.querySelector('[data-vrdbr-pay-label]');
      if(realPay && cloneLab) cloneLab.textContent=realPay.textContent;
      var realReq=document.querySelector('[data-vipride-request-btn]');
      var cloneReq=bar.querySelector('[data-vrdbr-req]');
      var cloneReqLab=bar.querySelector('[data-vrdbr-req-label]');
      /* Prefer the CTA (has proper REQUEST NOW / RESERVE NOW), fallback to request-text */
      var realCta=document.querySelector('[data-vipride-cta]');
      var realReqText=document.querySelector('[data-vipride-request-text]');
      var labelSrc=(realCta&&realCta.textContent.trim())||(realReqText&&realReqText.textContent.trim())||'';
      if(cloneReqLab && labelSrc) cloneReqLab.textContent=labelSrc.toUpperCase();
      if(realReq && cloneReq) cloneReq.disabled=realReq.disabled;
      var realDetail=document.querySelector('[data-vipride-detail]');
      var cloneDetail=bar.querySelector('[data-vrdbr-detail]');
      if(realDetail && cloneDetail){
        var detailVisible=!realDetail.hasAttribute('hidden');
        if(detailVisible){
          cloneDetail.removeAttribute('hidden');
          var dDesc=document.querySelector('[data-vipride-detail-desc]'),dEta=document.querySelector('[data-vipride-detail-eta]'),dSeats=document.querySelector('[data-vipride-detail-seats]'),dPrice=document.querySelector('[data-vipride-detail-price]');
          var cDesc=bar.querySelector('[data-vrdbr-detail-desc]'),cEta=bar.querySelector('[data-vrdbr-detail-eta]'),cSeats=bar.querySelector('[data-vrdbr-detail-seats]'),cPrice=bar.querySelector('[data-vrdbr-detail-price]');
          if(dDesc && cDesc) cDesc.textContent=dDesc.textContent;
          if(dEta && cEta) cEta.textContent=dEta.textContent;
          if(dSeats && cSeats) cSeats.textContent=dSeats.textContent;
          if(dPrice && cPrice) cPrice.textContent=dPrice.textContent;
        } else {
          cloneDetail.setAttribute('hidden','');
        }
      }
      } catch(e) { /* silent guard — DOM not ready yet */ }
    }
    syncFromOriginal();
    setTimeout(syncFromOriginal, 500);
    setTimeout(syncFromOriginal, 1500);
    bar.querySelector('[data-vrdbr-pay]').addEventListener('click',function(){
      var real=document.querySelector('[data-vipride-payment-btn]');
      if(real) real.click();
    });
    bar.querySelector('[data-vrdbr-req]').addEventListener('click',function(){
      var real=document.querySelector('[data-vipride-request-btn]');
      if(real && !real.disabled) real.click();
    });
    setInterval(syncFromOriginal, 500);
    return bar;
  }
  var homeBar=null, rideBar=null;
  function updateVisibility(){
    try {
    if(!homeBar) homeBar=document.getElementById('vrDeskBar');
    if(!rideBar) rideBar=document.getElementById('vrDeskBarRide');
    var sheet=document.querySelector('[data-vipride-sheet]');
    var step=sheet?sheet.getAttribute('data-vipride-step'):'1';
    var laterOpen=document.querySelector('[data-vipride-later-overlay]:not([hidden])');
    var schedOpen=document.querySelector('[data-vipride-schedule-overlay]:not([hidden])');
    var payOpen=document.querySelector('[data-vipride-pay-overlay]:not([hidden])');
    var locOpen=document.querySelector('[data-vipride-locpicker]:not([hidden])');
    var mapPickOpen=document.querySelector('[data-vipride-mappicker]:not([hidden])');
    var authOpen=document.documentElement.classList.contains('vipride-auth-open');
    var testOpen=document.querySelector('[data-vipride-test-confirm]:not([hidden])');
    var guestOpen=document.querySelector('[data-vr-guest]:not([hidden])');
    var authGateOpen=document.querySelector('[data-vipride-auth-gate][data-visible]');
    var aptOpen=document.querySelector('.vrApt.vrApt--full,.vrApt.is-open');
    var ltOpen=document.querySelector('#vrLT:not([hidden])');
    var schedCardOpen=document.querySelector('#vrSched:not([hidden])');
    var noDriverOpen=document.querySelector('#vrNoDriver:not([hidden])');
    var deskChatOpen=document.querySelector('#vrDeskChat:not([hidden])');
    var authPageOpen=document.querySelector('.vipRide__authPage[data-visible]');
    var anyOverlay=laterOpen||schedOpen||payOpen||locOpen||mapPickOpen||authOpen||testOpen||guestOpen||authGateOpen||aptOpen||ltOpen||schedCardOpen||noDriverOpen||deskChatOpen||authPageOpen;
    if(homeBar){
      if(step==='1' && !anyOverlay) homeBar.style.setProperty('display','flex','important');
      else homeBar.style.setProperty('display','none','important');
    }
    if(rideBar){
      /* rideBar shows on step 3 — airport/schedule flows are PARENTS of step 3, don't block it.
         Only block for true modal overlays that sit above step 3. */
      var blockRide=laterOpen||payOpen||locOpen||mapPickOpen||authOpen||testOpen||guestOpen||authGateOpen||ltOpen||schedCardOpen||noDriverOpen||deskChatOpen||authPageOpen;
      if(step==='3' && !blockRide) rideBar.style.setProperty('display','flex','important');
      else rideBar.style.setProperty('display','none','important');
    }
    } catch(e) { /* silent guard */ }
  }
  function init(){
    buildHomeBar();
    buildRideBar();
    updateVisibility();
    var targetSheet=document.querySelector('[data-vipride-sheet]');
    if(targetSheet && window.MutationObserver){
      new MutationObserver(updateVisibility).observe(targetSheet,{attributes:true,attributeFilter:['data-vipride-step','class']});
    }
    ['[data-vipride-later-overlay]','[data-vipride-schedule-overlay]','[data-vipride-pay-overlay]','[data-vipride-locpicker]','[data-vipride-mappicker]','[data-vipride-test-confirm]','[data-vr-guest]','[data-vipride-auth-gate]'].forEach(function(sel){
      var el=document.querySelector(sel);
      if(el && window.MutationObserver){
        new MutationObserver(updateVisibility).observe(el,{attributes:true,attributeFilter:['hidden','class']});
      }
    });
    if(window.MutationObserver){
      new MutationObserver(updateVisibility).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
    }
    setInterval(updateVisibility, 500);
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();


  /* ════ Desktop Chat modal (replaces mobile chat on PC) ════ */
  (function(){
    if(window.innerWidth<900)return;
    var chatEl=null,bodyEl=null,inputEl=null,sendBtn=null,nameEl=null,avatarEl=null,backBtn=null;
    var apiBase='https://cruise-api-proxy.cruise-api.workers.dev';
    var webKey=null,bookingId=null,driverName='—',driverAvatar=null,lastMsgId=0,pollIv=null,sending=false;
    var currentLang=((document.documentElement.lang||navigator.language||'en').toLowerCase().indexOf('es')===0)?'es':'en';

    function buildChat(){
      if(chatEl)return;
      chatEl=document.createElement('div');chatEl.id='vrDeskChat';chatEl.setAttribute('hidden','');
      chatEl.innerHTML='<div id="vrDeskChat__card">'
        +'<div id="vrDeskChat__head">'
          +'<button id="vrDeskChat__back" type="button" aria-label="Back"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>'
          +'<div id="vrDeskChat__info"><div id="vrDeskChat__name">—</div><div id="vrDeskChat__sub">'+(currentLang==='es'?'En línea':'Online')+'</div></div>'
          +'<div id="vrDeskChat__avatar">👤</div>'
        +'</div>'
        +'<div id="vrDeskChat__body"><div class="vrDc__empty">'+(currentLang==='es'?'Sin mensajes aún. Escribe algo para empezar.':'No messages yet. Say hello to start.')+'</div></div>'
        +'<form id="vrDeskChat__form" autocomplete="off">'
          +'<input id="vrDeskChat__input" type="text" placeholder="'+(currentLang==='es'?'Escribe un mensaje…':'Type a message…')+'" maxlength="500">'
          +'<button id="vrDeskChat__send" type="submit" aria-label="Send"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg></button>'
        +'</form>'
      +'</div>';
      document.body.appendChild(chatEl);
      bodyEl=chatEl.querySelector('#vrDeskChat__body');
      inputEl=chatEl.querySelector('#vrDeskChat__input');
      sendBtn=chatEl.querySelector('#vrDeskChat__send');
      nameEl=chatEl.querySelector('#vrDeskChat__name');
      avatarEl=chatEl.querySelector('#vrDeskChat__avatar');
      backBtn=chatEl.querySelector('#vrDeskChat__back');
      backBtn.addEventListener('click',closeChat);
      chatEl.addEventListener('click',function(e){if(e.target===chatEl)closeChat();});
      chatEl.querySelector('#vrDeskChat__form').addEventListener('submit',function(e){e.preventDefault();sendMessage();});
    }

    function renderMessages(msgs){
      if(!bodyEl)return;
      if(!msgs||!msgs.length){
        if(!bodyEl.querySelector('.vrDc__bubble')) bodyEl.innerHTML='<div class="vrDc__empty">'+(currentLang==='es'?'Sin mensajes aún. Escribe algo para empezar.':'No messages yet. Say hello to start.')+'</div>';
        return;
      }
      var empty=bodyEl.querySelector('.vrDc__empty');if(empty)empty.remove();
      msgs.forEach(function(m){
        var id=m.id||m.message_id;if(!id||id<=lastMsgId)return;
        lastMsgId=Math.max(lastMsgId,id);
        var isMe=m.from==='rider'||m.sender==='rider'||m.is_rider===true;
        var div=document.createElement('div');
        div.className='vrDc__bubble '+(isMe?'vrDc__bubble--me':'vrDc__bubble--dr');
        div.textContent=m.text||m.message||'';
        bodyEl.appendChild(div);
      });
      bodyEl.scrollTop=bodyEl.scrollHeight;
    }

    function poll(){
      if(!bookingId||!webKey)return;
      fetch(apiBase+'/bookings/web/'+bookingId+'/chat',{headers:{'Authorization':'Bearer '+webKey}})
        .then(function(r){if(!r.ok)throw 0;return r.json();})
        .then(function(d){if(d&&Array.isArray(d.messages))renderMessages(d.messages);else if(Array.isArray(d))renderMessages(d);})
        .catch(function(){});
    }

    function sendMessage(){
      if(sending||!inputEl||!bookingId||!webKey)return;
      var text=(inputEl.value||'').trim();
      if(!text)return;
      sending=true;sendBtn.disabled=true;
      /* Optimistic: show immediately */
      var empty=bodyEl.querySelector('.vrDc__empty');if(empty)empty.remove();
      var b=document.createElement('div');b.className='vrDc__bubble vrDc__bubble--me';b.textContent=text;b.style.opacity='.6';bodyEl.appendChild(b);bodyEl.scrollTop=bodyEl.scrollHeight;
      inputEl.value='';
      fetch(apiBase+'/bookings/web/'+bookingId+'/chat',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+webKey},body:JSON.stringify({message:text})})
        .then(function(r){if(!r.ok)throw 0;return r.json();})
        .then(function(){b.style.opacity='1';setTimeout(poll,400);})
        .catch(function(){b.style.opacity='.4';b.style.borderColor='rgba(255,90,90,.4)';b.title='Failed — tap to retry';})
        .finally(function(){sending=false;sendBtn.disabled=false;inputEl.focus();});
    }

    function openChat(){
      buildChat();
      /* Pull driver data from live tracker DOM */
      var lt=document.querySelector('[data-vr-livetracker]');
      if(lt){
        var n=lt.querySelector('[data-vrlt-chat-name]')||lt.querySelector('[data-vrlt-driver-name]');
        if(n&&n.textContent)driverName=n.textContent.trim()||driverName;
        var av=lt.querySelector('[data-vrlt-chat-avatar] img')||lt.querySelector('[data-vrlt-driver-photo] img');
        if(av&&av.src)driverAvatar=av.src;
      }
      if(nameEl)nameEl.textContent=driverName;
      if(avatarEl){avatarEl.innerHTML=driverAvatar?'<img src="'+driverAvatar+'" alt="">':'👤';}
      bookingId=window.__vrActiveBookingId||null;
      /* Read webKey from the global set by core */
      webKey=window.__vrWebKey||webKey;
      chatEl.removeAttribute('hidden');
      document.body.style.overflow='hidden';
      setTimeout(function(){try{inputEl.focus();}catch(_){}},200);
      lastMsgId=0;bodyEl.innerHTML='<div class="vrDc__empty">'+(currentLang==='es'?'Cargando…':'Loading…')+'</div>';
      poll();
      if(pollIv)clearInterval(pollIv);
      pollIv=setInterval(poll,3500);
    }

    function closeChat(){
      if(pollIv){clearInterval(pollIv);pollIv=null;}
      if(chatEl){chatEl.setAttribute('hidden','');}
      document.body.style.overflow='';
    }

    /* Intercept the original "Chat" button click to open our desktop chat instead */
    function interceptChatBtn(){
      document.addEventListener('click',function(e){
        if(window.innerWidth<900)return;
        var btn=e.target.closest('[data-vrlt-act-msg]');
        if(!btn)return;
        e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();
        openChat();
      },true);
    }
    interceptChatBtn();
  })();
})();
</script>
