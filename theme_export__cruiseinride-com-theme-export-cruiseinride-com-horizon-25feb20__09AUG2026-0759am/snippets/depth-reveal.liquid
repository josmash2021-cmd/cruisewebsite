{% comment %}
  Apple-style depth reveal — bidirectional.
  Content animates IN when entering viewport, and animates OUT when leaving.
  Vertical scroll stays natural. Apple ease curves throughout.
{% endcomment %}

<style>
  :root{
    --apple-ease: cubic-bezier(.16,1,.3,1);
    --apple-ease-out: cubic-bezier(.22,1,.36,1);
  }

  /* ── Base: sections start hidden ─────────────────────────────────── */
  [data-reveal]{
    opacity:0;
    transform:translate3d(0,80px,0);
    transition:opacity 1000ms var(--apple-ease),
               transform 1200ms var(--apple-ease);
    will-change:opacity,transform;
  }
  [data-reveal].is-revealed{
    opacity:1;
    transform:translate3d(0,0,0);
  }
  /* Exit state — when scrolled past or out of viewport from top */
  [data-reveal].is-leaving{
    opacity:0;
    transform:translate3d(0,-60px,0);
  }

  [data-reveal-soft]{
    opacity:0;
    transform:translate3d(0,40px,0);
    transition:opacity 900ms var(--apple-ease),
               transform 1100ms var(--apple-ease);
    will-change:opacity,transform;
  }
  [data-reveal-soft].is-revealed{
    opacity:1;
    transform:translate3d(0,0,0);
  }
  [data-reveal-soft].is-leaving{
    opacity:0;
    transform:translate3d(0,-40px,0);
  }

  /* ── Inner parallax layers ───────────────────────────────────────── */
  [data-reveal-layer]{
    opacity:0;
    transform:translate3d(0,40px,0);
    transition:opacity 900ms var(--apple-ease),
               transform 1100ms var(--apple-ease);
    will-change:opacity,transform;
  }
  [data-reveal-layer][data-reveal-depth="1"]{transform:translate3d(0,56px,0);}
  [data-reveal-layer][data-reveal-depth="2"]{transform:translate3d(0,72px,0);}
  [data-reveal-layer][data-reveal-depth="3"]{transform:translate3d(0,88px,0);}
  [data-reveal].is-revealed [data-reveal-layer],
  [data-reveal-soft].is-revealed [data-reveal-layer]{
    opacity:1;
    transform:translate3d(0,0,0);
  }
  [data-reveal].is-leaving [data-reveal-layer],
  [data-reveal-soft].is-leaving [data-reveal-layer]{
    opacity:0;
    transform:translate3d(0,-30px,0);
  }
  [data-reveal].is-revealed [data-reveal-layer][data-reveal-delay="1"]{transition-delay:100ms;}
  [data-reveal].is-revealed [data-reveal-layer][data-reveal-delay="2"]{transition-delay:220ms;}
  [data-reveal].is-revealed [data-reveal-layer][data-reveal-delay="3"]{transition-delay:340ms;}
  [data-reveal].is-revealed [data-reveal-layer][data-reveal-delay="4"]{transition-delay:460ms;}

  html{scroll-behavior:smooth;}

  @media (prefers-reduced-motion:reduce){
    [data-reveal],[data-reveal-soft],[data-reveal-layer]{
      opacity:1!important;
      transform:none!important;
      transition:none!important;
    }
    html{scroll-behavior:auto;}
  }
</style>

<script>
(function(){
  if(window.__crDepthReveal)return; window.__crDepthReveal=1;
  if(!('IntersectionObserver' in window))return;

  /* Always animate — prefers-reduced-motion ignored */
  var prm=false;
  if(prm){
    document.querySelectorAll('[data-reveal],[data-reveal-soft]').forEach(function(el){el.classList.add('is-revealed');});
    return;
  }

  /* Bidirectional observer:
     - When element enters viewport (>= 20% visible): is-revealed
     - When element leaves viewport (< 5% visible): is-leaving
     - Between those states, keeps current class
  */
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      var el=e.target;
      var ratio=e.intersectionRatio;
      if(ratio>=0.2){
        el.classList.add('is-revealed');
        el.classList.remove('is-leaving');
      } else if(ratio<0.05 && el.classList.contains('is-revealed')){
        el.classList.remove('is-revealed');
        el.classList.add('is-leaving');
      }
    });
  },{threshold:[0,0.05,0.2,0.5,0.8,1]});

  function scan(){
    document.querySelectorAll('[data-reveal]:not([data-reveal-observed]),[data-reveal-soft]:not([data-reveal-observed])').forEach(function(el){
      el.setAttribute('data-reveal-observed','1');
      io.observe(el);
    });
  }

  function isHome(){
    var p=location.pathname;
    return p==='/'||p==='/es/'||p==='/en/'||/^\/(es|en)\/?$/.test(p);
  }
  function isHeavyPage(){
    /* Skip auto-apply on pages that already have their own heavy animations/flows */
    return /\/products\/vip-service|\/products\/vip-ride-for-events/.test(location.pathname);
  }

  function autoApplyHome(){
    if(!isHome())return;
    var sections=document.querySelectorAll('main > .shopify-section, #MainContent > .shopify-section');
    if(!sections.length) sections=document.querySelectorAll('.shopify-section');
    sections.forEach(function(sec,idx){
      if(sec.hasAttribute('data-reveal')||sec.hasAttribute('data-reveal-soft'))return;
      if(sec.querySelector('[data-reveal],[data-reveal-soft]'))return;
      if(/header|footer|announcement/i.test(sec.id||''))return;
      if(idx===0){sec.setAttribute('data-reveal-soft','');}
      else{sec.setAttribute('data-reveal','');}

      var headings=sec.querySelectorAll('h1,h2,h3');
      var paras=sec.querySelectorAll('p');
      var ctas=sec.querySelectorAll('a.button, a.btn, .lux-cta, button.button, a[class*="Btn"], a[class*="cta"]');
      headings.forEach(function(el,i){
        if(!el.hasAttribute('data-reveal-layer')){
          el.setAttribute('data-reveal-layer','');
          el.setAttribute('data-reveal-depth','1');
          el.setAttribute('data-reveal-delay', String(Math.min(i+1,2)));
        }
      });
      paras.forEach(function(el,i){
        if(!el.hasAttribute('data-reveal-layer') && i<3){
          el.setAttribute('data-reveal-layer','');
          el.setAttribute('data-reveal-depth','2');
          el.setAttribute('data-reveal-delay','3');
        }
      });
      ctas.forEach(function(el){
        if(!el.hasAttribute('data-reveal-layer')){
          el.setAttribute('data-reveal-layer','');
          el.setAttribute('data-reveal-depth','3');
          el.setAttribute('data-reveal-delay','4');
        }
      });
    });
  }

  function init(){
    if(isHeavyPage())return;
    autoApplyHome();
    scan();
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init);
  else init();

  if(!isHeavyPage()){
    var mo=new MutationObserver(function(){scan();});
    mo.observe(document.body,{childList:true,subtree:true});
  }
})();
</script>
