        if(bar2)bar2.style.width='100%';
        _postBookingToCruise(null,function(data){
          if(data&&data.booking_id){window.__vrActiveBookingId=data.booking_id;try{var _schedAt=(window.__vrScheduleActive&&dateEl&&timeEl&&dateEl.value&&timeEl.value)?new Date(dateEl.value+'T'+timeEl.value).toISOString():null;localStorage.setItem('vr_active_booking',JSON.stringify({id:data.booking_id,ts:Date.now(),scheduled_at:_schedAt,pickup:pickupEl?pickupEl.value.trim():'',dropoff:dropoffEl?dropoffEl.value.trim():'',vehicle:selectedRide&&selectedRide.title||'',tier:selectedRide&&selectedRide.tier||''}));}catch(_){}}
          try{if(selectedRide&&selectedRide.tier==='vip')_vrCreateVipMenuReservation(data);}catch(_){}
          if(window.__vrScheduleActive){
            /* Email 1: scheduled ride confirmation (to rider) */
            try{_vrSendSchedConfirm(data);}catch(_){}
            /* Ensure localStorage has scheduled_at */
            try{
              var _sAtNow=(dateEl&&timeEl&&dateEl.value&&timeEl.value)?new Date(dateEl.value+'T'+timeEl.value).toISOString():null;
              var _bid=(data&&data.booking_id)||window.__vrActiveBookingId||'TEMP-'+Date.now();
              var _lsData={id:_bid,ts:Date.now(),scheduled_at:_sAtNow,pickup:pickupEl?pickupEl.value.trim():'',dropoff:dropoffEl?dropoffEl.value.trim():'',vehicle:selectedRide&&selectedRide.title||'',tier:selectedRide&&selectedRide.tier||''};
              localStorage.setItem('vr_active_booking',JSON.stringify(_lsData));
              window.__vrActiveBookingId=_bid;
            }catch(_){}
            /* Skip the mobile-style confirm overlay — go directly to new card with smooth transition */
            try{_closeTestConfirm(overlay);}catch(_){}
            try{if(window.__vrReserveIv){clearInterval(window.__vrReserveIv);window.__vrReserveIv=null;}}catch(_){}
            setTimeout(function(){
              try{
                var savedRaw=localStorage.getItem('vr_active_booking');
                var saved=savedRaw?JSON.parse(savedRaw):null;
                if(saved&&saved.scheduled_at&&window.__vrSchedShow){
                  window.__vrSchedShow(saved,data||{},_apiBase,_webKey);
                }
              }catch(e){console.warn('[Sched open failed]',e);}
            },250);
            return;
          }
          if(data&&data.booking_id){_pollForDriver(data.booking_id,overlay);}
          else if(data&&(data.status==='accepted'||data.driver_name))_showDriverFound(overlay,data);
        },function(e){
          console.warn('[Cruise Booking]',e);
          if(window.__vrScheduleActive){_showReserveOk(overlay);return;}
          try{_closeTestConfirm(overlay);}catch(_){}
          /* Only show "payment received but booking failed" overlay when there WAS a payment.
             Test mode and cash flows have no PaymentIntent — show a simple toast instead. */
          var _hadPayment=(e&&e.payment_intent_id)||(_selectedPayment!=='test_mode'&&_selectedPayment!=='cash');
          if(_hadPayment){
            try{_showBookingAfterPaymentError(e);}catch(_){_vrToast((e&&e.message)||'Booking error','err');}
          } else {
            _vrToast((e&&e.message)||'Booking error — please try again','err');
          }
        });
      });
      overlay.querySelectorAll('[data-vipride-test-cancel],[data-vipride-test-cancel2]').forEach(function(btn){btn.addEventListener('click',function(){if(window.__vrCancelBooking&&window.__vrCancelBooking(_apiBase,_webKey))_vrToast(t('rideCancelled'),'ok');_closeTestConfirm(overlay);},{once:true});});
    }
    function _closeTestConfirm(overlay){
      if(!overlay) overlay=root.querySelector('[data-vipride-test-confirm]');
      if(!overlay) return;
      try{if(window._vrActivePoll){clearInterval(window._vrActivePoll);window._vrActivePoll=null;}if(window.__vrReserveIv){clearInterval(window.__vrReserveIv);window.__vrReserveIv=null;}if(window.__vrMsgIv){clearInterval(window.__vrMsgIv);window.__vrMsgIv=null;}root.classList.remove('is-searching');}catch(_){}
      var w=window;w.__vrAptActive=false;w.__vrAptSurchargeCents=0;w.__vrScheduleActive=false;w.__vrAptCode=w.__vrAptTerminal=w.__vrAptAirline=w.__vrAptDoor=w.__vrAptFlight=null;
      overlay.querySelectorAll('[data-vipride-test-stars],[data-vipride-test-stars2],[data-vipride-test-stars3]').forEach(function(el){el.innerHTML='';});
      overlay.style.opacity='0';overlay.style.transition='opacity 380ms ease';
      setTimeout(function(){_vrFullReset(overlay);},400);
    }
    function _vrFullReset(overlay){
      if(!overlay)overlay=root.querySelector('[data-vipride-test-confirm]');
      if(overlay){
        overlay.setAttribute('hidden','');
        overlay.style.opacity='';overlay.style.transition='';
        overlay.querySelectorAll('.vipRide__testConfirm__phase1,.vipRide__testConfirm__phase2,.vipRide__driverFound').forEach(function(p){p.classList.remove('is-visible','is-hiding');p.style.display='';});
        overlay.querySelectorAll('[data-vipride-test-bar],[data-vipride-test-bar2],[data-vipride-test-bar3],[data-vipride-test-bar-driver]').forEach(function(b){b.style.width='0%';});
      }
      _vrSheetReset();
      var _mb=root.querySelector('[data-vipride-map-back]');if(_mb)_mb.hidden=true;
      selectedRide=null;_selectedPayment=null;currentMode='ride';
      if(dropoffEl)dropoffEl.value='';
      if(dropoffMarker){try{dropoffMarker.remove();}catch(_){}dropoffMarker=null;}
      dropoffPlace=null;
      try{if(map&&map.getLayer){_rtLayers.forEach(function(id){if(map.getLayer(id))map.removeLayer(id);});if(map.getSource('route'))map.removeSource('route');}}catch(_){}
      routeDurationSec=null;
      try{cards.forEach(function(c){c.classList.remove('is-active','is-hidden');});_cardsCollapsed=false;}catch(_){}
      if(_actionBtns)_actionBtns.setAttribute('hidden','');
      var payBtnLbl=root.querySelector('.vipRide__payBtnLabel');
      if(payBtnLbl)payBtnLbl.textContent=t('paymentMethod');
      root.querySelectorAll('[data-vipride-pay-option]').forEach(function(o){o.classList.remove('is-active');});
      if(_requestBtn){_requestBtn.disabled=true;_requestBtn.textContent=t('requestRide');}
      try{validateCTA(null);}catch(_){}
      try{compactPills.forEach(function(b){b.classList.toggle('is-active',b.getAttribute('data-compact-mode')==='now');});if(segEl)segEl.classList.remove('is-later');}catch(_){}
      window.__vrAptActive=false;window.__vrAptSurchargeCents=0;
      try{_schedDate=null;}catch(_){}
      if(dateEl)dateEl.value='';
      if(timeEl)timeEl.value='';
      try{goToStep(1,'back');}catch(_){}
      if(pickupPlace&&pickupEl&&/^\w{3} — /.test(pickupEl.value||'')){
        if(pickupMarker){try{pickupMarker.remove();}catch(_){}pickupMarker=null;}
        pickupPlace=null;pickupEl.value='';_pickupManuallySet=false;_gpsActive=false;
      }
      setTimeout(function(){
        try{
          var tgt=pickupPlace?[pickupPlace.lng,pickupPlace.lat]:(_lastGeoLng!==null?[_lastGeoLng,_lastGeoLat]:null);
          if(tgt&&map) map.flyTo({center:tgt,zoom:16.5,pitch:50,bearing:-10,duration:1200,essential:true,curve:1.2,easing:function(t){return t<0.5?2*t*t:1-Math.pow(-2*t+2,2)/2;}});
          if(!pickupPlace){var _lb=root.querySelector('[data-vipride-locate-btn]')||root.querySelector('.vipRide__locateBtn');if(_lb)_lb.click();}
        }catch(_){}
      },300);
      if(typeof _vrTrack==='function')_vrTrack('booking_cancelled');
    }
    if(_requestBtn){
      _requestBtn.addEventListener('click', function(){
        if(!selectedRide || !_selectedPayment) return;
        if(_payBusy || _requestBtn.disabled) return;
        _vrTrack('request_ride_clicked',{vehicle:selectedRide.title,payment:_selectedPayment,amount_cents:selectedRide.priceCents});
        function _proceed(){
          if(_selectedPayment==='cash'){doCheckout(_requestBtn);return;}
          if(_selectedPayment==='test_mode'){_showTestConfirm();return;}
          if((_selectedPayment==='apple_pay'||_selectedPayment==='google_pay') && _stripe){
            _payWithNativeSheet();
          } else {
            _payWithCheckout();
          }
        }
        var isAuthed=!!(typeof __vipAuthToken==='function'?__vipAuthToken():_vrLS.get('vr_at'));
        if(_selectedPayment==='cash'&&!isAuthed){_vrToast('Sign in required for Cash','err');if(typeof __vipShowGate==='function')_showAuthGate();return;}
        if(isAuthed){_proceed();return;}
        if(typeof window.__vrGuestCollect==='function'){
          window.__vrGuestCollect(function(info){if(info&&info.first_name&&info.last_name&&info.email)_proceed();else _vrToast(t('provideEmailPhone')||'Please provide your info','err');});
          return;
        }
        _vrToast('Please sign in or provide guest info','err');
        if(typeof __vipShowGate==='function'){_vrTrack('auth_required');_showAuthGate();}
      });
    }
    _vrGuest=false;
    _vrLS.del('vr_guest');
    window.__vipAuth={apiBase:_apiBase,webKey:_webKey,root:root,step1NextBtn:step1NextBtn};
    var _vrPostAuth=null;
    var _gb=document.querySelector('[data-vipride-auth-guest]');
    if(_gb) _gb.addEventListener('click',function(e){
      e.preventDefault();e.stopPropagation();
      _vrGuest=true;
      var g=document.querySelector('[data-vipride-auth-gate]');
      if(g){g.removeAttribute('data-visible');setTimeout(function(){g.setAttribute('hidden','');},360);}
      _vrTrack('guest_continue');
      if(_vrPostAuth==='pay'){_vrPostAuth=null;setTimeout(_openPayOverlay,400);}
    });
    document.addEventListener('click',function(e){
      var gate=document.querySelector('[data-vipride-auth-gate][data-visible]');
      if(!gate)return;
      var el=e.target.closest('a[href*="/account"],a[href*="/login"],a[href="/cart"],[aria-label*="account" i],[aria-label*="sign in" i],[aria-label*="cart" i]');
      if(!el||el.closest('.vipRide'))return;
      e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();
      location.href='/cart';
    },true);
    window.__vipAuthGoogleId='{{ section.settings.google_client_id | default: "" | escape }}';
    window.__vipAuthAppleId='{{ section.settings.apple_client_id | default: "" | escape }}';
    if(window.__vrInitAuth)window.__vrInitAuth(_apiBase,_webKey);
    (function(){
      var g=document.querySelector('[data-vipride-auth-gate]');
      if(!g)return;
      g.addEventListener('click',function(e){
        if(e.target===g||!e.target.closest('.vipRide__authGate__card')){
          e.stopImmediatePropagation();e.preventDefault();return false;
        }
      },true);
      g.addEventListener('touchstart',function(e){
        if(e.target===g||!e.target.closest('.vipRide__authGate__card')){
          e.stopImmediatePropagation();e.preventDefault();return false;
        }
      },true);
    })();
    (function(){
      var DARK='#0a0d14';
      var origThemeColor=null;
      function setMeta(c){
        var m=document.querySelector('meta[name="theme-color"]');
        if(m){if(origThemeColor===null)origThemeColor=m.getAttribute('content')||'';m.setAttribute('content',c);}
        else{var n=document.createElement('meta');n.name='theme-color';n.content=c;document.head.appendChild(n);}
      }
      function restoreMeta(){
        var m=document.querySelector('meta[name="theme-color"]');
        if(m&&origThemeColor!==null)m.setAttribute('content',origThemeColor);
      }
      function anyOpen(){
        var g=document.querySelector('[data-vipride-auth-gate]');
        if(g&&!g.hidden&&g.hasAttribute('data-visible'))return true;
        var pgs=document.querySelectorAll('.vipRide__authPage');
        for(var i=0;i<pgs.length;i++){if(!pgs[i].hidden&&pgs[i].hasAttribute('data-visible'))return true;}
        return false;
      }
      function update(){
        if(anyOpen()){
          document.documentElement.classList.add('vipride-auth-open');
          document.body.classList.add('vipride-auth-open');
          setMeta(DARK);
        } else {
          document.documentElement.classList.remove('vipride-auth-open');
          document.body.classList.remove('vipride-auth-open');
          restoreMeta();
        }
      }
      var targets=[].slice.call(document.querySelectorAll('[data-vipride-auth-gate],.vipRide__authPage'));
      var mo=new MutationObserver(update);
      targets.forEach(function(t){mo.observe(t,{attributes:true,attributeFilter:['hidden','data-visible']});});
      update();
    })();
  })();
})();
</script>
