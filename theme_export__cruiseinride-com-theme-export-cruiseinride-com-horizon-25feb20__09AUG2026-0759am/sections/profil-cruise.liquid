{% comment %}
  Cruise Auth — standalone sign up / sign in / profile section.
  Handles the entire flow in one page:
   - Not logged in → Sign up & get 20% off gate
   - Sign up flow (email/phone/google/apple)
   - Sign in flow
   - Logged in → full profile (avatar, rating, history, edit, sign out)
  Cache-bust: 20260419-v5
{% endcomment %}

<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

{%- liquid
  assign ca_bg_image = ''
  if section.settings.background_image != blank
    assign ca_bg_image = section.settings.background_image | image_url: width: 1600
  endif
  assign ca_logo_url = ''
  if section.settings.logo_image != blank
    assign ca_logo_url = section.settings.logo_image | image_url: width: 240
  endif
  assign ca_has_video = false
  if section.settings.background_video != blank or section.settings.background_video_url != blank
    assign ca_has_video = true
  endif
  assign ca_preload_src = ''
  if section.settings.background_video != blank
    assign ca_preload_source = section.settings.background_video.sources | where: 'format', 'mp4' | first
    if ca_preload_source
      assign ca_preload_src = ca_preload_source.url
    endif
  elsif section.settings.background_video_url != blank
    assign ca_preload_src = section.settings.background_video_url
  endif
-%}

{%- if ca_preload_src != blank -%}
  <link rel="preload" as="video" href="{{ ca_preload_src }}" crossorigin="anonymous">
{%- endif -%}
{%- if ca_bg_image != blank -%}
  <link rel="preload" as="image" href="{{ ca_bg_image }}">
{%- endif -%}

<div
  class="cruise-auth"
  id="cruise-auth-{{ section.id }}"
  data-api-base="{{ section.settings.api_base }}"
  data-web-key="{{ section.settings.web_key }}"
  data-api-key="{{ section.settings.api_key }}"
  data-google-id="{{ section.settings.google_client_id }}"
  data-apple-id="{{ section.settings.apple_client_id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %};
    {%- if section.settings.background_color != blank -%}--ca-bg:{{ section.settings.background_color }};{%- endif -%}
    {%- if ca_bg_image != blank and ca_has_video == false -%}background-image:url('{{ ca_bg_image }}');background-size:cover;background-position:center;background-attachment:fixed;{%- endif -%}
  "
>
  {%- if ca_has_video -%}
    <div class="cruise-auth__bg-video-wrap" aria-hidden="true">
      {%- if section.settings.background_video != blank -%}
        <video
          class="cruise-auth__bg-video"
          id="cruise-auth-video-{{ section.id }}"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          disablepictureinpicture
          disableremoteplayback
          fetchpriority="high"
          {% if ca_bg_image != blank %}poster="{{ ca_bg_image }}"{% endif %}
        >
          {%- for source in section.settings.background_video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- else -%}
        <video class="cruise-auth__bg-video" id="cruise-auth-video-{{ section.id }}" autoplay muted loop playsinline preload="auto" disablepictureinpicture disableremoteplayback fetchpriority="high"{% if ca_bg_image != blank %} poster="{{ ca_bg_image }}"{% endif %}>
          <source src="{{ section.settings.background_video_url }}" type="video/mp4">
        </video>
      {%- endif -%}
    </div>
    <script>
      /* Kick video playback as early as possible — before the card animates in.
         Runs synchronously at parse time so autoplay starts the moment the <video>
         element exists in the DOM. */
      (function(){
        try{
          var v=document.getElementById('cruise-auth-video-{{ section.id }}');
          if(!v) return;
          v.muted=true;
          v.defaultMuted=true;
          var p=v.play();
          if(p&&typeof p.catch==='function') p.catch(function(){
            var _retry=function(){v.play().catch(function(){});};
            document.addEventListener('touchstart',_retry,{once:true,passive:true});
            document.addEventListener('click',_retry,{once:true});
          });
        }catch(_){}
      })();
    </script>
  {%- endif -%}
  {%- if ca_bg_image != blank or ca_has_video -%}
    <div class="cruise-auth__bg-overlay"></div>
  {%- endif -%}

  <div class="cruise-auth__inner">

    <!-- ═══════════════════════════════════ GATE (not logged in) ═══════════════════════════════════ -->
    <section class="cruise-auth__screen cruise-auth__gate is-active" data-ca-screen="gate">
      <div class="cruise-auth__card">
        <div class="cruise-auth__badge">
          <span>{{ section.settings.promo_badge | default: 'Limited offer' }}</span>
        </div>
        <div class="cruise-auth__logo">
          {%- if ca_logo_url != blank -%}
            <img src="{{ ca_logo_url }}" alt="Cruise">
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
          {%- endif -%}
        </div>
        <div class="cruise-auth__brand">CRUISE</div>
        <h1 class="cruise-auth__title">{{ section.settings.gate_title | default: 'Sign up & get 20% off today!' }}</h1>
        <p class="cruise-auth__sub">{{ section.settings.gate_sub | default: 'Create an account to save your trips, track rides in real-time, and unlock your 20% first-ride discount.' }}</p>
        <div class="cruise-auth__actions">
          <button type="button" class="cruise-auth__btn cruise-auth__btn--primary" data-ca-goto="signup">
            {{ section.settings.gate_btn_signup | default: 'Sign up · Save 20%' }}
          </button>
          <button type="button" class="cruise-auth__btn cruise-auth__btn--ghost" data-ca-goto="signin">
            {{ section.settings.gate_btn_signin | default: 'I already have an account' }}
          </button>
        </div>
        <div class="cruise-auth__perks">
          <div class="cruise-auth__perk"><span>✓</span> Save trip history</div>
          <div class="cruise-auth__perk"><span>✓</span> Faster checkout</div>
          <div class="cruise-auth__perk"><span>✓</span> Exclusive offers</div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════ CREATE ACCOUNT (wizard) ═══════════════════════════════════ -->
    <section class="cruise-auth__screen cruise-auth__form-screen" data-ca-screen="signup">
      <div class="cruise-auth__form-card">
        <button type="button" class="cruise-auth__back" data-ca-wiz-back aria-label="Back">
          <svg width="16" height="12" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 7H1M7 1L1 7l6 6"/></svg>
        </button>
        <div class="cruise-auth__wiz-content" data-ca-wiz-content></div>
      </div>
    </section>

    <!-- ═══════════════════════════════════ SIGN IN ═══════════════════════════════════ -->
    <section class="cruise-auth__screen cruise-auth__form-screen" data-ca-screen="signin">
      <div class="cruise-auth__form-card">
        <button type="button" class="cruise-auth__back" data-ca-goto="gate" aria-label="Back">
          <svg width="16" height="12" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 7H1M7 1L1 7l6 6"/></svg>
        </button>
        <h1 class="cruise-auth__heading">Sign in</h1>
        <p class="cruise-auth__heading-sub">Welcome back! Enter your credentials.</p>

        <div class="cruise-auth__input">
          <svg class="cruise-auth__input-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          <input type="text" data-ca-signin-id placeholder="Email or phone number" autocomplete="username">
        </div>
        <div class="cruise-auth__input">
          <svg class="cruise-auth__input-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          <input type="password" data-ca-signin-pass placeholder="Password" autocomplete="current-password">
        </div>
        <div class="cruise-auth__err" data-ca-signin-err></div>
        <button type="button" class="cruise-auth__btn cruise-auth__btn--primary" data-ca-signin-submit>Sign In</button>

        <div class="cruise-auth__divider"><span>OR</span></div>

        <button type="button" class="cruise-auth__btn cruise-auth__btn--dark" data-ca-signin-google>
          <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0012 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A11 11 0 001 12c0 1.77.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
          Continue with Google
        </button>
        <button type="button" class="cruise-auth__btn cruise-auth__btn--dark" data-ca-signin-apple>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          Continue with Apple
        </button>

        <div class="cruise-auth__divider"><span>OR</span></div>

        <button type="button" class="cruise-auth__btn cruise-auth__btn--outline" data-ca-goto="signup">Create Account</button>
      </div>
    </section>

    <!-- ═══════════════════════════════════ PROFILE (logged in) ═══════════════════════════════════ -->
    <section class="cruise-auth__screen cruise-auth__profile" data-ca-screen="profile">
      <header class="cruise-auth__profile-header">
        <button type="button" class="cruise-auth__back cruise-auth__back--sub" data-ca-profile-back aria-label="Back">
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 7H1M7 1L1 7l6 6"/></svg>
        </button>
        <h1 class="cruise-auth__profile-title" data-ca-profile-title>Profile</h1>
        <button type="button" class="cruise-auth__edit-btn" data-ca-edit-btn>Edit</button>
      </header>

      <div class="cruise-auth__sub-screen is-active" data-ca-sub="home">
        <div class="cruise-auth__sub-card">
        <div class="cruise-auth__hero">
          <button type="button" class="cruise-auth__avatar" data-ca-avatar aria-label="Change photo">
            <span class="cruise-auth__avatar-initial" data-ca-initial>C</span>
            <img class="cruise-auth__avatar-img" data-ca-photo alt="" hidden>
            <span class="cruise-auth__avatar-edit">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </span>
          </button>
          <input type="file" accept="image/*" data-ca-photo-input hidden>
          <h2 class="cruise-auth__name" data-ca-name>—</h2>
          <div class="cruise-auth__rating">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#E8C547"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span data-ca-rating-text>New rider</span>
          </div>
          <div class="cruise-auth__member" data-ca-member></div>
        </div>

        <div class="cruise-auth__stats">
          <div class="cruise-auth__stat"><div class="cruise-auth__stat-val" data-ca-stat-trips>0</div><div class="cruise-auth__stat-lbl">Total trips</div></div>
          <div class="cruise-auth__stat"><div class="cruise-auth__stat-val" data-ca-stat-miles>0</div><div class="cruise-auth__stat-lbl">Miles</div></div>
          <div class="cruise-auth__stat"><div class="cruise-auth__stat-val" data-ca-stat-since>—</div><div class="cruise-auth__stat-lbl">Member for</div></div>
        </div>

        <div class="cruise-auth__rows">
          <button type="button" class="cruise-auth__row" data-ca-sub-nav="trips">
            <span class="cruise-auth__row-ico">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
            </span>
            <span class="cruise-auth__row-text"><b>Trip History</b><small>All your past trips</small></span>
            <span class="cruise-auth__row-chev">›</span>
          </button>
          <button type="button" class="cruise-auth__row" data-ca-sub-nav="scheduled">
            <span class="cruise-auth__row-ico">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            </span>
            <span class="cruise-auth__row-text"><b>Scheduled Rides</b><small>Upcoming reservations</small></span>
            <span class="cruise-auth__row-chev">›</span>
          </button>
          <button type="button" class="cruise-auth__row" data-ca-sub-nav="payments">
            <span class="cruise-auth__row-ico">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            </span>
            <span class="cruise-auth__row-text"><b>Payment Methods</b><small>Cards and wallets</small></span>
            <span class="cruise-auth__row-chev">›</span>
          </button>
        </div>

        <button type="button" class="cruise-auth__signout" data-ca-signout>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
          <span>Sign out</span>
        </button>
        <div class="cruise-auth__version">Cruise · v1.0.2</div>
        </div>
      </div>

      <div class="cruise-auth__sub-screen" data-ca-sub="edit">
        <div class="cruise-auth__sub-card">
          <h2 class="cruise-auth__sub-title">Edit Profile</h2>
          <form class="cruise-auth__edit-form" data-ca-edit-form>
            <label class="cruise-auth__field"><span>First name</span><input type="text" data-ca-edit-first disabled style="opacity:.5;cursor:not-allowed;"></label>
            <label class="cruise-auth__field"><span>Last name</span><input type="text" data-ca-edit-last disabled style="opacity:.5;cursor:not-allowed;"></label>
            <label class="cruise-auth__field"><span>Email</span><input type="email" data-ca-edit-email></label>
            <label class="cruise-auth__field"><span>Phone</span><input type="tel" data-ca-edit-phone></label>
            <div class="cruise-auth__edit-actions">
              <button type="button" class="cruise-auth__btn cruise-auth__btn--outline" data-ca-edit-cancel>Cancel</button>
              <button type="submit" class="cruise-auth__btn cruise-auth__btn--primary">Save</button>
            </div>
          </form>
        </div>
      </div>

      <div class="cruise-auth__sub-screen" data-ca-sub="trips">
        <div class="cruise-auth__sub-card">
          <h2 class="cruise-auth__sub-title">Trip History</h2>
          <div class="cruise-auth__list" data-ca-trips-list><div class="cruise-auth__empty">Loading…</div></div>
        </div>
      </div>
      <div class="cruise-auth__sub-screen" data-ca-sub="scheduled">
        <div class="cruise-auth__sub-card">
          <h2 class="cruise-auth__sub-title">Scheduled Rides</h2>
          <div class="cruise-auth__list" data-ca-scheduled-list><div class="cruise-auth__empty">Loading…</div></div>
        </div>
      </div>
      <div class="cruise-auth__sub-screen" data-ca-sub="payments">
        <div class="cruise-auth__sub-card">
          <h2 class="cruise-auth__sub-title">Payment Methods</h2>
          <div class="cruise-auth__list" data-ca-payments-list><div class="cruise-auth__empty">Loading…</div></div>
        </div>
      </div>
    </section>

    <div class="cruise-auth__toast" data-ca-toast></div>
  </div>
</div>

<script>
/* ═══ FALLBACK DELEGATION — garantiza que clicks básicos funcionen aunque el script principal falle ═══ */
(function(){
  document.addEventListener('click',function(ev){
    var el=ev.target.closest&&ev.target.closest('[data-ca-goto],[data-ca-profile-back],[data-ca-wiz-back]');
    if(!el) return;
    /* Si el listener principal ya manejó el click, no duplicar (no hay forma directa, pero al menos cubrimos back y goto) */
    if(el.__caHandled) return;
  },true);
})();

(function(){
  var root=document.getElementById('cruise-auth-{{ section.id }}');
  if(!root) return;
  var API=root.getAttribute('data-api-base')||'https://cruiseapp2-production.up.railway.app';
  var KEY=root.getAttribute('data-web-key')||'';
  var APIKEY=root.getAttribute('data-api-key')||'';
  var GOOGLE_ID=root.getAttribute('data-google-id')||'';
  var APPLE_ID=root.getAttribute('data-apple-id')||'';

  var $=function(s,c){return (c||root).querySelector(s);};
  var $$=function(s,c){return Array.from((c||root).querySelectorAll(s));};

  function _token(){try{return localStorage.getItem('vr_at')||'';}catch(_){return'';}}
  function _user(){try{var u=localStorage.getItem('vr_au');return u?JSON.parse(u):null;}catch(_){return null;}}
  function _save(t,u){try{localStorage.setItem('vr_at',t);localStorage.setItem('vr_au',JSON.stringify(u));}catch(_){}}
  function _clear(){try{localStorage.removeItem('vr_at');localStorage.removeItem('vr_au');}catch(_){}}

  var toastEl=$('[data-ca-toast]'),toastT=null;
  function _toast(msg,type){
    if(!toastEl) return;
    toastEl.textContent=msg;
    toastEl.className='cruise-auth__toast is-visible'+(type==='err'?' is-err':'');
    clearTimeout(toastT);
    toastT=setTimeout(function(){toastEl.classList.remove('is-visible');},2800);
  }

  function _fetch(path,opts){
    opts=opts||{};
    var h=opts.headers||{};
    h['Content-Type']='application/json';
    var tok=_token();
    var isWebAuth=path.indexOf('/auth/web/')===0;
    /* Usar el primer key disponible (web_key con fallback a api_key) para Bearer,
       y api_key con fallback a web_key para X-API-Key — así funciona aunque solo
       esté configurada una de las dos */
    var bearerKey=KEY||APIKEY;
    var apiHeaderKey=APIKEY||KEY;
    if(isWebAuth){
      if(bearerKey) h['Authorization']='Bearer '+bearerKey;
      /* Algunos backends también validan X-API-Key en auth endpoints */
      if(apiHeaderKey) h['X-API-Key']=apiHeaderKey;
    } else {
      if(apiHeaderKey) h['X-API-Key']=apiHeaderKey;
      if(tok) h['Authorization']='Bearer '+tok;
    }
    if(opts.body&&typeof opts.body!=='string') opts.body=JSON.stringify(opts.body);
    return fetch(API+path,{method:opts.method||'GET',headers:h,body:opts.body}).then(function(r){
      return r.json().then(function(d){if(!r.ok){var err=new Error(d&&d.detail||('HTTP '+r.status));err.data=d;err.status=r.status;throw err;}return d;});
    });
  }

  /* ── Social auth ── */
  function _socialAuth(provider,id_token){
    _fetch('/auth/web/social',{method:'POST',body:{provider:provider,id_token:id_token,role:'rider'}}).then(function(d){
      if(d.access_token){_save(d.access_token,d.user);_toast('Welcome!','ok');_go('profile');}
      else throw new Error('No token');
    }).catch(function(e){_toast(e.message||'Auth failed','err');});
  }
  if(GOOGLE_ID){var gs=document.createElement('script');gs.src='https://accounts.google.com/gsi/client';gs.async=true;gs.defer=true;document.head.appendChild(gs);}
  function _googleSignIn(){
    try{
      if(!GOOGLE_ID){_toast('Google not configured','err');return;}
      /* Si el script aún no cargó, esperamos hasta 3s */
      var tries=0;
      function tryInit(){
        if(window.google&&window.google.accounts&&window.google.accounts.id){
          try{
            /* initialize + prompt devuelve el ID_TOKEN (JWT) que el backend necesita,
               NO access_token. El backend hace verify_id_token sobre este JWT. */
            window.google.accounts.id.initialize({
              client_id:GOOGLE_ID,
              callback:function(resp){
                if(resp&&resp.credential){_socialAuth('google',resp.credential);}
                else{_toast('Google sign-in cancelled','err');}
              },
              auto_select:false,
              cancel_on_tap_outside:true
            });
            window.google.accounts.id.prompt(function(notification){
              /* Si One Tap no se muestra (bloqueado), fallback a popup OAuth2 flow */
              if(notification.isNotDisplayed()||notification.isSkippedMoment()){
                /* Fallback: botón oculto que dispara el popup */
                try{
                  var tempDiv=document.createElement('div');
                  tempDiv.style.cssText='position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:2147483647;';
                  document.body.appendChild(tempDiv);
                  window.google.accounts.id.renderButton(tempDiv,{type:'standard',theme:'filled_black',size:'large',text:'signin_with',shape:'pill'});
                  /* Click automático */
                  setTimeout(function(){
                    var btn=tempDiv.querySelector('[role="button"]');
                    if(btn) btn.click();
                    setTimeout(function(){try{document.body.removeChild(tempDiv);}catch(_){}},8000);
                  },100);
                }catch(e2){_toast('Google popup blocked. Allow popups and try again.','err');}
              }
            });
          }catch(e){_toast('Google error: '+(e.message||'init failed'),'err');}
          return;
        }
        if(tries++<30){setTimeout(tryInit,100);}
        else{_toast('Google script did not load','err');}
      }
      /* Cargar el script si no está */
      if(!window.google||!window.google.accounts){
        if(!document.querySelector('script[src*="accounts.google.com/gsi"]')){
          var gs=document.createElement('script');
          gs.src='https://accounts.google.com/gsi/client';
          gs.async=true;
          gs.defer=true;
          document.head.appendChild(gs);
        }
        _toast('Loading Google…','ok');
      }
      tryInit();
    }catch(e){_toast('Google error: '+(e.message||e),'err');}
  }
  function _decodeJwtPayload(jwt){
    try{
      var parts=(jwt||'').split('.');
      if(parts.length<2) return null;
      var b64=parts[1].replace(/-/g,'+').replace(/_/g,'/');
      var pad=b64.length%4;if(pad) b64+=new Array(5-pad).join('=');
      return JSON.parse(atob(b64));
    }catch(_){return null;}
  }
  function _appleSignIn(isSignup){
    try{
      if(!APPLE_ID){_toast('Apple not configured','err');return;}
      /* Detectar si el usuario está en flujo de signup por contexto */
      if(typeof isSignup==='undefined'){
        isSignup=_currentScreen==='signup';
      }
      function doApple(){
        try{
          window.AppleID.auth.init({clientId:APPLE_ID,scope:'name email',redirectURI:window.location.origin+window.location.pathname,usePopup:true});
          window.AppleID.auth.signIn().then(function(resp){
            var t=resp&&resp.authorization&&resp.authorization.id_token;
            if(!t){_toast('Apple auth failed','err');return;}
            /* Si estamos en signup, intentar pre-rellenar email y avanzar el wizard */
            if(isSignup){
              var email='';
              var fullName='';
              /* Email puede venir en resp.user (solo primera vez) o en el id_token JWT */
              if(resp.user&&resp.user.email) email=resp.user.email;
              if(resp.user&&resp.user.name){
                fullName=((resp.user.name.firstName||'')+' '+(resp.user.name.lastName||'')).trim();
              }
              if(!email){
                var payload=_decodeJwtPayload(t);
                if(payload&&payload.email) email=payload.email;
              }
              if(email){
                _wizState.mode='email';
                _wizState.email=email;
                if(fullName){
                  var parts=fullName.split(' ');
                  _wizState.firstName=parts[0]||'';
                  _wizState.lastName=parts.slice(1).join(' ')||'';
                }
                /* Poner el email en el input visible */
                var emInput=_wizContent&&_wizContent.querySelector('[data-ca-intro-email]');
                if(emInput) emInput.value=email;
              }
            }
            _socialAuth('apple',t);
          }).catch(function(e){_toast((e&&e.error)||'Apple cancelled','err');});
        }catch(e){_toast('Apple error: '+(e.message||e),'err');}
      }
      if(!window.AppleID){
        var s=document.createElement('script');
        s.src='https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js';
        s.onload=doApple;
        s.onerror=function(){_toast('Apple script failed to load','err');};
        document.head.appendChild(s);
        _toast('Loading Apple…','ok');
      }else{doApple();}
    }catch(e){_toast('Apple error: '+(e.message||e),'err');}
  }

  /* ════════════════ Screen navigation ════════════════ */
  var screens=$$('.cruise-auth__screen');
  var _currentScreen='gate';

  function _go(name){
    if(name===_currentScreen) return;
    var prev=root.querySelector('.cruise-auth__screen.is-active');
    var next=null;
    screens.forEach(function(s){if(s.getAttribute('data-ca-screen')===name) next=s;});
    if(!next) return;

    /* If transitioning between gate/signup/signin — keep card visible, only fade content */
    var formScreens=['gate','signup','signin'];
    var isFormTransition=formScreens.indexOf(_currentScreen)>=0&&formScreens.indexOf(name)>=0;

    if(isFormTransition&&prev){
      /* Fade out current content */
      var prevContent=prev.querySelector('.cruise-auth__card,.cruise-auth__form-card,.cruise-auth__wiz-content');
      if(prevContent){prevContent.style.opacity='0';prevContent.style.transform='translateY(8px)';prevContent.style.transition='opacity 340ms cubic-bezier(.22,1,.36,1),transform 340ms cubic-bezier(.22,1,.36,1)';}

      setTimeout(function(){
        prev.classList.remove('is-active');
        if(prevContent){prevContent.style.opacity='';prevContent.style.transform='';prevContent.style.transition='';}

        /* Show new screen */
        next.classList.add('is-active');
        if(name==='signup') _wizGo(0);
        if(name==='profile') _loadProfile();

        /* Stagger children of target card */
        if(name==='signin'){
          var signinCard=next.querySelector('.cruise-auth__form-card');
          if(signinCard) _staggerChildren(signinCard,200);
        }
        if(name==='gate'){
          var gateCard=next.querySelector('.cruise-auth__card');
          if(gateCard) _staggerChildren(gateCard,200);
        }

        /* Fade in new content */
        var nextContent=next.querySelector('.cruise-auth__card,.cruise-auth__form-card,.cruise-auth__wiz-content');
        if(nextContent){
          nextContent.style.opacity='0';nextContent.style.transform='translateY(12px)';
          nextContent.style.transition='opacity 480ms cubic-bezier(.22,1,.36,1),transform 480ms cubic-bezier(.22,1,.36,1)';
          requestAnimationFrame(function(){requestAnimationFrame(function(){
            nextContent.style.opacity='1';nextContent.style.transform='translateY(0)';
            setTimeout(function(){nextContent.style.transition='';nextContent.style.opacity='';nextContent.style.transform='';},520);
          });});
        }
        _currentScreen=name;
      },360);
    } else {
      /* Full screen transition (e.g. to/from profile) */
      if(prev) prev.classList.add('is-leaving');
      setTimeout(function(){
        screens.forEach(function(s){s.classList.remove('is-active','is-leaving');});
        next.classList.add('is-active');
        if(name==='profile'){
          _loadProfile();
          /* Stagger profile home children */
          var homeCard=next.querySelector('[data-ca-sub="home"] .cruise-auth__sub-card');
          if(homeCard) _staggerChildren(homeCard,200);
          /* Animate header */
          var hdr=next.querySelector('.cruise-auth__profile-header');
          if(hdr){hdr.style.opacity='0';hdr.style.transform='translateY(-8px)';hdr.style.transition='none';
            requestAnimationFrame(function(){requestAnimationFrame(function(){
              hdr.style.transition='opacity 400ms cubic-bezier(.22,1,.36,1),transform 400ms cubic-bezier(.22,1,.36,1)';
              hdr.style.opacity='1';hdr.style.transform='translateY(0)';
              setTimeout(function(){hdr.style.transition='';hdr.style.opacity='';hdr.style.transform='';},440);
            });});
          }
        }
        if(name==='signup') _wizGo(0);
        _currentScreen=name;
      },prev?400:0);
    }
  }

  $$('[data-ca-goto]').forEach(function(b){
    b.addEventListener('click',function(){_go(b.getAttribute('data-ca-goto'));});
  });

  /* ════════════════ SIGN UP WIZARD (6 steps, mirrors vip-ride-auth.js) ════════════════ */
  var _wizContent=$('[data-ca-wiz-content]');
  var _wizState={mode:'email',email:'',phone:'',password:'',firstName:'',lastName:'',photoDataUrl:'',step:0};
  var _wizSteps=['intro','password','name','contact','photo','review'];

  function _esc(s){return (s||'').replace(/[<>&"']/g,function(c){return{'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c];});}

  function _wizGo(step){
    if(!_wizContent) return;
    _wizState.step=step;
    _wizContent.classList.add('is-fading');
    setTimeout(function(){
      var name=_wizSteps[step];
      if(name==='intro') _renderIntro();
      else if(name==='password') _renderPassword();
      else if(name==='name') _renderName();
      else if(name==='contact') _renderContact();
      else if(name==='photo') _renderPhoto();
      else if(name==='review') _renderReview();
      requestAnimationFrame(function(){requestAnimationFrame(function(){
        _wizContent.classList.remove('is-fading');
        /* Stagger wizard step children */
        _staggerChildren(_wizContent,80);
      });});
    },360);
  }

