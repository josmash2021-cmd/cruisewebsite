      '<button type="button" class="cruise-auth__link" data-ca-wiz-skip>Skip</button>';
    var fi=$('[data-ca-wiz-file]',_wizContent),pv=$('[data-ca-wiz-preview]',_wizContent);
    fi.addEventListener('change',function(e){
      var f=e.target.files&&e.target.files[0];if(!f)return;
      var r=new FileReader();r.onload=function(ev){_wizState.photoDataUrl=ev.target.result;pv.innerHTML='<img src="'+_wizState.photoDataUrl+'" alt="">';setTimeout(function(){_wizGo(5);},500);};
