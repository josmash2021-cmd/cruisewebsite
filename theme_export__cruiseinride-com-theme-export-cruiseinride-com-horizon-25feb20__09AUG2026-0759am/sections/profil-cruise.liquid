  function _renderReview(){
    var fullName=_esc(_wizState.firstName+' '+_wizState.lastName);
    _wizContent.innerHTML=
      '<h1 class="cruise-auth__heading">Looks good!</h1>'+
      '<p class="cruise-auth__heading-sub">Review your info and create your account.</p>'+
      '<div class="cruise-auth__photo-circle" style="width:100px;height:100px;margin:20px auto 12px">'+
        (_wizState.photoDataUrl?'<img src="'+_wizState.photoDataUrl+'" alt="">':'<svg width="40" height="40" viewBox="0 0 24 24" fill="rgba(255,255,255,.5)"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>')+
      '</div>'+
      '<p style="text-align:center;color:#fff;font-weight:700;font-size:17px;margin:0 0 6px">'+fullName+'</p>'+
      '<p style="text-align:center;color:rgba(255,255,255,.55);font-size:12px;margin:0 0 28px">'+_esc(_wizState.email||_wizState.phone)+'</p>'+
      '<button type="button" class="cruise-auth__btn cruise-auth__btn--primary" data-ca-wiz-save>Create my account</button>';
    $('[data-ca-wiz-save]',_wizContent).addEventListener('click',function(){
      var btn=this;btn.disabled=true;btn.textContent='Creating…';
      var body={first_name:_wizState.firstName,last_name:_wizState.lastName,password:_wizState.password,role:'rider'};
      if(_wizState.email) body.email=_wizState.email;
      if(_wizState.phone) body.phone=_wizState.phone;
      if(_wizState.photoDataUrl) body.photo_data=_wizState.photoDataUrl;
      _fetch('/auth/web/register',{method:'POST',body:body}).then(function(d){
        if(d.access_token){_save(d.access_token,d.user);_toast('Welcome to Cruise!','ok');_go('profile');}
        else throw new Error(d.detail||'Registration failed');
      }).catch(function(e){_toast(e.message||'Could not create account','err');btn.disabled=false;btn.textContent='Create my account';});
    });
  }

  /* Back button — wizard back within signup, or exit to gate */
  $('[data-ca-wiz-back]').addEventListener('click',function(){
    if(_wizState.step>0){_wizGo(_wizState.step-1);}
    else{_go('gate');}
  });

  /* ════════════════ SIGN IN ════════════════ */
  var signinErr=$('[data-ca-signin-err]');
  function _signinErr(msg){signinErr.textContent=msg||'';signinErr.classList.toggle('is-visible',!!msg);}

  $('[data-ca-signin-submit]').addEventListener('click',function(){
    var id=$('[data-ca-signin-id]').value.trim();
    var pw=$('[data-ca-signin-pass]').value;
    if(!id){_signinErr('Enter your email or phone');return;}
    if(!pw){_signinErr('Enter your password');return;}
    _signinErr('');
    var btn=this;btn.disabled=true;btn.textContent='Signing in…';
    _fetch('/auth/web/login',{method:'POST',body:{identifier:id,password:pw,role:'rider'}}).then(function(d){
      if(d.login_token){return _fetch('/auth/web/complete-login',{method:'POST',body:{login_token:d.login_token}});}
      else if(d.access_token){return d;}
      throw new Error('Invalid response');
    }).then(function(d){
      if(d&&d.access_token){_save(d.access_token,d.user);_toast('Welcome back!','ok');_go('profile');}
      else throw new Error('No token received');
    }).catch(function(e){_signinErr(e.message||'Invalid credentials');}).finally(function(){btn.disabled=false;btn.textContent='Sign In';});
  });

  try{
    var __gBtn=$('[data-ca-signin-google]');
    if(__gBtn) __gBtn.addEventListener('click',_googleSignIn);
  }catch(_){console.error('[cruise-auth] google button bind failed',_);}
  try{
    var __aBtn=$('[data-ca-signin-apple]');
    if(__aBtn) __aBtn.addEventListener('click',_appleSignIn);
  }catch(_){console.error('[cruise-auth] apple button bind failed',_);}

  /* ════════════════ PROFILE ════════════════ */
  var _profile=null;
  var _subScreen='home';

  function _monthYear(iso){try{var d=new Date(iso);var m=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return m[d.getMonth()]+' '+d.getFullYear();}catch(_){return'';}}
  function _monthsAgo(iso){try{var d=new Date(iso);if(isNaN(d.getTime()))return'—';var days=(Date.now()-d.getTime())/(86400000);if(days<1)return'Today';if(days<30)return Math.max(1,Math.round(days))+' d';var months=days/30.44;if(months<12)return Math.round(months)+' mo';var years=months/12;return(years<10?years.toFixed(1):Math.round(years))+' yr';}catch(_){return'—';}}

  function _renderHome(d){
    _profile=d;
    var first=(d.first_name||'').trim();
    var last=(d.last_name||'').trim();
    $('[data-ca-name]').textContent=(first+' '+last).trim()||d.email||'Cruise rider';
    var initial=(first||d.email||'C').charAt(0).toUpperCase();
    $('[data-ca-initial]').textContent=initial;
    var imgEl=$('[data-ca-photo]');
    if(d.photo_url){imgEl.src=d.photo_url;imgEl.hidden=false;$('[data-ca-initial]').style.display='none';}
    else{imgEl.hidden=true;$('[data-ca-initial]').style.display='';}
    var tripsCount=(d.ratings_count||d.total_trips||d.trips_count||0);
    if(tripsCount>=10){$('[data-ca-rating-text]').textContent='Cruise Rider';}
    else{$('[data-ca-rating-text]').textContent='New rider';}
    var createdAt=d.created_at||d.createdAt||d.member_since||d.memberSince||d.joined_at;
    if(createdAt){
      $('[data-ca-member]').textContent='Member since '+_monthYear(createdAt);
      $('[data-ca-stat-since]').textContent=_monthsAgo(createdAt);
    }else{
      $('[data-ca-member]').textContent='Welcome to Cruise';
      $('[data-ca-stat-since]').textContent='New';
    }
  }

  function _renderStats(trips){
    var miles=0;
    trips.forEach(function(t){miles+=parseFloat(t.distance_miles||t.distance||0);});
    $('[data-ca-stat-trips]').textContent=trips.length;
    $('[data-ca-stat-miles]').textContent=miles.toFixed(1);
    /* Rider label: <10 viajes = New rider, >=10 = Cruise Rider */
    var rt=$('[data-ca-rating-text]');
    if(rt){
      if(trips.length>=10) rt.textContent='Cruise Rider';
      else rt.textContent='New rider';
    }
  }

  function _renderTripList(el,trips,empty){
    el.innerHTML='';
    if(!trips.length){el.innerHTML='<div class="cruise-auth__empty">'+empty+'</div>';return;}
    trips.forEach(function(t,i){
      var c=document.createElement('div');c.className='cruise-auth__trip';
      c.style.opacity='0';c.style.transform='translateY(10px)';
      c.style.transition='opacity 360ms cubic-bezier(.22,1,.36,1) '+(i*60)+'ms,transform 360ms cubic-bezier(.22,1,.36,1) '+(i*60)+'ms';
      var d=new Date(t.created_at||t.scheduled_at||Date.now());
      var ds=d.toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'});
      var fare=t.fare?'$'+parseFloat(t.fare).toFixed(2):'—';
      var status=(t.status||'').replace(/_/g,' ');
      var statusClass=(t.status||'').replace(/_/g,'-');
      var time=d.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'});
      c.innerHTML='<div class="cruise-auth__trip-top"><span>'+ds+' · '+time+'</span><span class="cruise-auth__trip-fare">'+fare+'</span></div><div class="cruise-auth__trip-route"><span class="cruise-auth__trip-dot cruise-auth__trip-dot--g"></span><span>'+(t.pickup_address||'Pickup')+'</span></div><div class="cruise-auth__trip-route"><span class="cruise-auth__trip-dot cruise-auth__trip-dot--y"></span><span>'+(t.dropoff_address||'Dropoff')+'</span></div><div class="cruise-auth__trip-status cruise-auth__trip-status--'+statusClass+'">'+status+'</div>';
      el.appendChild(c);
      requestAnimationFrame(function(){requestAnimationFrame(function(){c.style.opacity='1';c.style.transform='translateY(0)';});});
    });
  }

  var _tripsCache=null;

  function _fetchWeb(path,opts){
    opts=opts||{};
    var h=opts.headers||{};
    h['Content-Type']='application/json';
    var tok=_token();
    if(tok) h['Authorization']='Bearer '+tok;
    var apiHeaderKey=APIKEY||KEY;
    if(apiHeaderKey) h['X-API-Key']=apiHeaderKey;
    if(opts.body&&typeof opts.body!=='string') opts.body=JSON.stringify(opts.body);
    return fetch(API+path,{method:opts.method||'GET',headers:h,body:opts.body}).then(function(r){
      return r.json().then(function(d){if(!r.ok){var err=new Error(d&&d.detail||('HTTP '+r.status));err.data=d;err.status=r.status;throw err;}return d;});
    });
  }

  /* Auto-refresh en tiempo real: al volver a la pestaña / ventana (regreso del app Cruise) */
  var _profileRefreshBound=false;
  function _bindRealtimeRefresh(){
    if(_profileRefreshBound) return;
    _profileRefreshBound=true;
    document.addEventListener('visibilitychange',function(){
      if(!document.hidden && _currentScreen==='profile'){_loadProfile();}
    });
    window.addEventListener('focus',function(){
      if(_currentScreen==='profile'){_loadProfile();}
    });
    /* Polling cada 30s mientras el profile esté visible */
    setInterval(function(){
      if(!document.hidden && _currentScreen==='profile'){_loadProfile();}
    },30000);
  }

  function _loadProfile(){
    _bindRealtimeRefresh();
    _fetchWeb('/auth/web/me').then(function(d){
      _renderHome(d);
      _fetchWeb('/auth/web/trips').then(function(resp){
        var trips=Array.isArray(resp)?resp:(resp&&resp.trips?resp.trips:[]);
        _tripsCache=trips;
        _renderStats(trips);
        var past=trips.filter(function(t){return['completed','cancelled'].indexOf(t.status)>=0;});
        var upc=trips.filter(function(t){return['scheduled','scheduled_accepted','scheduled_active','requested','accepted','driver_en_route','arrived','in_trip'].indexOf(t.status)>=0;});
        _renderTripList($('[data-ca-trips-list]'),past,'No trips yet');
        _renderTripList($('[data-ca-scheduled-list]'),upc,'No scheduled rides');
      }).catch(function(){
        $('[data-ca-trips-list]').innerHTML='<div class="cruise-auth__empty">No trips yet</div>';
        $('[data-ca-scheduled-list]').innerHTML='<div class="cruise-auth__empty">No scheduled rides</div>';
      });
    }).catch(function(e){
      if(e.status===401||e.status===403){_clear();_currentScreen='profile';_go('gate');}
    });
  }

  function _loadPayments(){
    /* Animate the payments sub-card title */
    var pmCard=root.querySelector('[data-ca-sub="payments"] .cruise-auth__sub-card');
    if(pmCard) _staggerChildren(pmCard,120);
    var l=$('[data-ca-payments-list]');
    l.innerHTML='<div class="cruise-auth__empty" style="padding:20px 0">Loading…</div>';
    /* El endpoint requiere rider_id como query param */
    var _riderId=(_profile&&(_profile.id||_profile.rider_id||_profile.user_id))||'';
    var _pmUrl='/riders/payment-methods'+(_riderId?('?rider_id='+encodeURIComponent(_riderId)):'');
    _fetchWeb(_pmUrl).then(function(methods){
      l.innerHTML='';
      if(!Array.isArray(methods)||!methods.length){
        /* No payment methods — show placeholder cards */
        var types=[
          {icon:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>',label:'Debit Card',sub:'Not configured yet'},
          {icon:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><circle cx="15" cy="16" r="1.5"/></svg>',label:'Credit Card',sub:'Not configured yet'}
        ];
        types.forEach(function(t,i){
          var c=document.createElement('div');c.className='cruise-auth__pm cruise-auth__pm--empty';
          c.style.opacity='0';c.style.transform='translateY(8px)';
          c.style.transition='opacity 320ms cubic-bezier(.22,1,.36,1) '+(i*80)+'ms,transform 320ms cubic-bezier(.22,1,.36,1) '+(i*80)+'ms';
          c.innerHTML='<div class="cruise-auth__pm-ico">'+t.icon+'</div><div class="cruise-auth__pm-info"><div class="cruise-auth__pm-type">'+t.label+'</div><div class="cruise-auth__pm-sub">'+t.sub+'</div></div><span class="cruise-auth__pm-add">+</span>';
          l.appendChild(c);
          requestAnimationFrame(function(){requestAnimationFrame(function(){c.style.opacity='1';c.style.transform='translateY(0)';});});
        });
        return;
      }
      methods.forEach(function(m,i){
        var c=document.createElement('div');c.className='cruise-auth__pm';
        c.style.opacity='0';c.style.transform='translateY(8px)';
        c.style.transition='opacity 320ms cubic-bezier(.22,1,.36,1) '+(i*80)+'ms,transform 320ms cubic-bezier(.22,1,.36,1) '+(i*80)+'ms';
        var brand=(m.brand||m.card_brand||'card').toLowerCase();
        var last4=m.last4||m.last_four||'****';
        var type=m.funding||m.method_type||'card';
        var label=(type==='debit'?'Debit':'Credit')+' ··· '+last4;
        var brandIcon=brand==='visa'?'VISA':brand==='mastercard'?'MC':brand==='amex'?'AMEX':brand.toUpperCase();
        c.innerHTML='<div class="cruise-auth__pm-ico"><span class="cruise-auth__pm-brand">'+brandIcon+'</span></div><div class="cruise-auth__pm-info"><div class="cruise-auth__pm-type">'+label+'</div><div class="cruise-auth__pm-sub">'+(m.display_name||brand.charAt(0).toUpperCase()+brand.slice(1))+'</div></div>'+(m.is_default?'<span class="cruise-auth__pm-badge">Default</span>':'');
        l.appendChild(c);
        requestAnimationFrame(function(){requestAnimationFrame(function(){c.style.opacity='1';c.style.transform='translateY(0)';});});
      });
    }).catch(function(){
      l.innerHTML='';
      var types=[
        {icon:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>',label:'Debit Card',sub:'Not configured yet'},
        {icon:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><circle cx="15" cy="16" r="1.5"/></svg>',label:'Credit Card',sub:'Not configured yet'}
      ];
      types.forEach(function(t,i){
        var c=document.createElement('div');c.className='cruise-auth__pm cruise-auth__pm--empty';
        c.style.opacity='0';c.style.transform='translateY(8px)';
        c.style.transition='opacity 320ms cubic-bezier(.22,1,.36,1) '+(i*80)+'ms,transform 320ms cubic-bezier(.22,1,.36,1) '+(i*80)+'ms';
        c.innerHTML='<div class="cruise-auth__pm-ico">'+t.icon+'</div><div class="cruise-auth__pm-info"><div class="cruise-auth__pm-type">'+t.label+'</div><div class="cruise-auth__pm-sub">'+t.sub+'</div></div><span class="cruise-auth__pm-add">+</span>';
        l.appendChild(c);
        requestAnimationFrame(function(){requestAnimationFrame(function(){c.style.opacity='1';c.style.transform='translateY(0)';});});
      });
    });
  }

  function _staggerChildren(container,delay){
    delay=delay||0;
    /* Grab meaningful visible children — direct children of card, or specific elements */
    var children=Array.from(container.children);
    children.forEach(function(el,i){
      el.style.opacity='0';el.style.transform='translateY(14px)';
      el.style.transition='none';
      setTimeout(function(){
        el.style.transition='opacity 440ms cubic-bezier(.22,1,.36,1),transform 440ms cubic-bezier(.22,1,.36,1)';
        el.style.opacity='1';el.style.transform='translateY(0)';
        setTimeout(function(){el.style.transition='';el.style.opacity='';el.style.transform='';},480);
      },delay+(i*70));
    });
  }

  function _showSub(name){
    _subScreen=name;
    var prev=root.querySelector('.cruise-auth__sub-screen.is-active');
    var goingBack=(name==='home');
    if(prev){
      prev.style.transition='opacity 280ms cubic-bezier(.22,1,.36,1),transform 280ms cubic-bezier(.22,1,.36,1)';
      prev.style.opacity='0';
      prev.style.transform=goingBack?'translateX(12px)':'translateX(-12px)';
    }
    setTimeout(function(){
      $$('.cruise-auth__sub-screen').forEach(function(s){
        var isTarget=s.getAttribute('data-ca-sub')===name;
        s.classList.toggle('is-active',isTarget);
        s.style.transition='';s.style.opacity='';s.style.transform='';
        if(isTarget){
          s.style.opacity='0';
          s.style.transform=goingBack?'translateX(-12px)':'translateX(12px)';
          requestAnimationFrame(function(){requestAnimationFrame(function(){
            s.style.transition='opacity 340ms cubic-bezier(.22,1,.36,1),transform 340ms cubic-bezier(.22,1,.36,1)';
            s.style.opacity='1';s.style.transform='translateX(0)';
            setTimeout(function(){s.style.transition='';s.style.opacity='';s.style.transform='';},380);
          });});
          /* Stagger children inside the card (skip payments — async loads its own) */
          if(name!=='payments'){
            var card=s.querySelector('.cruise-auth__sub-card');
            if(card) _staggerChildren(card,180);
          }
        }
      });
      var titles={home:'Profile',edit:'Edit Profile',trips:'Trip History',scheduled:'Scheduled Rides',payments:'Payment Methods'};
      $('[data-ca-profile-title]').textContent=titles[name]||'Profile';
      /* Botón back siempre visible: si está en home vuelve a página anterior (app/ride), si no vuelve a home */
      $('[data-ca-profile-back]').hidden=false;
      $('[data-ca-edit-btn]').hidden=(name!=='home');
      if(name==='payments') _loadPayments();
    },prev?300:0);
  }

  $$('[data-ca-sub-nav]').forEach(function(b){b.addEventListener('click',function(){_showSub(b.getAttribute('data-ca-sub-nav'));});});
  $('[data-ca-profile-back]').addEventListener('click',function(){
    /* Si estamos en un sub-screen (edit/trips/scheduled/payments), volver a home */
    var currentSub=root.querySelector('[data-ca-sub].is-active');
    var subName=currentSub?currentSub.getAttribute('data-ca-sub'):'home';
    if(subName!=='home'){_showSub('home');return;}
    /* Si estamos en home, volver a la página anterior del navegador */
    if(window.history.length>1){window.history.back();}
    else{window.location.href='/';}
  });
  $('[data-ca-edit-btn]').addEventListener('click',function(){
    if(!_profile) return;
    $('[data-ca-edit-first]').value=_profile.first_name||'';
    $('[data-ca-edit-last]').value=_profile.last_name||'';
    $('[data-ca-edit-email]').value=_profile.email||'';
    $('[data-ca-edit-phone]').value=_profile.phone||'';
    _showSub('edit');
  });
  $('[data-ca-edit-cancel]').addEventListener('click',function(){_showSub('home');});

  $('[data-ca-edit-form]').addEventListener('submit',function(e){
    e.preventDefault();
    var body={
      first_name:$('[data-ca-edit-first]').value.trim(),
      last_name:$('[data-ca-edit-last]').value.trim(),
      email:$('[data-ca-edit-email]').value.trim(),
      phone:$('[data-ca-edit-phone]').value.trim(),
    };
    _fetchWeb('/auth/web/profile',{method:'PATCH',body:body}).then(function(d){
      _renderHome(d);
      try{localStorage.setItem('vr_au',JSON.stringify(d));}catch(_){}
      _toast('Profile updated','ok');
      _showSub('home');
    }).catch(function(e){_toast(e.message||'Update failed','err');});
  });

  $('[data-ca-avatar]').addEventListener('click',function(){$('[data-ca-photo-input]').click();});
  $('[data-ca-photo-input]').addEventListener('change',function(e){
    var file=e.target.files&&e.target.files[0];
    if(!file) return;
    var reader=new FileReader();
    reader.onload=function(){
      var b64=reader.result.split(',')[1];
      _toast('Uploading photo…','ok');
      _fetchWeb('/auth/photo',{method:'POST',body:{photo:b64}}).then(function(d){
        if(d.photo_url){
          $('[data-ca-photo]').src=d.photo_url;
          $('[data-ca-photo]').hidden=false;
          $('[data-ca-initial]').style.display='none';
          _toast('Photo updated','ok');
        }
      }).catch(function(){_toast('Upload failed','err');});
    };
    reader.readAsDataURL(file);
  });

  $('[data-ca-signout]').addEventListener('click',function(){
    _clear();_profile=null;_tripsCache=null;
    _toast('Signed out','ok');
    _currentScreen='profile';
    setTimeout(function(){
      _showSub('home');
      _go('gate');
      /* Re-trigger gate card animation */
      var gateCard=root.querySelector('.cruise-auth__card');
      if(gateCard){
        gateCard.style.animation='none';
        requestAnimationFrame(function(){
          gateCard.style.animation='';
          _staggerChildren(gateCard,200);
        });
      }
      var idEl=root.querySelector('[data-ca-signin-id]');
      var pwEl=root.querySelector('[data-ca-signin-pass]');
      if(idEl) idEl.value='';
      if(pwEl) pwEl.value='';
      var errEl=root.querySelector('[data-ca-signin-err]');
      if(errEl){errEl.textContent='';errEl.classList.remove('is-visible');}
    },100);
  });

  /* ════════════════ EVENT DELEGATION GLOBAL (backup para todos los botones) ════════════════
     Si algún listener individual no se registró por un error anterior, este delegation captura
     clicks en cualquier botón con data-ca-* y ejecuta la acción correspondiente. */
  root.addEventListener('click',function(ev){
    var t=ev.target;
    if(!t||!t.closest) return;
    var el;
    /* data-ca-goto → navegar al screen */
    if((el=t.closest('[data-ca-goto]'))){
      var name=el.getAttribute('data-ca-goto');
      if(name){ev.preventDefault();_go(name);return;}
    }
    /* Back buttons */
    if((el=t.closest('[data-ca-profile-back]'))){
      ev.preventDefault();
      var cs=root.querySelector('[data-ca-sub].is-active');
      var sn=cs?cs.getAttribute('data-ca-sub'):'home';
      if(sn!=='home'){if(typeof _showSub==='function') _showSub('home');return;}
      if(window.history.length>1){window.history.back();}else{window.location.href='/';}
      return;
    }
    if((el=t.closest('[data-ca-wiz-back]'))){
      ev.preventDefault();
      if(typeof _wizGo==='function'){
        if(_wizState&&_wizState.step>0){_wizGo(_wizState.step-1);}
        else{_go('gate');}
      }else{_go('gate');}
      return;
    }
    /* Google / Apple signin */
    if((el=t.closest('[data-ca-signin-google],[data-ca-intro-google]'))){
      ev.preventDefault();if(typeof _googleSignIn==='function') _googleSignIn();return;
    }
    if((el=t.closest('[data-ca-signin-apple],[data-ca-intro-apple]'))){
      ev.preventDefault();if(typeof _appleSignIn==='function') _appleSignIn();return;
    }
  });

  /* ════════════════ INIT ════════════════ */
  var _forceProfile=false;
  try{
    var _qs=new URLSearchParams(window.location.search);
    if(_qs.get('view')==='profile') _forceProfile=true;
  }catch(_){ /* noop */ }

  if(_token()||_forceProfile){
    var cached=_user();
    if(cached) _renderHome(cached);
    _go('profile');
  }

  /* Safety net: tras 2.5s, marcar como ready → fuerza visible cualquier hijo que haya quedado con opacity:0 */
  setTimeout(function(){try{root.classList.add('is-ready');}catch(_){}},2500);
})();
</script>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&display=swap');
  html:has(.cruise-auth),body:has(.cruise-auth){margin:0!important;padding:0!important;overflow:hidden!important;height:100%!important;height:100dvh!important;overscroll-behavior:none;touch-action:pan-x pan-y;-ms-touch-action:pan-x pan-y;}
  body:has(.cruise-auth) footer,body:has(.cruise-auth) .footer,body:has(.cruise-auth) #footer,body:has(.cruise-auth) [class*="footer"]{display:none!important;}
  body:has(.cruise-auth) header,body:has(.cruise-auth) .header,body:has(.cruise-auth) #header,body:has(.cruise-auth) [class*="header-section"],body:has(.cruise-auth) header-component,body:has(.cruise-auth) sticky-header,body:has(.cruise-auth) .shopify-section-group-header-group{background:transparent!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;}
  body:has(.cruise-auth) header .header__underlay,body:has(.cruise-auth) header .header__underlay-closed,body:has(.cruise-auth) header .header__underlay-open{background:transparent!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;box-shadow:none!important;}
  body:has(.cruise-auth) .shopify-section-group-header-group{position:fixed!important;top:0!important;left:0!important;right:0!important;z-index:999!important;pointer-events:auto;}
  .cruise-auth{position:fixed!important;inset:0!important;z-index:99!important;}
  .shopify-section:has(.cruise-auth){margin-top:calc(var(--header-height,60px)*-1)!important;padding:0!important;min-height:100vh!important;min-height:100dvh!important;}
  .cruise-auth{
    --ca-gold:#E8C547;
    --ca-bg:#08080a;
    --ca-card:rgba(8,8,10,.38);
    --ca-border:rgba(255,255,255,.1);
    --ca-muted:rgba(255,255,255,.62);
    --ca-input-bg:rgba(255,255,255,.06);
    --ca-input-border:rgba(255,255,255,.14);
    --ca-ease:cubic-bezier(.22,1,.36,1);
    position:relative;
    width:100%;
    height:100vh;
    height:100dvh;
    max-height:100vh;
    max-height:100dvh;
    background-color:var(--ca-bg);
    color:#fff;
    font-family:'Poppins','Inter',-apple-system,system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow:hidden;
  }
  .cruise-auth__bg-video-wrap{position:absolute;inset:0;overflow:hidden;z-index:0;pointer-events:none;background:var(--ca-bg);}
  .cruise-auth__bg-video{position:absolute;top:50%;left:50%;min-width:100%;min-height:100%;width:auto;height:auto;transform:translate3d(-50%,-50%,0);-webkit-transform:translate3d(-50%,-50%,0);object-fit:cover;will-change:transform;}
  /* Ensure the video element starts visible immediately — no fade-in that would hide it behind the card animation */
  .cruise-auth__bg-video[poster]{background-color:transparent;}
  .cruise-auth__bg-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,8,10,.72) 0%,rgba(8,8,10,.86) 60%,rgba(8,8,10,.94) 100%);pointer-events:none;z-index:1;}
  .cruise-auth__inner{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;}

  /* Screens — stacked absolute overlays filling the full section, only one visible at a time */
  .cruise-auth__screen{position:absolute;inset:0;display:none;align-items:center;justify-content:center;padding:calc(var(--header-height,60px) + 14px) 22px 28px;overflow-y:auto;-webkit-overflow-scrolling:touch;opacity:0;transform:translateY(14px);transition:opacity 500ms var(--ca-ease),transform 500ms var(--ca-ease);will-change:opacity,transform;}
  .cruise-auth__screen.is-active{display:flex;opacity:1;transform:translateY(0);transition:opacity 560ms var(--ca-ease) 160ms,transform 560ms var(--ca-ease) 160ms;}
  .cruise-auth__screen.is-leaving{display:flex;opacity:0;transform:translateY(-12px);pointer-events:none;transition:opacity 380ms var(--ca-ease),transform 380ms var(--ca-ease);}
  .cruise-auth__screen::-webkit-scrollbar{display:none;}
  @media (max-width:480px){
    .cruise-auth__screen{padding:calc(var(--header-height,60px) + 10px) 16px 20px;}
  }

  /* ═══════════ GATE ═══════════ */
  .cruise-auth__gate{align-items:center;justify-content:center;}
  .cruise-auth__card{
    position:relative;
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(232,197,71,.09) 0%, transparent 55%),
      linear-gradient(180deg, rgba(22,22,28,.72) 0%, rgba(10,10,14,.82) 100%);
    border:1px solid transparent;
    border-radius:26px;
    padding:46px 26px 26px;
    max-width:360px;
    width:100%;
    text-align:center;
    box-shadow:
      0 1px 0 rgba(255,255,255,.06) inset,
      0 -1px 0 rgba(232,197,71,.08) inset,
      0 30px 80px rgba(0,0,0,.6),
      0 0 80px rgba(232,197,71,.08);
    backdrop-filter:blur(28px) saturate(160%);
    -webkit-backdrop-filter:blur(28px) saturate(160%);
    animation:caCardIn 760ms var(--ca-ease) 100ms both;
    will-change:transform,opacity;
  }
  /* Borde dorado degradado (técnica mask con doble background) */
  .cruise-auth__card::after{
    content:'';
    position:absolute;
    inset:0;
    border-radius:26px;
    padding:1px;
    background:linear-gradient(145deg, rgba(255,230,150,.55) 0%, rgba(232,197,71,.25) 25%, rgba(255,255,255,.06) 50%, rgba(232,197,71,.22) 75%, rgba(255,230,150,.5) 100%);
    -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite:exclude;
    pointer-events:none;
    z-index:1;
  }
  /* Resplandor dorado sutil en la parte superior interior */
  .cruise-auth__card::before{
    content:'';
    position:absolute;
    top:0;left:50%;
    transform:translateX(-50%);
    width:70%;
    height:1px;
    background:linear-gradient(90deg, transparent, rgba(255,215,122,.8), transparent);
    z-index:2;
    pointer-events:none;
    filter:blur(.4px);
  }
  @keyframes caCardIn{0%{opacity:0;transform:translateY(26px) scale(.96);}60%{opacity:1;}100%{opacity:1;transform:translateY(0) scale(1);}}
  .cruise-auth__card>*{opacity:0;transform:translateY(14px);animation:caItemIn 680ms var(--ca-ease) forwards;}
  /* Safety net: si pasa más de 2s y las animaciones fallan, forzar todo visible */
  .cruise-auth.is-ready .cruise-auth__card>*{opacity:1!important;transform:none!important;}
  @keyframes caItemIn{to{opacity:1;transform:translateY(0);}}
  .cruise-auth__card>.cruise-auth__badge{animation-delay:380ms;}
  .cruise-auth__card>.cruise-auth__logo{animation-delay:300ms;}
  .cruise-auth__card>.cruise-auth__brand{animation-delay:380ms;}
  .cruise-auth__card>.cruise-auth__title{animation-delay:460ms;}
  .cruise-auth__card>.cruise-auth__sub{animation-delay:540ms;}
  .cruise-auth__card>.cruise-auth__actions{animation-delay:620ms;}
  .cruise-auth__card>.cruise-auth__perks{animation-delay:720ms;}

  .cruise-auth__badge{
    position:absolute;
    top:-14px;
    left:50%;
    transform:translateX(-50%);
    display:inline-flex;
    align-items:center;
    gap:7px;
    padding:7px 18px;
    background:linear-gradient(135deg,#fff4c4 0%,#f5d77a 30%,#d4af37 70%,#b98d1c 100%);
    color:#0a0e1a;
    font-size:10.5px;
    font-weight:800;
    letter-spacing:.22em;
    text-transform:uppercase;
    border-radius:999px;
    box-shadow:
      0 1px 0 rgba(255,255,255,.55) inset,
      0 -1px 0 rgba(0,0,0,.18) inset,
      0 6px 22px rgba(212,175,55,.5),
      0 0 0 3px rgba(8,8,10,.9),
      0 0 30px rgba(232,197,71,.35);
    white-space:nowrap;
    z-index:3;
  }
  .cruise-auth__badge::before,
  .cruise-auth__badge::after{
    content:'';
    width:4px;
    height:4px;
    border-radius:50%;
    background:rgba(10,14,26,.55);
  }
  .cruise-auth__card>.cruise-auth__badge{transform:translateX(-50%) translateY(14px);}
  @keyframes caBadgeIn{to{opacity:1;transform:translateX(-50%) translateY(0);}}
  .cruise-auth__card>.cruise-auth__badge{animation-name:caBadgeIn;}

  .cruise-auth__logo{
    position:relative;
    width:96px;
    height:96px;
    border-radius:50%;
    background:
      radial-gradient(circle at 35% 30%, rgba(255,244,196,.18) 0%, rgba(232,197,71,.04) 45%, transparent 70%),
      rgba(232,197,71,.06);
    border:1.5px solid transparent;
    background-clip:padding-box;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--ca-gold);
    margin:0 auto 12px;
    box-shadow:
      0 0 0 1px rgba(232,197,71,.4),
      0 0 0 4px rgba(232,197,71,.08),
      0 10px 36px rgba(232,197,71,.28),
      0 0 60px rgba(232,197,71,.18),
      inset 0 1px 0 rgba(255,244,196,.3);
    overflow:visible;
  }
  .cruise-auth__logo::after{
    content:'';
    position:absolute;
    inset:-1.5px;
    border-radius:50%;
    padding:1.5px;
    background:conic-gradient(from 0deg, rgba(255,244,196,.85), rgba(232,197,71,.3), rgba(255,244,196,.85), rgba(185,141,28,.45), rgba(255,244,196,.85));
    -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite:exclude;
    pointer-events:none;
  }
  .cruise-auth__logo svg{width:42px;height:42px;}
  .cruise-auth__logo img{width:100%;height:100%;object-fit:contain;}

  .cruise-auth__brand{font-family:'Cinzel','Playfair Display',Georgia,serif;font-size:28px;font-weight:700;letter-spacing:.22em;color:#fff;margin:0 0 16px;text-transform:uppercase;text-shadow:0 0 18px rgba(255,255,255,.5),0 0 36px rgba(232,197,71,.3),0 2px 8px rgba(0,0,0,.4);}

  .cruise-auth__title{margin:0 0 10px;font-size:22px;font-weight:800;color:#fff;letter-spacing:-.3px;line-height:1.2;}
  .cruise-auth__sub{margin:0 0 24px;font-size:13px;color:var(--ca-muted);line-height:1.55;}
  .cruise-auth__actions{display:flex;flex-direction:column;gap:10px;margin-bottom:22px;}
  .cruise-auth__perks{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 16px;padding-top:16px;border-top:1px solid rgba(255,255,255,.06);}
  .cruise-auth__perk{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--ca-muted);font-weight:500;}
  .cruise-auth__perk span{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border-radius:50%;background:rgba(232,197,71,.15);color:var(--ca-gold);font-size:10px;font-weight:800;}

  /* ═══════════ FORM SCREENS ═══════════ */
  .cruise-auth__form-screen{
    flex-direction:column;
    align-items:center;
    justify-content:flex-start !important;
    overflow-y:auto !important;
    -webkit-overflow-scrolling:touch;
    padding-top:calc(var(--header-height,60px) + 20px) !important;
    padding-bottom:40px !important;
  }
  .cruise-auth__form-screen.is-active{display:flex;}
  .cruise-auth__form-screen > *{flex-shrink:0;}
  .cruise-auth__form-card{
    width:100%;
    max-width:360px;
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(232,197,71,.06) 0%, transparent 55%),
      linear-gradient(180deg, rgba(22,22,28,.55) 0%, rgba(10,10,14,.7) 100%);
    border:1px solid rgba(232,197,71,.16);
    border-radius:24px;
    padding:24px 24px 26px;
    backdrop-filter:blur(40px) saturate(160%);
    -webkit-backdrop-filter:blur(40px) saturate(160%);
    box-shadow:
      0 1px 0 rgba(255,255,255,.06) inset,
      0 20px 60px rgba(0,0,0,.5),
      0 0 80px rgba(232,197,71,.06);
    animation:caCardIn 660ms var(--ca-ease) 80ms both;
    margin:auto 0;
  }
  .cruise-auth__back{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.06);border:none;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;margin-bottom:10px;flex-shrink:0;}
  .cruise-auth__back:active{background:rgba(255,255,255,.14);transform:scale(.94);}
  .cruise-auth__heading{margin:0 0 4px;font-size:24px;font-weight:800;color:#fff;letter-spacing:-.4px;line-height:1.15;text-align:center;}
  .cruise-auth__heading-sub{margin:0 0 18px;font-size:12px;color:var(--ca-muted);text-align:center;}

  .cruise-auth__wiz-content{opacity:1;transform:translateY(0);transition:opacity 440ms var(--ca-ease),transform 440ms var(--ca-ease);will-change:opacity,transform;}
  .cruise-auth__wiz-content.is-fading{opacity:0;transform:translateY(10px);}

  .cruise-auth__rules{list-style:none;padding:0;margin:0 0 20px;}
  .cruise-auth__rules li{display:flex;align-items:center;gap:10px;font-size:13px;color:rgba(255,255,255,.4);padding:4px 0;}
  .cruise-auth__rules li.ok{color:var(--ca-gold);}
  .cruise-auth__rules li::before{content:'';width:14px;height:14px;border-radius:50%;border:1.5px solid currentColor;display:inline-block;flex-shrink:0;background:transparent;transition:background 180ms,border-color 180ms;}
  .cruise-auth__rules li.ok::before{background:var(--ca-gold);border-color:var(--ca-gold);}

  .cruise-auth__photo-circle{width:140px;height:140px;border-radius:50%;background:rgba(232,197,71,.15);border:2px solid rgba(232,197,71,.4);display:flex;align-items:center;justify-content:center;margin:30px auto;overflow:hidden;}
  .cruise-auth__photo-circle img{width:100%;height:100%;object-fit:cover;}

  .cruise-auth__input{display:flex;align-items:center;gap:10px;background:var(--ca-input-bg);border:1px solid var(--ca-input-border);border-radius:14px;padding:14px 16px;margin-bottom:10px;transition:border-color 200ms,background 200ms;}
  .cruise-auth__input:focus-within{border-color:rgba(232,197,71,.4);background:rgba(255,255,255,.06);}
  .cruise-auth__input-ico{color:var(--ca-muted);flex-shrink:0;}
  .cruise-auth__input input{flex:1;background:transparent;border:none;outline:none;color:#fff;font-family:inherit;font-size:16px;font-weight:500;min-width:0;padding:0;-webkit-text-size-adjust:100%;}
  .cruise-auth__input input::placeholder{color:rgba(255,255,255,.4);}
  @supports (-webkit-touch-callout:none){.cruise-auth__input input{font-size:16px!important;}}

  .cruise-auth__err{min-height:18px;margin:4px 4px 8px;font-size:12px;font-weight:600;color:#ff6b6b;opacity:0;transition:opacity 220ms;}
  .cruise-auth__err.is-visible{opacity:1;}

  .cruise-auth__btn{width:100%;padding:15px;border:none;border-radius:14px;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;margin-bottom:10px;transition:transform 180ms var(--ca-ease),box-shadow 220ms;}
  .cruise-auth__btn:active:not(:disabled){transform:scale(.97);}
  .cruise-auth__btn:disabled{opacity:.5;cursor:not-allowed;}
  .cruise-auth__btn--primary{background:linear-gradient(135deg,#E8C547,#d4a017);color:#0a0e1a;font-weight:800;box-shadow:0 6px 22px rgba(232,197,71,.35),0 0 0 1px rgba(232,197,71,.3);transition:transform 180ms var(--ca-ease),box-shadow 220ms;}
  .cruise-auth__btn--primary:hover:not(:disabled){box-shadow:0 8px 28px rgba(232,197,71,.5),0 0 0 1px rgba(232,197,71,.4);}
  .cruise-auth__btn--dark{background:rgba(255,255,255,.04);color:#fff;border:1px solid rgba(255,255,255,.08);font-size:14px;}
  .cruise-auth__btn--dark:hover{background:rgba(255,255,255,.07);}
  /* Asegurar que los SVGs (logos Google/Apple) sean visibles en los botones sociales */
  .cruise-auth__btn svg{display:inline-block!important;width:18px!important;height:18px!important;flex-shrink:0;vertical-align:middle;}
  .cruise-auth__btn[data-ca-signin-apple] svg,
  .cruise-auth__btn[data-ca-intro-apple-btn] svg{fill:#fff!important;color:#fff!important;}
  .cruise-auth__btn--ghost{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.18);font-size:13px;font-weight:600;}
  .cruise-auth__btn--ghost:hover{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.3);}
  .cruise-auth__btn--outline{background:transparent;color:var(--ca-gold);border:1.5px solid rgba(232,197,71,.4);}
  .cruise-auth__btn--outline:hover{background:rgba(232,197,71,.06);}

  .cruise-auth__divider{display:flex;align-items:center;gap:12px;margin:14px 0;color:var(--ca-muted);font-size:11px;letter-spacing:.08em;font-weight:600;}
  .cruise-auth__divider::before,.cruise-auth__divider::after{content:'';flex:1;height:1px;background:rgba(255,255,255,.08);}

  .cruise-auth__link{background:none;border:1.5px solid rgba(232,197,71,.4);width:100%;padding:14px;border-radius:14px;color:var(--ca-gold);font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;margin-top:4px;}
  .cruise-auth__link--gold{color:var(--ca-gold);}

  .cruise-auth__terms{margin:18px 0 0;text-align:center;font-size:11px;color:var(--ca-muted);line-height:1.5;}
  .cruise-auth__terms a{color:var(--ca-gold);text-decoration:underline;}

  /* ═══════════ PROFILE ═══════════ */
  .cruise-auth__profile{
    flex-direction:column;
    align-items:center;
    justify-content:flex-start !important;
    overflow:hidden !important;
    padding-top:calc(var(--header-height,60px) + 6px) !important;
    padding-bottom:10px !important;
  }
  .cruise-auth__profile.is-active{display:flex;}
  .cruise-auth__profile-header{display:flex;align-items:center;gap:12px;padding:8px 0 14px;width:100%;max-width:340px;flex-shrink:0;}
  .cruise-auth__back--sub{position:static;}
  .cruise-auth__profile-title{flex:1;margin:0;font-size:18px;font-weight:800;color:#fff;text-align:center;}
  .cruise-auth__edit-btn{background:transparent;border:none;color:var(--ca-gold);font-family:inherit;font-weight:700;font-size:13px;cursor:pointer;padding:6px 10px;}

  .cruise-auth__sub-screen{display:none;width:100%;max-width:340px;will-change:opacity,transform;}
  .cruise-auth__sub-screen.is-active{display:block;}

  .cruise-auth__sub-card{background:rgba(0,0,0,.62);border:1px solid rgba(232,197,71,.18);border-radius:20px;padding:22px 18px;backdrop-filter:blur(22px) saturate(150%);-webkit-backdrop-filter:blur(22px) saturate(150%);box-shadow:0 0 0 1px rgba(232,197,71,.06),0 14px 40px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.04);max-height:calc(100vh - 200px);max-height:calc(100dvh - 200px);overflow-y:auto;-webkit-overflow-scrolling:touch;}
  .cruise-auth__sub-card::-webkit-scrollbar{display:none;}
  .cruise-auth__sub-title{margin:0 0 16px;font-size:18px;font-weight:800;color:#fff;text-align:center;letter-spacing:-.3px;}

  .cruise-auth__hero{text-align:center;padding:4px 0 16px;}
  .cruise-auth__avatar{position:relative;width:74px;height:74px;border-radius:50%;background:linear-gradient(135deg,#E8C547,#d4a017);border:none;margin:0 auto 8px;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;overflow:visible;box-shadow:0 0 0 3px rgba(232,197,71,.12),0 8px 28px rgba(232,197,71,.25),0 14px 40px rgba(0,0,0,.4);}
  .cruise-auth__avatar:active{transform:scale(.97);}
  .cruise-auth__avatar-initial{font-size:30px;font-weight:800;color:#0a0e1a;}
  .cruise-auth__avatar-img{position:absolute;inset:0;width:100%;height:100%;border-radius:50%;object-fit:cover;}
  .cruise-auth__avatar-edit{position:absolute;bottom:-2px;right:-2px;width:28px;height:28px;border-radius:50%;background:#0a0e1a;border:2px solid #E8C547;display:flex;align-items:center;justify-content:center;color:#E8C547;z-index:2;box-shadow:0 2px 8px rgba(0,0,0,.5);}
  .cruise-auth__name{margin:0 0 2px;font-size:17px;font-weight:800;color:#fff;letter-spacing:-.2px;}
  .cruise-auth__rating{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;color:var(--ca-gold);font-weight:600;margin-bottom:1px;}
  .cruise-auth__rating svg{width:11px;height:11px;}
  .cruise-auth__member{font-size:10.5px;color:var(--ca-muted);margin-bottom:10px;}

  /* STATS — minimalista, sin bordes dorados ni sombras pesadas */
  .cruise-auth__stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0 0 16px;}
  .cruise-auth__stat{
    background:rgba(255,255,255,.03);
    border:1px solid rgba(255,255,255,.06);
    border-radius:12px;
    padding:12px 6px;
    text-align:center;
    transition:background 200ms;
  }
  .cruise-auth__stat:hover{background:rgba(255,255,255,.05);}
  .cruise-auth__stat-val{font-size:18px;font-weight:700;color:#fff;margin-bottom:2px;letter-spacing:-.3px;}
  .cruise-auth__stat-lbl{font-size:10px;color:rgba(255,255,255,.5);letter-spacing:.02em;}

  /* ROWS — minimalista, fondo sutil y clean */
  .cruise-auth__rows{display:flex;flex-direction:column;gap:4px;margin:0 0 12px;}
  .cruise-auth__row{
    display:flex;
    align-items:center;
    gap:14px;
    padding:12px 14px;
    border-radius:12px;
    background:rgba(255,255,255,.025);
    border:1px solid rgba(255,255,255,.05);
    color:#fff;
    cursor:pointer;
    text-align:left;
    font-family:inherit;
    transition:background 200ms, transform 160ms var(--ca-ease);
  }
  .cruise-auth__row:hover{background:rgba(255,255,255,.05);}
  .cruise-auth__row:active{transform:scale(.99);}
  .cruise-auth__row-ico{
    width:36px;
    height:36px;
    border-radius:10px;
    background:rgba(232,197,71,.1);
    color:var(--ca-gold);
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
  }
  .cruise-auth__row-ico svg{width:16px;height:16px;}
  .cruise-auth__row-text{flex:1;display:flex;flex-direction:column;gap:2px;min-width:0;}
  .cruise-auth__row-text b{font-size:13px;font-weight:600;color:#fff;letter-spacing:.01em;}
  .cruise-auth__row-text small{font-size:11px;color:rgba(255,255,255,.5);font-weight:400;}
  .cruise-auth__row-chev{color:rgba(255,255,255,.35);font-size:18px;font-weight:300;transition:transform 200ms, color 200ms;}
  .cruise-auth__row:hover .cruise-auth__row-chev{color:rgba(255,255,255,.7);transform:translateX(2px);}

  /* SIGN OUT — minimalista, solo texto y borde sutil */
  .cruise-auth__signout{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    width:100%;
    padding:12px;
    background:transparent;
    border:1px solid rgba(255,100,100,.2);
    border-radius:12px;
    color:#ff7a7a;
    font-family:inherit;
    font-weight:500;
    font-size:13px;
    letter-spacing:.01em;
    cursor:pointer;
    margin-bottom:10px;
    margin-top:4px;
    transition:background 200ms, border-color 200ms, transform 160ms var(--ca-ease);
  }
  .cruise-auth__signout:hover{background:rgba(255,100,100,.05);border-color:rgba(255,100,100,.3);}
  .cruise-auth__signout:active{transform:scale(.98);}
  .cruise-auth__signout svg{width:15px;height:15px;}
  .cruise-auth__version{text-align:center;font-size:10px;color:rgba(255,255,255,.25);margin-top:2px;}

  .cruise-auth__edit-form{display:flex;flex-direction:column;gap:14px;padding:8px 0;}
  .cruise-auth__field{display:flex;flex-direction:column;gap:6px;}
  .cruise-auth__field span{font-size:12px;font-weight:600;color:var(--ca-muted);text-transform:uppercase;letter-spacing:.04em;}
  .cruise-auth__field input{padding:14px 16px;background:var(--ca-input-bg);border:1px solid var(--ca-input-border);border-radius:12px;color:#fff;font-family:inherit;font-size:16px;outline:none;transition:border-color 200ms;-webkit-text-size-adjust:100%;}
  .cruise-auth__field input:focus{border-color:var(--ca-gold);background:rgba(255,255,255,.06);}
  .cruise-auth__edit-actions{display:flex;gap:10px;margin-top:12px;}
  .cruise-auth__edit-actions .cruise-auth__btn{margin-bottom:0;}

  .cruise-auth__list{display:flex;flex-direction:column;gap:12px;padding:8px 0;}
  .cruise-auth__trip{background:var(--ca-card);border:1px solid var(--ca-border);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:8px;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:transform 160ms var(--ca-ease),border-color 200ms,box-shadow 200ms;}
  .cruise-auth__trip:hover{border-color:rgba(232,197,71,.2);box-shadow:0 4px 16px rgba(232,197,71,.06);}
  .cruise-auth__trip:active{transform:scale(.985);}
  .cruise-auth__trip-top{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ca-muted);}
  .cruise-auth__trip-fare{font-size:16px;font-weight:800;color:var(--ca-gold);}
  .cruise-auth__trip-route{display:flex;align-items:center;gap:10px;font-size:13px;color:rgba(255,255,255,.85);}
  .cruise-auth__trip-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
  .cruise-auth__trip-dot--g{background:#4CAF50;}
  .cruise-auth__trip-dot--y{background:var(--ca-gold);border-radius:3px;}
  .cruise-auth__trip-time{font-size:11px;color:var(--ca-muted);}
  .cruise-auth__trip-status{display:inline-block;padding:4px 10px;border-radius:8px;font-size:11px;font-weight:700;text-transform:uppercase;background:rgba(232,197,71,.14);color:var(--ca-gold);align-self:flex-start;letter-spacing:.03em;}
  .cruise-auth__trip-status--completed{background:rgba(76,175,80,.14);color:#4CAF50;}
  .cruise-auth__trip-status--cancelled{background:rgba(255,100,100,.12);color:#ff6b6b;}

  .cruise-auth__pm{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--ca-card);border:1px solid var(--ca-border);border-radius:14px;margin-bottom:8px;transition:transform 160ms var(--ca-ease),border-color 200ms,box-shadow 200ms;}
  .cruise-auth__pm:hover{border-color:rgba(232,197,71,.2);box-shadow:0 4px 16px rgba(232,197,71,.06);}
  .cruise-auth__pm:active{transform:scale(.98);}
  .cruise-auth__pm--empty{border-style:dashed;border-color:rgba(255,255,255,.12);background:rgba(255,255,255,.02);cursor:pointer;transition:transform 160ms var(--ca-ease),background 200ms,border-color 200ms;}
  .cruise-auth__pm--empty:hover{background:rgba(255,255,255,.04);border-color:rgba(232,197,71,.25);}
  .cruise-auth__pm--empty:active{transform:scale(.98);}
  .cruise-auth__pm-ico{width:40px;height:40px;border-radius:10px;background:rgba(232,197,71,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--ca-gold);}
  .cruise-auth__pm-brand{font-size:10px;font-weight:800;color:var(--ca-gold);letter-spacing:.05em;}
  .cruise-auth__pm-info{flex:1;min-width:0;}
  .cruise-auth__pm-type{font-size:14px;font-weight:700;color:#fff;}
  .cruise-auth__pm-sub{font-size:11px;color:var(--ca-muted);margin-top:1px;}
  .cruise-auth__pm-badge{padding:4px 10px;background:rgba(232,197,71,.14);color:var(--ca-gold);border-radius:8px;font-size:10px;font-weight:700;text-transform:uppercase;flex-shrink:0;}
  .cruise-auth__pm-add{width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,.06);border:1px dashed rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;color:var(--ca-muted);font-size:18px;flex-shrink:0;}

  .cruise-auth__empty{padding:40px 20px;text-align:center;color:var(--ca-muted);font-size:14px;}

  /* Toast */
  .cruise-auth__toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(20px);background:rgba(232,197,71,.95);color:#0a0e1a;padding:12px 20px;border-radius:999px;font-size:13px;font-weight:700;box-shadow:0 10px 30px rgba(232,197,71,.35);opacity:0;pointer-events:none;transition:opacity 300ms,transform 300ms var(--ca-ease);z-index:100;max-width:90vw;text-align:center;}
  .cruise-auth__toast.is-visible{opacity:1;transform:translateX(-50%) translateY(0);}
  .cruise-auth__toast.is-err{background:rgba(255,80,80,.95);color:#fff;box-shadow:0 10px 30px rgba(255,80,80,.3);}

  @media (max-width:480px){
    .cruise-auth__card{padding:36px 22px 22px;}
    .cruise-auth__logo{width:76px;height:76px;margin:0 auto 8px;}
    .cruise-auth__logo svg{width:34px;height:34px;}
    .cruise-auth__brand{font-size:22px;letter-spacing:.18em;margin-bottom:10px;}
    .cruise-auth__title{font-size:19px;margin-bottom:8px;}
    .cruise-auth__sub{font-size:12px;margin-bottom:18px;}
    .cruise-auth__actions{gap:8px;margin-bottom:16px;}
    .cruise-auth__btn{padding:13px;font-size:14px;}
    .cruise-auth__perks{gap:6px 12px;padding-top:12px;}
    .cruise-auth__perk{font-size:10px;}
    .cruise-auth__heading{font-size:24px;}
    .cruise-auth__heading-sub{font-size:12px;margin-bottom:18px;}
    .cruise-auth__input{padding:12px 14px;margin-bottom:8px;}
    .cruise-auth__input input{font-size:14px;}
    .cruise-auth__divider{margin:10px 0;}
    .cruise-auth__avatar{width:100px;height:100px;}
    .cruise-auth__avatar-initial{font-size:40px;}
  }
  @media (max-height:720px){
    .cruise-auth__card{padding:32px 24px 22px;}
    .cruise-auth__logo{width:70px;height:70px;margin-bottom:6px;}
    .cruise-auth__brand{font-size:20px;margin-bottom:8px;}
    .cruise-auth__title{font-size:18px;margin-bottom:6px;}
    .cruise-auth__sub{margin-bottom:14px;}
    .cruise-auth__actions{margin-bottom:12px;}
    .cruise-auth__perks{padding-top:10px;}
  }
{% endstylesheet %}

