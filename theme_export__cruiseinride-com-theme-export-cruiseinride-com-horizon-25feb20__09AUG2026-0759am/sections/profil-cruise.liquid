      '<div class="cruise-auth__input"><svg class="cruise-auth__input-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">'+(askPhone?'<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>':'<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>')+'</svg><input type="'+t+'" data-ca-wiz-c placeholder="'+ph+'" inputmode="'+t+'"></div>'+
      '<button type="button" class="cruise-auth__btn cruise-auth__btn--primary" data-ca-wiz-next disabled>Next</button>';
    var c=$('[data-ca-wiz-c]',_wizContent),btn=$('[data-ca-wiz-next]',_wizContent);
