  function _renderPassword(){
    _wizContent.innerHTML=
      '<h1 class="cruise-auth__heading">Create a password</h1>'+
      '<p class="cruise-auth__heading-sub">Must include 8+ chars, 1 number, 1 uppercase &amp; 1 special character.</p>'+
      '<div class="cruise-auth__input"><svg class="cruise-auth__input-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg><input type="password" data-ca-wiz-p1 placeholder="Password" autocomplete="new-password"></div>'+
      '<div class="cruise-auth__input"><svg class="cruise-auth__input-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg><input type="password" data-ca-wiz-p2 placeholder="Confirm password" autocomplete="new-password"></div>'+
      '<ul class="cruise-auth__rules">'+
        '<li data-rule="len">At least 8 characters</li>'+
        '<li data-rule="num">Contains a number</li>'+
        '<li data-rule="upper">An uppercase letter</li>'+
        '<li data-rule="special">A special character</li>'+
        '<li data-rule="match">Passwords match</li>'+
      '</ul>'+
      '<button type="button" class="cruise-auth__btn cruise-auth__btn--primary" data-ca-wiz-next disabled>Continue</button>';
    var p1=$('[data-ca-wiz-p1]',_wizContent),p2=$('[data-ca-wiz-p2]',_wizContent),btn=$('[data-ca-wiz-next]',_wizContent);
    function validate(){
      var v1=p1.value,v2=p2.value;
      var c={len:v1.length>=8,num:/\d/.test(v1),upper:/[A-Z]/.test(v1),special:/[!@#$%^&*()_+\-=\[\]{};:'",.<>/?\\|`~]/.test(v1),match:v1===v2&&v1.length>0};
      ['len','num','upper','special','match'].forEach(function(k){var li=_wizContent.querySelector('[data-rule="'+k+'"]');if(li) li.classList.toggle('ok',c[k]);});
      var ok=c.len&&c.num&&c.upper&&c.special&&c.match;
      btn.disabled=!ok;
    }
    p1.addEventListener('input',validate);p2.addEventListener('input',validate);
    btn.addEventListener('click',function(){if(btn.disabled)return;_wizState.password=p1.value;_wizGo(2);});
    setTimeout(function(){p1.focus();},300);
  }

  function _renderName(){
    _wizContent.innerHTML=
      '<h1 class="cruise-auth__heading">What\'s your name?</h1>'+
      '<p class="cruise-auth__heading-sub">Your driver will see your first name.</p>'+
      '<div class="cruise-auth__input"><svg class="cruise-auth__input-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/></svg><input type="text" data-ca-wiz-fn placeholder="First name" autocomplete="given-name"></div>'+
      '<div class="cruise-auth__input"><svg class="cruise-auth__input-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/></svg><input type="text" data-ca-wiz-ln placeholder="Last name" autocomplete="family-name"></div>'+
      '<button type="button" class="cruise-auth__btn cruise-auth__btn--primary" data-ca-wiz-next disabled>Next</button>';
    var fn=$('[data-ca-wiz-fn]',_wizContent),ln=$('[data-ca-wiz-ln]',_wizContent),btn=$('[data-ca-wiz-next]',_wizContent);
    fn.value=_wizState.firstName;ln.value=_wizState.lastName;
