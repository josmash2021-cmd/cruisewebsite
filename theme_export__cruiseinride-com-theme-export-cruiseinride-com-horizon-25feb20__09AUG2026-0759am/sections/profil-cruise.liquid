  function _renderPhoto(){
    _wizContent.innerHTML=
      '<h1 class="cruise-auth__heading">Add a photo</h1>'+
      '<p class="cruise-auth__heading-sub">Help your driver recognize you.</p>'+
      '<div class="cruise-auth__photo-circle" data-ca-wiz-preview>'+
        (_wizState.photoDataUrl?'<img src="'+_wizState.photoDataUrl+'" alt="">':'<svg width="56" height="56" viewBox="0 0 24 24" fill="rgba(232,197,71,.85)"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>')+
      '</div>'+
      '<input type="file" accept="image/*" data-ca-wiz-file style="display:none">'+
