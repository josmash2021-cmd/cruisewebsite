.vR-toast.is-in{opacity:1;transform:translateY(0) scale(1)}
.vR-toast.is-out{opacity:0;transform:translateY(-6px) scale(.96)}
.vR-toast--err{border-color:rgba(255,90,90,.35);background:rgba(45,18,18,.92);box-shadow:0 8px 30px rgba(180,0,0,.35),inset 0 1px 0 rgba(255,255,255,.08)}
.vR-toast--ok{border-color:rgba(232,197,71,.4);background:rgba(30,26,10,.92);color:#E8C547;box-shadow:0 8px 30px rgba(232,197,71,.25),inset 0 1px 0 rgba(255,255,255,.08)}
</style>
{% render 'ride-request-core' %}
<style>
/* Failsafe: ensure sheet and root are visible even if JS/Mapbox fails to init */
.vipRide{animation-fill-mode:forwards!important}
@media(prefers-reduced-motion:no-preference){
  .vipRide__sheet{animation-fill-mode:forwards!important}
}
</style>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script type="text/javascript" src="https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js" async defer></script>
<script src="https://cdn.shopify.com/s/files/1/0805/8640/8191/files/vip-ride-auth_52500dbd-dd5d-4d3b-9cef-a0d87b22c818.js?v=1775879249" defer></script>
