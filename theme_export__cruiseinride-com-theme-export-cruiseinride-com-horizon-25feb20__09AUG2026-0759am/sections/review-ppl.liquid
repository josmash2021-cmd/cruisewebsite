{% comment %}
  ============================================
  REVIEWS MARQUEE - 50 Reviews
  Partial stars (4.5, 4.7, 4.8, 4.9)
  Full width breakout, product photo, product link
  ============================================
{% endcomment %}

<style>
  .reviews-marquee-section {
    --rm-bg: {{ section.settings.bg_color }};
    --rm-text: {{ section.settings.text_color }};
    --rm-accent: {{ section.settings.accent_color }};
    --rm-card-bg: {{ section.settings.card_bg }};
    --rm-star-color: {{ section.settings.star_color }};
    --rm-border: {{ section.settings.border_color }};
    --rm-glow: {{ section.settings.accent_color | append: '20' }};
    --rm-glow-strong: {{ section.settings.accent_color | append: '35' }};
    --rm-speed: {{ section.settings.marquee_speed }}s;
    --rm-padding-top: {{ section.settings.padding_top }}px;
    --rm-padding-bottom: {{ section.settings.padding_bottom }}px;

    background: var(--rm-bg);
    padding: var(--rm-padding-top) 0 var(--rm-padding-bottom);
    min-height: 100vh;
    overflow: hidden;
    position: relative;
    font-family: inherit;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }

  .reviews-marquee-section::before,
  .reviews-marquee-section::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 80px;
    z-index: 10;
    pointer-events: none;
  }

  .reviews-marquee-section::before {
    top: 0;
    background: linear-gradient(to bottom, var(--rm-bg) 0%, transparent 100%);
  }

  .reviews-marquee-section::after {
    bottom: 0;
    background: linear-gradient(to top, var(--rm-bg) 0%, transparent 100%);
  }

  .rm-header-inner { text-align: center; padding: 0 20px; }
  .rm-stats-inner { text-align: center; padding: 0 20px; }

  .rm-header {
    text-align: center;
    margin: 0 auto 32px;
    position: relative;
    z-index: 5;
    flex-shrink: 0;
  }

  .rm-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--rm-glow);
    border: 1px solid var(--rm-border);
    border-radius: 100px;
    padding: 7px 18px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--rm-accent);
    margin-bottom: 16px;
  }

  .rm-badge svg { width: 14px; height: 14px; }

  .rm-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    color: var(--rm-text);
    margin: 0 0 12px 0;
    line-height: 1.15;
    letter-spacing: -0.5px;
  }

  .rm-subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    color: var(--rm-text);
    opacity: 0.55;
    margin: 0 auto;
    max-width: 480px;
    line-height: 1.55;
  }

  .rm-marquee-wrapper {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
  }

  .rm-row {
    display: flex;
    width: max-content;
    will-change: transform;
    flex-shrink: 0;
    margin: 0 auto;
  }

  .rm-row--left { animation: rm-scroll-left var(--rm-speed) linear infinite; }
  .rm-row--right { animation: rm-scroll-right var(--rm-speed) linear infinite; }

  .rm-card {
    flex-shrink: 0;
    width: 300px;
    margin: 0 10px;
    background: var(--rm-card-bg);
    border: 1px solid var(--rm-border);
    border-radius: 22px;
    padding: 20px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    pointer-events: none !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    position: relative;
    overflow: hidden;
  }

  .rm-card::before {
    content: '';
    position: absolute;
    top: -60%;
    right: -60%;
    width: 220%;
    height: 220%;
    background: radial-gradient(circle at 70% 20%, var(--rm-glow-strong) 0%, transparent 55%);
    opacity: 0.4;
    pointer-events: none;
  }

  .rm-reviewer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    position: relative;
    z-index: 1;
  }

  .rm-avatar-small {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--rm-border);
    flex-shrink: 0;
  }

  .rm-avatar-placeholder {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--rm-glow);
    border: 1.5px solid var(--rm-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    color: var(--rm-accent);
    flex-shrink: 0;
  }

  .rm-reviewer-info { min-width: 0; }

  .rm-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--rm-text);
    margin: 0 0 2px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .rm-verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--rm-accent);
    font-weight: 600;
    opacity: 0.9;
  }

  .rm-verified svg { width: 12px; height: 12px; }

  .rm-stars {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }

  .rm-rating-num {
    font-size: 13px;
    font-weight: 700;
    color: var(--rm-star-color);
    margin-left: 6px;
    line-height: 1;
    flex-shrink: 0;
  }

  .rm-star {
    width: 16px;
    height: 16px;
    color: var(--rm-star-color);
    fill: var(--rm-star-color);
    flex-shrink: 0;
  }

  .rm-star--empty {
    color: var(--rm-border);
    fill: none;
    stroke: var(--rm-border);
    stroke-width: 1.5;
  }

  .rm-star--partial-wrap {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .rm-star--partial-wrap .rm-star-bg {
    position: absolute;
    inset: 0;
    color: var(--rm-border);
    fill: none;
    stroke: var(--rm-border);
    stroke-width: 1.5;
  }

  .rm-star--partial-wrap .rm-star-fill {
    position: absolute;
    inset: 0;
    color: var(--rm-star-color);
    fill: var(--rm-star-color);
    overflow: hidden;
  }

  .rm-star--partial-wrap .rm-star-fill svg {
    width: 16px;
    height: 16px;
  }

  .rm-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--rm-text);
    opacity: 0.7;
    margin: 0 0 14px 0;
    position: relative;
    z-index: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rm-product-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--rm-glow);
    border: 1px solid var(--rm-border);
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--rm-accent);
    position: relative;
    z-index: 1;
  }

  .rm-product-tag svg { width: 12px; height: 12px; }

  /* ===== PRODUCT LINK (clickable) ===== */
  a.rm-product-link {
    pointer-events: auto !important;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  a.rm-product-link:hover {
    background: var(--rm-glow-strong);
    border-color: var(--rm-accent);
    transform: translateY(-1px);
  }

  .rm-stats {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 32px;
    position: relative;
    z-index: 5;
    flex-shrink: 0;
  }

  .rm-stat { text-align: center; }

  .rm-stat-value {
    font-size: 28px;
    font-weight: 800;
    color: var(--rm-text);
    line-height: 1;
    margin-bottom: 4px;
  }

  .rm-stat-label {
    font-size: 12px;
    color: var(--rm-text);
    opacity: 0.45;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  @keyframes rm-scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 1024px) {
    .rm-card { width: 280px; margin: 0 8px; padding: 18px; }

  }

  @media (max-width: 768px) {
    .reviews-marquee-section {
      --rm-padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      --rm-padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
      padding: var(--rm-padding-top) 0 var(--rm-padding-bottom);
      min-height: 100dvh;
    }
    .rm-header-inner, .rm-stats-inner { padding: 0 16px; }
    .rm-header { margin: 0 auto 20px; }
    .rm-badge { font-size: 10px; padding: 6px 14px; letter-spacing: 1px; }
    .rm-title { font-size: {{ section.settings.title_size | times: 0.55 | round }}px !important; letter-spacing: -0.3px; }
    .rm-subtitle { font-size: {{ section.settings.subtitle_size | times: 0.78 | round }}px !important; max-width: 90%; line-height: 1.5; }
    .rm-card { width: 260px; margin: 0 8px; padding: 16px; border-radius: 18px; }

    .rm-reviewer { gap: 8px; margin-bottom: 8px; }
    .rm-avatar-small, .rm-avatar-placeholder { width: 28px; height: 28px; font-size: 10px; }
    .rm-name { font-size: 14px; }
    .rm-verified { font-size: 10px; }
    .rm-verified svg { width: 10px; height: 10px; }
    .rm-stars { gap: 2px; margin-bottom: 10px; }
    .rm-star, .rm-star--partial-wrap { width: 14px; height: 14px; }
    .rm-star--partial-wrap .rm-star-fill svg { width: 14px; height: 14px; }
    .rm-rating-num { font-size: 12px; margin-left: 5px; }
    .rm-text { font-size: 13px; line-height: 1.55; margin-bottom: 12px; -webkit-line-clamp: 3; }
    .rm-product-tag { font-size: 11px; padding: 4px 10px; border-radius: 6px; }
    a.rm-product-link:hover { transform: none; }
    .rm-stats { gap: 28px; margin-top: 20px; }
    .rm-stat-value { font-size: 24px; }
    .rm-stat-label { font-size: 10px; letter-spacing: 0.8px; }
    .reviews-marquee-section::before, .reviews-marquee-section::after { height: 50px; }
  }

  @media (max-width: 380px) {
    .rm-card { width: 240px; padding: 14px; }

  }

  @media (prefers-reduced-motion: reduce) {
    .rm-row--left { animation-play-state: paused; }
  }
</style>

<section class="reviews-marquee-section" id="rm-section-{{ section.id }}">
  <div class="rm-header-inner">
    <div class="rm-header">
      {% if section.settings.show_badge %}
        <div class="rm-badge">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          {{ section.settings.badge_text }}
        </div>
      {% endif %}
      <h2 class="rm-title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="rm-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  </div>

  <div class="rm-marquee-wrapper">
    {% for row in (1..1) %}
      <div class="rm-row rm-row--left">
        {% for block in section.blocks %}
          {% assign rating = block.settings.rating %}
          {% assign rating_int = rating | times: 10 %}
          {% assign first_name = block.settings.first_name %}
          {% assign last_name = block.settings.last_name %}
          {% assign last_initial = last_name | slice: 0 %}
          {% assign display_name = first_name | append: ' ' | append: last_initial | append: '.' %}
          {% assign initials = first_name | slice: 0 | append: last_initial %}
          <div class="rm-card" {{ block.shopify_attributes }}>

            <div class="rm-reviewer">
              {% if block.settings.avatar != blank %}
                <img
                  src="{{ block.settings.avatar | image_url: width: 64, height: 64, crop: 'center' }}"
                  alt="{{ display_name }}"
                  class="rm-avatar-small"
                  loading="lazy"
                  width="32"
                  height="32"
                >
              {% else %}
                <span class="rm-avatar-placeholder">{{ initials }}</span>
              {% endif %}

              <div class="rm-reviewer-info">
                <h4 class="rm-name">{{ display_name }}</h4>
                {% if block.settings.show_verified %}
                  <span class="rm-verified">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                    {{ section.settings.verified_text }}
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="rm-stars">
              {% assign rd = rating_int %}
              {% for si in (1..5) %}
                {% assign s_full = si | times: 10 %}
                {% assign s_prev = si | minus: 1 | times: 10 %}
                {% if rd >= s_full %}
                  <svg class="rm-star" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% elsif rd > s_prev %}
                  {% assign s_pct = rd | minus: s_prev | times: 10 %}
                  <span class="rm-star--partial-wrap">
                    <svg class="rm-star-bg" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <span class="rm-star-fill" style="width: {{ s_pct }}%;">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    </span>
                  </span>
                {% else %}
                  <svg class="rm-star rm-star--empty" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endif %}
              {% endfor %}
              <span class="rm-rating-num">{{ block.settings.rating }}</span>
            </div>

            <p class="rm-text">{{ block.settings.review }}</p>

            {% assign product_obj = block.settings.product %}
            {% assign tag_label = product_obj.title | default: block.settings.product_name %}
            {% if tag_label != blank %}
              {% if product_obj != blank and product_obj.url != blank %}
                <a href="{{ product_obj.url }}" class="rm-product-tag rm-product-link">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 01-8 0"/>
                  </svg>
                  {{ tag_label }}
                </a>
              {% else %}
                <span class="rm-product-tag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 01-8 0"/>
                  </svg>
                  {{ tag_label }}
                </span>
              {% endif %}
            {% endif %}
          </div>
        {% endfor %}

        {% for block in section.blocks %}
          {% assign rating = block.settings.rating %}
          {% assign rating_int = rating | times: 10 %}
          {% assign first_name = block.settings.first_name %}
          {% assign last_name = block.settings.last_name %}
          {% assign last_initial = last_name | slice: 0 %}
          {% assign display_name = first_name | append: ' ' | append: last_initial | append: '.' %}
          {% assign initials = first_name | slice: 0 | append: last_initial %}
          <div class="rm-card" aria-hidden="true">

            <div class="rm-reviewer">
              {% if block.settings.avatar != blank %}
                <img
                  src="{{ block.settings.avatar | image_url: width: 64, height: 64, crop: 'center' }}"
                  alt="{{ display_name }}"
                  class="rm-avatar-small"
                  loading="lazy"
                  width="32"
                  height="32"
                >
              {% else %}
                <span class="rm-avatar-placeholder">{{ initials }}</span>
              {% endif %}

              <div class="rm-reviewer-info">
                <h4 class="rm-name">{{ display_name }}</h4>
                {% if block.settings.show_verified %}
                  <span class="rm-verified">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                    {{ section.settings.verified_text }}
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="rm-stars">
              {% assign rd = rating_int %}
              {% for si in (1..5) %}
                {% assign s_full = si | times: 10 %}
                {% assign s_prev = si | minus: 1 | times: 10 %}
                {% if rd >= s_full %}
                  <svg class="rm-star" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% elsif rd > s_prev %}
                  {% assign s_pct = rd | minus: s_prev | times: 10 %}
                  <span class="rm-star--partial-wrap">
                    <svg class="rm-star-bg" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <span class="rm-star-fill" style="width: {{ s_pct }}%;">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    </span>
                  </span>
                {% else %}
                  <svg class="rm-star rm-star--empty" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endif %}
              {% endfor %}
              <span class="rm-rating-num">{{ block.settings.rating }}</span>
            </div>

            <p class="rm-text">{{ block.settings.review }}</p>

            {% assign product_obj = block.settings.product %}
            {% assign tag_label = product_obj.title | default: block.settings.product_name %}
            {% if tag_label != blank %}
              {% if product_obj != blank and product_obj.url != blank %}
                <a href="{{ product_obj.url }}" class="rm-product-tag rm-product-link">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 01-8 0"/>
                  </svg>
                  {{ tag_label }}
                </a>
              {% else %}
                <span class="rm-product-tag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 01-8 0"/>
                  </svg>
                  {{ tag_label }}
                </span>
              {% endif %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>

  {% if section.settings.show_stats %}
    <div class="rm-stats-inner">
      <div class="rm-stats">
        <div class="rm-stat">
          <div class="rm-stat-value">{{ section.settings.stat_reviews_number }}{% if section.settings.show_plus_sign %}+{% endif %}</div>
          <div class="rm-stat-label">{{ section.settings.stat_reviews_label }}</div>
        </div>
        <div class="rm-stat">
          <div class="rm-stat-value">{{ section.settings.stat_rating }}</div>
          <div class="rm-stat-label">{{ section.settings.stat_rating_label }}</div>
        </div>
        <div class="rm-stat">
          <div class="rm-stat-value">{{ section.settings.stat_customers }}</div>
          <div class="rm-stat-label">{{ section.settings.stat_customers_label }}</div>
        </div>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Reviews Marquee",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Thousands of people trust us every day"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Verified Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show statistics",
      "default": true
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Verified text",
      "default": "Verified Purchase"
    },
    {
      "type": "header",
      "content": "Statistics"
    },
    {
      "type": "text",
      "id": "stat_reviews_number",
      "label": "Reviews number",
      "default": "50",
      "info": "Number shown before the '+' in the first stat"
    },
    {
      "type": "checkbox",
