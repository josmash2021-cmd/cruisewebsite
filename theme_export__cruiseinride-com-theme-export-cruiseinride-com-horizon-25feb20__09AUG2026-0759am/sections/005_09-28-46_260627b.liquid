@keyframes vRlG{0%,42%,100%{opacity:0;transform:scale(.6)}50%,92%{opacity:1;transform:scale(1)}}
.vR-app__endCTA__label{font-family:"Playfair Display",Georgia,serif;font-weight:800;font-size:clamp(16px,5vw,22px);color:#fff;text-align:center;line-height:.95;letter-spacing:.02em;text-shadow:0 2px 10px rgba(0,0,0,.6)}
