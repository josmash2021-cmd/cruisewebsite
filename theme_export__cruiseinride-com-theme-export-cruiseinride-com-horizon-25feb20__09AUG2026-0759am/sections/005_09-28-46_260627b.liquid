.vipRide__authInput{position:relative;margin-bottom:14px}
.vipRide__authInput__icon{position:absolute;left:16px;top:50%;transform:translateY(-50%);pointer-events:none;z-index:1}
.vipRide__authInput__field{width:100%;height:52px;background:#1a1d26!important;border:1.5px solid rgba(255,255,255,.08);border-radius:14px;color:#fff!important;font-size:15px;font-family:inherit;padding:0 16px;transition:border-color .2s,background .2s;-webkit-appearance:none;appearance:none;box-sizing:border-box}
.vipRide__authInput__field:focus{outline:none;border-color:rgba(232,197,71,.45);background:#1f222d!important}
.vipRide__authInput__field::placeholder{color:rgba(255,255,255,.3)}
.vipRide__authInput .vipRide__authInput__icon~.vipRide__authInput__field{padding-left:46px}
.vipRide__authBtn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;height:52px;border-radius:14px;border:none;cursor:pointer;font-size:15px;font-weight:600;font-family:inherit;transition:opacity .15s,transform .1s;-webkit-appearance:none;appearance:none;box-sizing:border-box;}
.vipRide__authBtn:active{opacity:.8;transform:scale(.98);}
.vipRide__authBtn--primary{background:linear-gradient(135deg,#E8C547,#d4a017);color:#0a0e1a;margin-bottom:6px;}
.vipRide__authBtn--dark{background:rgba(255,255,255,.1);color:#fff;margin-bottom:6px}
.vipRide__authBtn--outline{background:#1a1d26;color:#fff;border:1.5px solid rgba(255,255,255,.08);margin-bottom:10px}
.vipRide__authBtn--gold{background:transparent;color:#E8C547;border:1.5px solid rgba(232,197,71,.35)}
.vipRide__authBtn--ghost{background:rgba(255,255,255,.04);color:rgba(255,255,255,.75);border:1px solid rgba(255,255,255,.1)}
.vipRide__authGate__divider{display:flex;align-items:center;gap:12px;margin:20px 0 12px;color:rgba(255,255,255,.3);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}
.vipRide__authGate__divider::before,.vipRide__authGate__divider::after,.vipRide__authDivider::before,.vipRide__authDivider::after{content:'';flex:1;height:1px;background:rgba(255,255,255,.08)}
.vipRide__authBtn--icon svg{flex-shrink:0}
.vipRide__authDivider{display:flex;align-items:center;gap:14px;margin:16px 0}
.vipRide__authDivider span{font-size:12px;color:rgba(255,255,255,.3);font-weight:600;letter-spacing:.5px}
.vipRide__authTerms{text-align:center;font-size:clamp(11px,3vw,12px);color:rgba(255,255,255,.35);margin-top:28px;line-height:1.6}
.vipRide__authTerms a{color:rgba(232,197,71,.7);text-decoration:underline}
.vipRide__authError{margin-top:12px;padding:12px 16px;background:rgba(255,80,80,.1);border:1px solid rgba(255,80,80,.2);border-radius:12px;color:#ff6b6b;font-size:13px;text-align:center}
.vipRide__authBtn.is-loading{pointer-events:none;opacity:.6;position:relative;color:transparent}
.vipRide__authBtn.is-loading::after{content:'';position:absolute;width:22px;height:22px;border:2.5px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:vipAuthSpin .6s linear infinite}
@keyframes vipAuthSpin{to{transform:rotate(360deg)}}
.vR-toastHost{position:fixed;left:50%;bottom:calc(28px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:100000;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none}
.vR-toast{max-width:min(88vw,360px);padding:13px 20px;border-radius:14px;background:rgba(22,24,32,.92);-webkit-backdrop-filter:blur(20px) saturate(180%);backdrop-filter:blur(20px) saturate(180%);border:1px solid rgba(255,255,255,.1);color:#fff;font:600 14px/1.35 -apple-system,'Inter','Poppins',system-ui,sans-serif;text-align:center;box-shadow:0 8px 30px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.06);opacity:0;transform:translateY(20px) scale(.92);transition:opacity .32s cubic-bezier(.22,1,.36,1),transform .4s cubic-bezier(.22,1,.36,1);pointer-events:auto}
.vR-toast.is-in{opacity:1;transform:translateY(0) scale(1)}
.vR-toast.is-out{opacity:0;transform:translateY(-8px) scale(.95)}
.vR-toast--err{border-color:rgba(255,90,90,.35);background:rgba(45,18,18,.92);box-shadow:0 8px 30px rgba(180,0,0,.35),inset 0 1px 0 rgba(255,255,255,.08)}
.vR-toast--ok{border-color:rgba(232,197,71,.4);background:rgba(30,26,10,.92);color:#E8C547;box-shadow:0 8px 30px rgba(232,197,71,.25),inset 0 1px 0 rgba(255,255,255,.08)}
</style>

<script>
(function(){
  'use strict';
  var _vrLS={get:function(k){try{return localStorage.getItem(k);}catch(_){return null;}},set:function(k,v){try{localStorage.setItem(k,v);}catch(_){}},del:function(k){try{localStorage.removeItem(k);}catch(_){}}};

  var _vrOvs={};
  function _vrSh(){return document.querySelector('[data-vipride-sheet]');}
  function _vrSheetHide(id){_vrOvs[id||'_']=1;var s=_vrSh();if(s)s.classList.add('is-test-hidden');}
  function _vrSheetShow(id){delete _vrOvs[id||'_'];for(var k in _vrOvs)return;var s=_vrSh();if(s)s.classList.remove('is-test-hidden');}
  function _vrSheetReset(){_vrOvs={};var s=_vrSh();if(s)s.classList.remove('is-test-hidden');}
  window.addEventListener('error',function(e){try{console.warn('[VIP Ride error]',e.message||e)}catch(_){}},true);
  window.addEventListener('unhandledrejection',function(e){try{console.warn('[VIP Ride promise rejected]',e.reason)}catch(_){}});
  var _vrN8n='{{ section.settings.n8n_webhook_url | default: "" | escape }}';
  var _vrSessionId=(function(){var s=_vrLS.get('vr_sid');if(!s){s=Date.now().toString(36)+Math.random().toString(36).slice(2,8);_vrLS.set('vr_sid',s);}return s;})();
  function _vrTrack(ev,props){
    if(!_vrN8n||!ev)return;
    try{
      var body={event:ev,session_id:_vrSessionId,ts:Date.now(),url:location.href,props:props||{}};
      if(navigator.sendBeacon)navigator.sendBeacon(_vrN8n,new Blob([JSON.stringify(body)],{type:'application/json'}));
      else fetch(_vrN8n,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body),keepalive:true}).catch(function(){});
    }catch(_){}
  }
  window.__vipTrack=_vrTrack;

  var _vrCart={key:'vr_cart_draft',ttl:864e5,
    save:function(data){try{_vrLS.set(this.key,JSON.stringify({data:data,ts:Date.now()}))}catch(_){}},
    load:function(){try{var raw=_vrLS.get(this.key);if(!raw)return null;var o=JSON.parse(raw);if(!o||!o.ts||Date.now()-o.ts>this.ttl){this.clear();return null;}return o.data;}catch(_){return null;}},
    clear:function(){_vrLS.del(this.key)}};
  function _vrToast(msg,type){
    if(!msg)return;
    var host=document.querySelector('.vR-toastHost');
    if(!host){host=document.createElement('div');host.className='vR-toastHost';document.body.appendChild(host);}
    var t=document.createElement('div');t.className='vR-toast'+(type?' vR-toast--'+type:'');t.textContent=String(msg);host.appendChild(t);
    requestAnimationFrame(function(){t.classList.add('is-in')});
    setTimeout(function(){t.classList.remove('is-in');t.classList.add('is-out');setTimeout(function(){if(t.parentNode)t.parentNode.removeChild(t)},400)},3200);
  }
  window.__vipToast=_vrToast;
  function __vipCheckReturn(){if(_vrLS.get('vip_booking_sent')!=='1')return;_vrLS.del('vip_booking_sent');document.body.style.transition='opacity .4s ease';document.body.style.opacity='0';setTimeout(function(){window.location.href='/'},420);}
  __vipCheckReturn();
  window.addEventListener('pageshow',function(e){if(e.persisted)__vipCheckReturn()});
  window.addEventListener('visibilitychange',function(){if(!document.hidden)__vipCheckReturn()});

  var root=document.getElementById('vipRide-{{ section.id }}');
  if(!root) return;
  _vrTrack('booking_start',{page:location.pathname});

  var MAPBOX_TOKEN='{{ section.settings.mapbox_access_token | escape }}';
  var MIN_HOURS={{ section.settings.min_hours | default: 3 }};
  var MAX_HOURS={{ section.settings.max_hours | default: 12 }};
  var DEFAULT_HOURS={{ section.settings.default_hours | default: 4 }};
  var SLOT_STEP_M=60;
  var defaultLat=parseFloat('{{ section.settings.default_lat | default: "33.5207" }}')||33.5207;
  var defaultLng=parseFloat('{{ section.settings.default_lng | default: "-86.8025" }}')||-86.8025;
  var defaultZoom=parseInt('{{ section.settings.default_zoom | default: 16 }}',10)||16;
  var VEHICLE_VARIANTS=window.__VIP_VEHICLE_VARIANTS__||{};

  function escapeHtml(s){ if(!s) return ''; var d=document.createElement('div'); d.appendChild(document.createTextNode(s)); return d.innerHTML; }

  var currentLang=window.__vrLang||'en';
  function detectLanguage(){return window.__vrLang||'en';}
  function t(k,rep){return window.__vrT?window.__vrT(k,rep,currentLang):k;}
  function setLanguage(l){currentLang=l==='es'?'es':'en';if(window.__vrLang)window.__vrLang=currentLang;updateUIText();}

  var modeBtns=Array.from(root.querySelectorAll('[data-vipride-mode-btn]'));
  var currentMode='ride';
  var pickupEl=root.querySelector('[data-vipride-pickup]');
  var dropoffEl=root.querySelector('[data-vipride-dropoff]');
  var dropoffField=root.querySelector('[data-vipride-dropoff-field]');
  var hoursField=root.querySelector('[data-vipride-hours-field]');
  var hoursValueEl=root.querySelector('[data-vipride-hours-value]');
  var hoursInput=root.querySelector('[data-vipride-hours-input]');
  var hoursMinusBtn=root.querySelector('[data-vipride-hours-minus]');
  var hoursPlusBtn=root.querySelector('[data-vipride-hours-plus]');
  var pickupLabel=root.querySelector('[data-vipride-pickup-label]');
  var dateEl=root.querySelector('[data-vipride-date]');
  var timeEl=root.querySelector('[data-vipride-time]');
  var timeTrigger=root.querySelector('[data-vipride-time-trigger]');
  var slotDisplay=root.querySelector('[data-vipride-slot-display]');
  var slotPicker=root.querySelector('[data-vipride-slotpicker]');
  var slotHint=root.querySelector('[data-vipride-slot-hint]');
  var clearBtns=root.querySelectorAll('[data-vipride-clear]');
  var pricesTitle=root.querySelector('[data-vipride-prices-title]');
  var routeEstimate=root.querySelector('[data-vipride-route-estimate]');
  var routeTimeText=root.querySelector('[data-vipride-route-time]');
  var routeDistText=root.querySelector('[data-vipride-route-dist]');
  var cards=Array.from(root.querySelectorAll('[data-vipride-card]'));
  var bookingVariant=root.querySelector('[data-vipride-booking-variant]');
  var ctaBtn=root.querySelector('[data-vipride-cta]');
  var checkoutBtn=root.querySelector('[data-vipride-checkout]');
  var hint=root.querySelector('[data-vipride-hint]');
  var form=root.querySelector('[data-vipride-form]');
  var propBookingType=root.querySelector('[data-vipride-prop="bookingType"]');
  var propPickup=root.querySelector('[data-vipride-prop="pickup"]');
  var propDropoff=root.querySelector('[data-vipride-prop="dropoff"]');
  var propHours=root.querySelector('[data-vipride-prop="hours"]');
  var propDate=root.querySelector('[data-vipride-prop="date"]');
  var propTime=root.querySelector('[data-vipride-prop="time"]');
  var propVehicle=root.querySelector('[data-vipride-prop="vehicle"]');
  var propPrice=root.querySelector('[data-vipride-prop="price"]');
  var timeField=root.querySelector('[data-vipride-time-field]');
  var step1NextBtn=root.querySelector('[data-vipride-step1-next]');
  var stepBackBtn=root.querySelector('[data-vipride-step-back]');
  var stepBack2Btn=root.querySelector('[data-vipride-step-back2]');
  var sheet=root.querySelector('[data-vipride-sheet]');

  if(!pickupEl||!dateEl||!timeEl) return;

  var currentStep=1;
  var map,pickupMarker=null,dropoffMarker=null;
  var pickupPlace=null,dropoffPlace=null;
  var routeDurationSec=null,selectedRide=null;
  var routeReq=0,accordionOpen=false,currentHours=DEFAULT_HOURS;
  var _mapLocked=false,_savedCenter,_savedZoom;
  var _fitTiltHandler=function(){},_fitRotateHandler=function(){};
  var ALL_BOOKED=Array.isArray(window.__VIP_BOOKED_SLOTS__)?window.__VIP_BOOKED_SLOTS__:[];
  var _pickupManuallySet=false,_lastGeoLat=null,_lastGeoLng=null;
  var _gpsActive=false;
  var _gpsPinMarker=null;

  var _mbErrAt=0;
  function _mbErr(es,en){var n=Date.now();if(n-_mbErrAt<8e3)return;_mbErrAt=n;_vrToast&&_vrToast(currentLang==='es'?es:en,'err');}
  function reverseGeocode(lat,lng,cb){
    fetch('https://api.mapbox.com/geocoding/v5/mapbox.places/'+lng+','+lat+'.json?access_token='+encodeURIComponent(MAPBOX_TOKEN)+'&limit=1&language='+(currentLang==='es'?'es':'en'))
      .then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(d){var f=d.features&&d.features[0];if(!f){cb(null);return;}var st=window.__vrExtractState&&window.__vrExtractState(f);if(st&&window.__vrSvcOk&&!window.__vrSvcOk(st)){window.__vrSvcBlockShow&&window.__vrSvcBlockShow(st,currentLang);cb(null);return;}cb(f.place_name);}).catch(function(){_mbErr('No ubicamos esa dirección','Address not found');cb(null);});
  }

  function pad2(n){ return String(n).padStart(2,'0'); }
  function toHHMM(d){ return pad2(d.getHours())+':'+pad2(d.getMinutes()); }
  function roundUpToStep(d,s){ var r=new Date(d); r.setSeconds(0,0); var m=r.getMinutes()%s; if(m) r.setMinutes(r.getMinutes()+(s-m)); return r; }
  function moneyUSD(n){ return Math.max(0,Number(n)||0).toLocaleString('en-US',{style:'currency',currency:'USD'}); }
  function formatMinutes(sec){ var m=Math.max(1,Math.round((Number(sec)||0)/60)); return m<60?m+' min':Math.floor(m/60)+' hr '+(m%60)+' min'; }
  function lockMap(){ if(!map||_mapLocked) return; _mapLocked=true; _savedCenter=map.getCenter(); _savedZoom=map.getZoom(); }
  function unlockMap(){ _mapLocked=false; }

  function updateUIText(){
    if(pickupLabel) pickupLabel.textContent=currentMode==='hourly'?t('serviceLocationLabel'):t('pickupLabel');
    var dfl=root.querySelector('[data-vipride-dropoff-field] .vipRide__label');
    if(dfl) dfl.textContent=t('dropoffLabel');
    var dateLbl=root.querySelector('label[for="vipDate-{{ section.id }}"]');
    if(dateLbl) dateLbl.textContent=t('dateLabel');
    var timeLbl=root.querySelector('[data-vipride-time-field] .vipRide__label');
    if(timeLbl) timeLbl.textContent=t('timeLabel');
    if(step1NextBtn) step1NextBtn.textContent=t('continue')+' ›';
    var sbl=root.querySelector('[data-vipride-stepback-label]'); if(sbl) sbl.textContent=t('changeLocation');
    var sb2l=root.querySelector('[data-vipride-stepback2-label]'); if(sb2l) sb2l.textContent=t('changeLocation');
    var sht=root.querySelector('[data-vipride-slot-hint]'); if(sht) sht.textContent=t('chooseDateFirst');
    var sdp=root.querySelector('[data-vipride-slot-display]'); if(sdp&&!timeEl.value) sdp.textContent=t('selectTimeSlot');
    modeBtns.forEach(function(b){ var m=b.getAttribute('data-mode'); if(m==='ride') b.textContent=t('pointToPoint'); if(m==='hourly') b.textContent=t('byTheHour'); });
    var hh=root.querySelector('[data-vipride-hours-hint]'); if(hh) hh.textContent=t('hoursHint',{min:MIN_HOURS,max:MAX_HOURS});
    var hu=root.querySelector('[data-vipride-hours-unit]'); if(hu) hu.textContent=t('hours');
    var hl=root.querySelector('[data-vipride-hours-field] .vipRide__label'); if(hl) hl.textContent=t('hoursLabel2');
    if(ctaBtn&&!selectedRide) ctaBtn.textContent=t('requestNow');
    if(checkoutBtn&&!selectedRide) checkoutBtn.textContent=t('checkout');
    if(hint) hint.textContent=t('ctaHint');
    if(pricesTitle) pricesTitle.textContent=currentMode==='hourly'?t('chooseHourly'):t('chooseRide');
    if(dateEl.value) buildSlotPicker(dateEl.value);
  }

  function goToStep(n,dir){
    var prev=root.querySelector('[data-vipride-step-panel="'+currentStep+'"]');
    var next=root.querySelector('[data-vipride-step-panel="'+n+'"]');
    if(!next||n===currentStep) return;
    _vrSheetReset();
    var ec=dir==='back'?'is-entering-back':'is-entering';
    var prevStep=currentStep;
    currentStep=n;
    if(sheet) sheet.setAttribute('data-vipride-step',String(n));
    updateStepDots(); closeSuggestions();

    var youLabels=document.querySelectorAll('.vipRide__youLabel');
    youLabels.forEach(function(l){ l.style.display=(n===1)?'':'none'; });

    var mapBackBtn=root.querySelector('[data-vipride-map-back]');
    if(mapBackBtn){ mapBackBtn.hidden=(n!==3); }
    if(prev){
      var exitCls=dir==='back'?'is-exiting-back':'is-exiting';
      prev.classList.add(exitCls);
      setTimeout(function(){
        prev.hidden=true; prev.classList.remove(exitCls,'is-entering','is-entering-back');
        next.hidden=false; next.classList.remove('is-entering','is-entering-back');
        void next.offsetWidth; next.classList.add(ec);
        if(sheet) sheet.scrollTop=0;
      },320);
    } else {
      next.hidden=false; next.classList.remove('is-entering','is-entering-back');
      void next.offsetWidth; next.classList.add(ec);
    }

    if(n===3&&dir==='forward'){
      _expandAllCards(); cards.forEach(function(c){c.classList.remove('is-active');}); selectedRide=null; validateCTA(null);

      if(!dateEl.value){
        var now=new Date(),ts=now.getFullYear()+'-'+pad2(now.getMonth()+1)+'-'+pad2(now.getDate());
        dateEl.value=ts; buildSlotPicker(ts);
      }
      if(!timeEl.value){
        var nx=roundUpToStep(new Date(),15);
        nx.setMinutes(nx.getMinutes()+30);
        timeEl.value=pad2(nx.getHours())+':'+pad2(nx.getMinutes());
      }

      if(routeDurationSec) updateCardPrices(routeDurationSec); else updateCardPrices();
      if(!window.__vrFlying)setTimeout(function(){fitRouteBounds();setTimeout(showMarkerLabels,1200)},500);else setTimeout(showMarkerLabels,1900)
    }
    if(n===1&&dir==='back'){
      hideMarkerLabels(); clearRoute();
      if(dropoffMarker){dropoffMarker.remove();dropoffMarker=null;}
      if(dropoffLabelMk){dropoffLabelMk.remove();dropoffLabelMk=0}
      dropoffPlace=null; if(dropoffEl) dropoffEl.value='';
      routeDurationSec=null;

      if(pickupPlace&&map)map.flyTo({center:[pickupPlace.lng,pickupPlace.lat],zoom:16.5,pitch:50,bearing:-10,duration:2200});
      else if(map)map.flyTo({center:[defaultLng,defaultLat],zoom:defaultZoom,pitch:0,bearing:0,duration:1800});
    }
    if(n===2&&dir==='back'){ hideMarkerLabels(); }
  }

  function showMarkerLabels(){
    removeAddressLabels();

    if(pickupPlace && pickupMarker){
      var pEl=createLabelEl('pickup',pickupPlace.label);
      pEl.style.cssText+=';position:absolute;left:28px;top:-18px;transform:perspective(400px) rotateY(-50deg) scale(.8);';
      pickupMarker.getElement().appendChild(pEl);
      pickupLabelMk=pEl;
    }
    if(dropoffPlace && dropoffMarker){
      var dEl=createLabelEl('dropoff',dropoffPlace.label);
      dEl.style.cssText+=';position:absolute;right:28px;top:-18px;transform:perspective(400px) rotateY(50deg) scale(.8);';
      dropoffMarker.getElement().appendChild(dEl);
      dropoffLabelMk=dEl;
    }
    setTimeout(function(){if(pickupMarker){var l=pickupMarker.getElement().querySelector('.vipRide__mapLabel');if(l)l.classList.add('is-visible')}},50);
    setTimeout(function(){if(dropoffMarker){var l=dropoffMarker.getElement().querySelector('.vipRide__mapLabel');if(l)l.classList.add('is-visible')}},300);
  }
  function hideMarkerLabels(){
    removeAddressLabels();
  }
  function updateStepDots(){
    root.querySelectorAll('.vipRide__stepDot').forEach(function(d,i){
      d.classList.toggle('is-active',i+1===currentStep);
      d.classList.toggle('is-done',i+1<currentStep);
    });
  }
  if(step1NextBtn)step1NextBtn.addEventListener('click',function(){goToStep(3,'forward');});
  if(stepBackBtn)stepBackBtn.addEventListener('click',function(){goToStep(1,'back');});
  if(stepBack2Btn)stepBack2Btn.addEventListener('click',function(){goToStep(1,'back');});

  function _goldenPinSvg(iconPath){
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 46" fill="none" width="48" height="46">'
      +'<defs><linearGradient id="pg" x1="24" y1="2" x2="24" y2="44" gradientUnits="userSpaceOnUse">'
      +'<stop offset="0" stop-color="#F5DC7A"/><stop offset=".45" stop-color="#D4A800"/><stop offset="1" stop-color="#B08800"/>'
      +'</linearGradient><radialGradient id="ph" cx="24" cy="16.3" r="17" gradientUnits="userSpaceOnUse">'
      +'<stop offset="0" stop-color="#E8C547" stop-opacity=".22"/><stop offset=".5" stop-color="#E8C547" stop-opacity=".06"/><stop offset="1" stop-color="#E8C547" stop-opacity="0"/>'
      +'</radialGradient><radialGradient id="pw" cx="24" cy="16.3" r="11" gradientUnits="userSpaceOnUse">'
      +'<stop offset="0" stop-color="#fff" stop-opacity=".6"/><stop offset=".3" stop-color="#fff" stop-opacity=".18"/><stop offset=".65" stop-color="#fff" stop-opacity=".04"/><stop offset="1" stop-color="#fff" stop-opacity="0"/>'
      +'</radialGradient><filter id="ps" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur in="SourceGraphic" stdDeviation="2.5"/></filter></defs>'
      +'<circle cx="24" cy="16.3" r="17" fill="url(#ph)"/>'
      +'<circle cx="24" cy="16.3" r="11" fill="url(#pw)"/>'
      +'<path d="M36.2 24 A14.4 14.4 0 0 1 11.8 24 Q13 36.2 24 43.7 Q35 36.2 36.2 24Z" fill="#D4A800" opacity=".4" filter="url(#ps)"/>'
      +'<path d="M36.2 24 A14.4 14.4 0 0 1 11.8 24 Q13 36.2 24 43.7 Q35 36.2 36.2 24Z" fill="url(#pg)"/>'
      +'<path d="M32.3 22.6 A10.4 10.4 0 0 1 15.7 22.6 Q24 26.2 32.3 22.6Z" fill="#0a1128"/>'
      +'<path d="M35.5 23.5 A13.8 13.8 0 0 0 30.5 13" stroke="#fff" stroke-opacity=".28" stroke-width=".8" fill="none" stroke-linecap="round"/>'
      + iconPath
