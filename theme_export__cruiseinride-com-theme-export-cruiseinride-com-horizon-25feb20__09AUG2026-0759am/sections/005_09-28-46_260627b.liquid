    </div>
  </div>
  <div class="vipRide__authPage" data-vipride-auth-create hidden>
    <button type="button" class="vipRide__authPage__back" data-vipride-auth-back-create aria-label="Back"><svg width="10" height="18" viewBox="0 0 10 18" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 1L1 9l8 8"/></svg></button>
