      <p class="vipRide__testConfirm__label" style="color:rgba(255,255,255,.8)"><span data-vipride-promo-cancel-msg>Cancelling ride</span><span class="vipRide__testDots" aria-hidden="true">...</span></p>
      <div class="vipRide__testBar"><div class="vipRide__testBar__fill" style="background:linear-gradient(90deg,#c0392b,#e74c3c,#ff6b6b)" data-vipride-test-bar3></div></div>
    </div>

    <div class="vipRide__testConfirm__phase2" data-vipride-test-p2>
      <div class="vipRide__testSheet">
        <div class="vipRide__testSheet__handle" aria-hidden="true"></div>
        <div class="vipRide__testSheet__row">
          <div class="vipRide__testSheet__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#E8C547"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
          </div>
          <div class="vipRide__testSheet__info">
            <div class="vipRide__testSheet__status" data-vipride-test-msg data-vipride-promo-almost style="transition:opacity 380ms ease">Almost there...</div>
            <div class="vipRide__testSheet__route" data-vipride-test-route></div>
          </div>
        </div>
        <div class="vipRide__testBar vipRide__testBar--phase2"><div class="vipRide__testBar__fill" data-vipride-test-bar2></div></div>
        <button type="button" class="vipRide__testCancelBtn" data-vipride-test-cancel2 data-vipride-promo-cancel-btn>Cancel</button>
      </div>
    </div>

  </div>

  <div class="vipRide__authGate" data-vipride-auth-gate hidden>
    <div class="vipRide__authGate__card">
      <div class="vipRide__authGate__logo">{% if section.settings.auth_gate_logo %}{{ section.settings.auth_gate_logo | image_url: width: 120 | image_tag: class: 'vipRide__authGate__logoImg', alt: 'Logo' }}{% endif %}</div>
      <h2 class="vipRide__authGate__title" data-vipride-gate-title>To continue, sign up</h2>
      <p class="vipRide__authGate__sub vipRide__authGate__sub--gold" data-vipride-gate-sub>Create an account to book your ride</p>
      <button type="button" class="vipRide__authBtn vipRide__authBtn--primary vipRide__authBtn--xl" data-vipride-auth-goto-create data-vipride-gate-signup>Sign Up · Save 20%</button>
      <p class="vipRide__authGate__sub" data-vipride-gate-signinlbl style="margin:20px 0 0;font-size:13px">Already have an account?</p>
      <button type="button" class="vipRide__authBtn vipRide__authBtn--gold" style="margin-top:10px" data-vipride-auth-goto-signin data-vipride-gate-signin>Sign In</button>
      <div class="vipRide__authGate__divider"><span data-vipride-or-label>or</span></div>
