<style>
body:has(#vipRide-{{ section.id }}),html:has(#vipRide-{{ section.id }}){background:#0a1128!important;margin:0!important;padding:0!important;overflow:hidden!important}
body:has(#vipRide-{{ section.id }}) footer,body:has(#vipRide-{{ section.id }}) .footer,body:has(#vipRide-{{ section.id }}) #footer,body:has(#vipRide-{{ section.id }}) [class*="footer"],body:has(#vipRide-{{ section.id }}) [id*="footer"]{display:none!important}

#vipRide-{{ section.id }}{
  --gold:#D4AF37;--gold2:#FFD700;--silver:#C0C0C0;--silver2:#E8E8E8;--green:#4CAF50;--green2:#66BB6A;--ease:cubic-bezier(.2,.8,.2,1);--fs-xs:clamp(9px,2.2vw,11px);--fs-sm:clamp(11px,2.8vw,13px);--fs-md:clamp(13px,3.4vw,15px);--fs-lg:clamp(15px,4vw,18px);--fs-xl:clamp(17px,4.5vw,22px);--pad:clamp(10px,3vw,16px);--gap:clamp(4px,1.5vw,8px);--radius-sm:10px;--radius-md:14px;--radius-lg:20px;--sheet-margin:10px}

.vipRide{position:relative;overflow:hidden;background:#0a1128;color:#fff;height:100vh;height:100dvh;min-height:500px;isolation:isolate;opacity:0;animation:vipFadeIn 600ms cubic-bezier(0,0,.2,1) 100ms forwards}
@keyframes vipFadeIn{to{opacity:1}}
.vipRide,.vipRide *:not(.mapboxgl-marker):not(.mapboxgl-marker *){box-sizing:border-box;-webkit-tap-highlight-color:transparent}
.vipRide button{-webkit-appearance:none;appearance:none}
.vipRide__step,.vipRide__step *{filter:none!important}

.vipRide__bg{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none;background:#0A1128}

.vipRide__wrap{position:absolute;inset:0;display:flex;flex-direction:column;z-index:1}
.vipRide__map{position:absolute;inset:0;z-index:0;pointer-events:auto}
.vipRide__mapInner{height:100%;width:100%}
.vipRide__mapBackBtn{position:absolute;top:calc(var(--vip-nav-h,0px) + 12px);left:14px;z-index:11;width:38px;height:38px;border-radius:50%;background:rgba(10,15,35,.75);border:1px solid rgba(255,255,255,.15);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;touch-action:manipulation;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:background 140ms}
.vipRide__mapBackBtn:active{background:rgba(255,255,255,.2)}
.vipRide__mapBackBtn[hidden]{display:none!important}
#vipRideMap-{{ section.id }}{height:100%!important;width:100%!important}
#vipRideMap-{{ section.id }} > .mapboxgl-canvas-container{height:100%!important;width:100%!important}
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-attrib{font-size:9px;opacity:.3}
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-logo{opacity:.3}
#vipRideMap-{{ section.id }} .mapboxgl-marker{overflow:visible!important}
#vipRideMap-{{ section.id }} .mapboxgl-ctrl-group,#vipRideMap-{{ section.id }} .mapboxgl-ctrl-bottom-right{display:none!important}
.vipRide__sheet{position:absolute;bottom:var(--sheet-margin);left:var(--sheet-margin);right:var(--sheet-margin);z-index:10;background:#1a1a1f;transform:translateZ(0);-webkit-transform:translateZ(0);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius-lg);box-shadow:0 4px 16px rgba(0,0,0,.4),0 16px 48px rgba(0,0,0,.3),0 0 0 .5px rgba(255,255,255,.06) inset;padding:8px var(--pad) calc(10px + env(safe-area-inset-bottom,0px));max-height:50svh;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:rgba(212,175,55,.3) transparent;transition:opacity 300ms cubic-bezier(0,0,.2,1);opacity:0;animation:vipSheetIn 500ms cubic-bezier(0,0,.2,1) 250ms both}
@keyframes vipSheetIn{0%{opacity:0;transform:translateY(20px) translateZ(0)}to{opacity:1;transform:translateY(0) translateZ(0)}}
.vipRide__sheet::-webkit-scrollbar{width:3px;}
.vipRide__sheet::-webkit-scrollbar-thumb{background:rgba(212,175,55,.3);border-radius:3px}
@media(max-width:899px){.vipRide__sheet[data-vipride-step="3"]{left:8px!important;right:8px!important;bottom:10px!important;border-radius:20px!important;max-height:60svh!important;overflow-y:auto!important;padding:14px 14px calc(14px + env(safe-area-inset-bottom,0px))!important;background:#1a1a1f!important;border:1px solid rgba(255,255,255,.06)!important;box-shadow:0 2px 10px rgba(232,197,71,.06),0 8px 40px rgba(0,0,0,.5)!important}}
@media(min-width:900px){
.vipRide__sheet,.vipRide__sheet.is-test-hidden{position:fixed!important;left:0!important;right:0!important;bottom:32px!important;top:auto!important;transform:none!important;width:min(640px,calc(100vw - 48px))!important;max-height:min(480px,calc(100vh - var(--vip-nav-h,72px) - 80px))!important;height:auto!important;border-radius:22px!important;inset:auto!important;z-index:5!important;overflow-y:auto!important;margin:0 auto!important;opacity:1!important;pointer-events:auto!important;background:rgba(15,17,32,.95)!important;backdrop-filter:blur(22px);box-shadow:0 16px 50px rgba(0,0,0,.6)!important;padding:22px 26px!important}
.vipRide__sheet *{box-sizing:border-box}
.vipRide__input,.vipRide__inputWrap,.vipRide__form,.vipRide__modeToggle{width:100%!important;max-width:100%!important;box-sizing:border-box!important}
}

.vipRide__handle{width:36px;height:4px;border-radius:2px;background:linear-gradient(90deg,rgba(255,255,255,.10),rgba(212,175,55,.25),rgba(255,255,255,.10));margin:0 auto 8px;flex-shrink:0;}

.vipRide__stepDots{display:flex;gap:5px;justify-content:center;margin-bottom:6px;flex-shrink:0;}
.vipRide__stepDot{width:5px;height:5px;border-radius:99px;background:rgba(255,255,255,.2);transition:width 350ms cubic-bezier(0,0,.2,1),background 350ms cubic-bezier(0,0,.2,1)}
.vipRide__stepDot.is-active{width:18px;background:var(--gold)}
.vipRide__stepDot.is-done{background:rgba(212,175,55,.45)}
.vipRide__titleRow{display:flex;align-items:center;justify-content:center;margin-bottom:6px}
.vipRide__title{margin:0;font-family:'Poppins',sans-serif;font-size:var(--fs-xl);font-weight:800;letter-spacing:-.03em;color:rgba(255,255,255,.9)!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center;width:100%}
.vipRide__modeToggle{display:flex;gap:3px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:3px;margin-bottom:8px;overflow:visible}
.vipRide__modeBtn{flex:1;padding:clamp(7px,2vw,9px) 6px;border-radius:8px;border:none;background:transparent;color:rgba(255,255,255,.6);font-size:var(--fs-xs);font-weight:700;letter-spacing:.03em;cursor:pointer;transition:all 180ms var(--ease);white-space:nowrap;overflow:visible;min-width:0}
.vipRide__modeBtn.is-active{background:var(--gold);color:#000!important;font-weight:800;box-shadow:0 3px 10px rgba(212,175,55,.3)}
.vipRide__form{display:flex;flex-direction:column;gap:var(--gap)}
.vipRide__field{display:flex;flex-direction:column;gap:3px;position:relative;z-index:1}
.vipRide__field:focus-within{z-index:9999}
.vipRide__field--hours[hidden]{display:none!important}
.vipRide__label{font-size:var(--fs-xs);font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(212,175,55,.75)!important;overflow:visible;white-space:nowrap}
.vipRide__inputWrap{display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.10);border-radius:var(--radius-sm);padding:clamp(8px,2.5vw,11px) 10px;position:relative;transition:border-color 200ms,background 200ms;min-height:44px;overflow:visible}
.vipRide__inputWrap:focus-within{border-color:rgba(212,175,55,.55)!important;background:rgba(212,175,55,.06)!important}
.vipRide__inputIcon{color:#fff;opacity:.9;flex-shrink:0;font-size:11px}
.vipRide__input{flex:1;min-width:0;border:0;outline:none;background:transparent!important;font-size:var(--fs-md);color:#fff!important;-webkit-appearance:none;appearance:none}
.vipRide__input::placeholder{color:rgba(255,255,255,.45)!important;font-size:var(--fs-sm)}
.vipRide__input:focus{outline:none!important;font-size:var(--fs-md)!important}
.vipRide__input--dt{color-scheme:dark}
.vipRide__input--dt::-webkit-datetime-edit,.vipRide__input--dt::-webkit-datetime-edit-text,.vipRide__input--dt::-webkit-datetime-edit-month-field,.vipRide__input--dt::-webkit-datetime-edit-day-field,.vipRide__input--dt::-webkit-datetime-edit-year-field,.vipRide__input--dt::-webkit-datetime-edit-hour-field,.vipRide__input--dt::-webkit-datetime-edit-minute-field{color:#fff}
.vipRide__inputWrap--date,.vipRide__input--date{cursor:pointer}
.vipRide__input--date::-webkit-calendar-picker-indicator{opacity:0;cursor:pointer;position:absolute;inset:0;width:100%;height:100%}
.vipRide input[type="time"]::-webkit-calendar-picker-indicator{display:none!important}
.vipRide input[type="time"]{background:transparent!important;color:#fff!important;-webkit-appearance:none!important}
.vipRide__clear{flex-shrink:0;border:1px solid rgba(255,255,255,.2);background:rgba(0,0,0,.3);width:26px;height:26px;border-radius:999px;cursor:pointer;font-size:16px;line-height:24px;display:none;color:#fff;align-items:center;justify-content:center}

.vipRide__field{overflow:visible!important}
.vipRide__suggestions{position:fixed;z-index:99999;background:rgba(10,8,4,.98);border:1px solid rgba(212,175,55,.25);border-radius:var(--radius-md);overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,.6);display:none;max-height:210px;overflow-y:auto;-webkit-overflow-scrolling:touch;width:280px}
.vipRide__suggestion{padding:clamp(10px,2.5vw,13px) 12px;color:#fff;font-size:var(--fs-sm);cursor:pointer;border-top:1px solid rgba(255,255,255,.07);transition:background 160ms;display:flex;align-items:flex-start;gap:8px;min-height:66px;border-left:2px solid transparent}
.vipRide__suggestion:first-child{border-top:none}
.vipRide__suggestion:hover,.vipRide__suggestion.is-active{background:rgba(212,175,55,.18);border-left-color:#E8C547}
.vipRide__suggestionIcon{flex-shrink:0;width:16px;height:16px;margin-top:2px;opacity:.5;color:var(--gold)}
.vipRide__suggestionText{flex:1;min-width:0}
.vipRide__suggestionMain{font-weight:700;font-size:var(--fs-sm);color:#fff;white-space:normal;word-wrap:break-word;overflow-wrap:break-word}
.vipRide__suggestionSub{font-size:var(--fs-xs);color:rgba(255,255,255,.5);margin-top:1px;white-space:normal;word-wrap:break-word;overflow-wrap:break-word}
.vipRide__hoursWrap{display:flex;align-items:center;justify-content:center;gap:12px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:var(--radius-sm);padding:10px 12px}
.vipRide__hoursBtn{width:clamp(36px,9vw,44px);height:clamp(36px,9vw,44px);border-radius:9px;background:var(--gold);border:none;color:#000;font-size:clamp(16px,4vw,20px);font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform 140ms,opacity 180ms;touch-action:manipulation}
.vipRide__hoursBtn:hover:not(:disabled){transform:scale(1.08)}
.vipRide__hoursBtn:active:not(:disabled){transform:scale(.94)}
.vipRide__hoursBtn:disabled{opacity:.3;cursor:not-allowed}
.vipRide__hoursDisplay{display:flex;align-items:baseline;gap:5px;min-width:70px;justify-content:center}
.vipRide__hoursValue{font-size:clamp(22px,6vw,28px);font-weight:700;color:var(--gold);text-align:center}
