.vR-app{position:relative;width:100%;max-width:440px;margin:0 auto;padding:calc(var(--vip-nav-h,0px) + clamp(18px,5vw,28px)) clamp(18px,5vw,28px) clamp(20px,5vw,32px);display:flex;flex-direction:column;align-items:center;gap:clamp(14px,3.5vw,20px);min-height:100%}
.vR-app__phoneWrap{position:relative;z-index:1;width:clamp(155px,42vw,200px);aspect-ratio:9/19.5;perspective:1400px;animation:vRphIn 1.1s cubic-bezier(.22,1,.36,1) .15s both;will-change:transform,opacity}
@keyframes vRphIn{0%{opacity:0;transform:translateY(40px) scale(.88) rotateX(10deg)}60%{opacity:1}100%{opacity:1;transform:translateY(0) scale(1) rotateX(0)}}
.vR-app__glow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:145%;height:130%;border-radius:50%;background:radial-gradient(circle,rgba(232,197,71,.18),rgba(108,92,231,.08) 45%,transparent 70%);filter:blur(48px);animation:vRglow 8s ease-in-out infinite alternate;will-change:transform,opacity}
