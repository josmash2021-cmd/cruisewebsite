.vipRide__prices{margin-top:0}
.vipRide__pricesHeader{margin-bottom:8px;text-align:center}
.vipRide__pricesTitle{display:block;font-family:'Poppins',sans-serif;font-size:clamp(16px,4.5vw,20px);font-weight:800;color:#fff!important;letter-spacing:-.03em;text-align:center;width:100%}
.vipRide__rideList{display:grid!important;grid-template-columns:repeat(3,1fr);gap:8px}
.vipRide__rideCard{-webkit-appearance:none;appearance:none;display:flex!important;flex-direction:column;align-items:center;justify-content:space-between;gap:6px;width:100%!important;aspect-ratio:1/1.05;padding:10px 8px!important;border:1px solid rgba(255,255,255,.08);border-radius:14px;background:rgba(255,255,255,.02)!important;cursor:pointer;text-align:center;color:#fff;transition:transform 200ms cubic-bezier(0,0,.2,1),border-color 200ms,background 200ms;touch-action:manipulation;position:relative;overflow:hidden;backface-visibility:hidden;transform:translateZ(0)}
.vipRide__rideCard *{color:#fff;text-shadow:none!important}
.vipRide__badge--premium,.vipRide__badge--premium *,.vipRide__badge--comfort,.vipRide__badge--comfort *{color:#000!important}
@media(hover:hover) and (pointer:fine){.vipRide__rideCard:hover{transform:translateY(-2px) translateZ(0);border-color:rgba(255,255,255,.15)}}
.vipRide__rideCard:active{transform:scale(.96) translateZ(0)}
.vipRide__rideCard.is-active{border-color:rgba(232,197,71,.7);background:rgba(232,197,71,.08)!important;outline:2px solid rgba(232,197,71,.55);outline-offset:-1px;animation:rideGlow 2.8s ease-in-out infinite}
@keyframes rideGlow{0%,100%{box-shadow:0 0 0 1px rgba(232,197,71,.3),0 6px 18px rgba(232,197,71,.15)}50%{box-shadow:0 0 0 1px rgba(232,197,71,.5),0 8px 24px rgba(232,197,71,.3)}}
.vipRide__rideCard .vipRide__rideDesc,.vipRide__rideCard .vipRide__rideEtaRow,.vipRide__rideCard .vipRide__ridePrice{display:none!important}
.vipRide__rideImg{flex:1;width:100%;display:flex;align-items:center;justify-content:center;min-height:0}
.vipRide__rideImgTag,.vipRide__rideCard img{display:block;width:auto!important;height:100%!important;max-width:100%!important;max-height:60px!important;object-fit:contain!important;filter:drop-shadow(0 3px 2px #000) drop-shadow(0 9px 12px #000)!important}
.vipRide__rideMeta{flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:4px;width:100%}
.vipRide__rideName{font-size:clamp(11px,3vw,13px);font-weight:800;color:#fff;line-height:1;letter-spacing:.02em}
.vipRide__rideNameRow{display:flex;flex-direction:column;align-items:center;gap:4px;width:100%}
.vipRide__rideDetail{margin-top:14px;padding:14px;background:linear-gradient(135deg,rgba(232,197,71,.06),rgba(255,255,255,.02));border:1px solid rgba(232,197,71,.18);border-radius:14px;animation:vipRideDetailIn .65s cubic-bezier(.4,0,.2,1) both}
@keyframes vipRideDetailIn{0%{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
.vipRide__rideDetail[hidden]{display:none!important}
.vipRide__rideDetail__desc{font-size:13px;color:rgba(255,255,255,.75);line-height:1.4;margin-bottom:10px}
.vipRide__rideDetail__row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.vipRide__rideDetail__meta{display:flex;align-items:center;gap:6px;font-size:12px;color:rgba(255,255,255,.55);font-weight:600}
.vipRide__rideDetail__sep{opacity:.4}
.vipRide__rideDetail__price{font-size:clamp(18px,5vw,22px);font-weight:800;color:#fff}
.vipRide__rideCard.is-hidden{opacity:0;max-height:0!important;padding:0!important;margin:0!important;border-width:0!important;overflow:hidden;pointer-events:none;transition:all 260ms cubic-bezier(.4,0,1,1)!important}
.vipRide__rideCard--disabled{opacity:.3!important;pointer-events:none!important}
.vipRide__rideCard--disabled::after{content:'COMING SOON';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.75);color:var(--gold);font-size:10px;font-weight:800;letter-spacing:.1em;padding:5px 12px;border-radius:7px;border:1px solid rgba(212,175,55,.3);text-transform:uppercase;pointer-events:none;z-index:2;white-space:nowrap;}

.vipRide__rideImg{width:100%;position:relative;overflow:visible;display:flex;flex-direction:column;align-items:center;gap:5px}
.vipRide__badgeIcon{font-style:normal;position:relative;z-index:1}
.vipRide__badgeIcon--lg{font-size:2.3em;line-height:1;display:inline-flex;align-items:center;justify-content:center;transform:translateY(-1.5px)}
.vipRide__rideImgTag,.vipRide__rideCard img{display:block;width:100%!important;height:auto!important;max-height:clamp(40px,11vw,52px)!important;object-fit:contain!important;filter:drop-shadow(0 3px 2px #000) drop-shadow(0 9px 12px #000)!important}
.vipRide__rideImgPh{font-size:clamp(26px,7vw,34px)}

.vipRide__badge{position:relative;z-index:2;border-radius:6px;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#000!important;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:1px;flex-shrink:0;overflow:hidden;width:78px;height:22px}

.vipRide__badge--vip{background:linear-gradient(135deg,#1a1a1a,#000);color:#fff!important;border:1px solid rgba(232,197,71,.3);animation:vipHalo 6s cubic-bezier(.4,0,.6,1) infinite}
@keyframes vipHalo{0%,100%{box-shadow:0 2px 8px rgba(0,0,0,.5),0 0 4px rgba(232,197,71,.08)}50%{box-shadow:0 2px 10px rgba(0,0,0,.55),0 0 16px rgba(232,197,71,.35)}}
.vrSpk{transform-box:fill-box;transform-origin:center;animation:vrTw 2.4s ease-in-out infinite}
.vrSpk2{animation-delay:.8s}.vrSpk3{animation-delay:1.6s}
@keyframes vrTw{0%,100%{opacity:.3;transform:scale(.7)}50%{opacity:1;transform:scale(1.15)}}
.vipRide__badge--premium{background:linear-gradient(135deg,#F5DC7A,#E8C547,#B08800);color:#000!important;box-shadow:0 2px 8px rgba(212,175,55,.4),0 0 14px rgba(232,197,71,.25)}
.vipRide__badge--comfort{background:linear-gradient(135deg,#E8E8E8,#B0B0B0);box-shadow:0 2px 8px rgba(192,192,192,.3),0 0 12px rgba(200,200,200,.15);color:#1a1a1a!important}
.vipRide__rideMeta{min-width:0;display:flex;flex-direction:column;gap:2px;overflow:visible}
.vipRide__rideName{font-size:clamp(15px,4vw,17px);font-weight:700;line-height:1.3;color:#fff}
.vipRide__rideNameRow{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.vipRide__rideDesc{font-size:clamp(12px,3.2vw,14px);color:rgba(255,255,255,.55);line-height:1.4;white-space:normal;word-break:break-word;margin-top:3px}
.vipRide__rideEtaRow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;overflow:visible;margin-top:5px}
.vipRide__ridePrice{display:block!important;position:absolute;top:12px;right:14px;font-size:clamp(16px,4.5vw,19px);font-weight:800;color:#fff!important;white-space:nowrap}
.vipRide__rideEta{font-size:clamp(12px,3vw,13px);font-weight:600;color:rgba(255,255,255,.45)!important;white-space:nowrap}
.vipRide__seats{font-size:clamp(12px,3vw,13px);font-weight:600;color:rgba(255,255,255,.45)!important;display:inline-flex;align-items:center;gap:3px;white-space:nowrap}
.vipRide__personIcon{font-size:12px;color:rgba(255,255,255,.45)!important}

.vipRide__actionBtns{margin-top:12px;display:flex;flex-direction:column;gap:8px}
.vipRide__actionBtns>*{opacity:0;animation:vipFB .6s cubic-bezier(.4,0,.2,1) .25s forwards}
.vipRide__actionBtns>:nth-child(2){animation-delay:.4s}
@keyframes vipFB{0%{transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.vipRide__actionBtns[hidden]{display:none!important}
.vipRide__paymentBtn{width:100%;display:flex;align-items:center;gap:10px;padding:12px 14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:#fff;font-size:14px;font-weight:600;cursor:pointer;touch-action:manipulation;transition:background 150ms}
.vipRide__payBtnLabel{flex:1;text-align:left}
.vipRide__paymentBtn:active{background:rgba(255,255,255,.1)}
.vipRide__requestBtn{width:100%;padding:16px;background:#E8C547;border:none;border-radius:12px;font-size:16px;font-weight:800;color:#0a0e1a;text-align:center;cursor:pointer;touch-action:manipulation;transition:opacity 150ms,transform 120ms;box-shadow:0 2px 8px rgba(232,197,71,.25),0 6px 20px rgba(0,0,0,.2)}
.vipRide__requestBtn:active:not(:disabled){transform:scale(.97)}
.vipRide__requestBtn:disabled{opacity:.35;cursor:not-allowed}

.vipRide__payOverlay{position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,.15);backdrop-filter:blur(28px);-webkit-backdrop-filter:blur(28px);display:flex!important;flex-direction:column;padding-top:var(--vip-nav-h,0px);opacity:1;transform:translateY(0) scale(1);transition:opacity 380ms cubic-bezier(.33,1,.68,1),transform 380ms cubic-bezier(.33,1,.68,1);will-change:opacity,transform}
.vipRide__payOverlay[hidden]{display:none!important}
.vipRide__payOverlay.is-entering{opacity:0;transform:translateY(14px) scale(.985)}
.vipRide__payOverlay.is-closing{opacity:0;transform:translateY(10px) scale(.99);pointer-events:none}
.vipRide__payOverlay__header{display:flex;align-items:center;gap:14px;padding:16px 16px 12px;flex-shrink:0}
.vipRide__payOverlay__back{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:background 140ms}
.vipRide__payOverlay__back:active{background:rgba(255,255,255,.15)}
.vipRide__payOverlay__title{font-size:18px;font-weight:700;color:#fff;margin:0}
.vipRide__payOverlay__list{padding:0 16px;display:flex;flex-direction:column;gap:6px}
.vipRide__payOption{width:100%;display:flex;align-items:center;gap:14px;padding:16px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:14px;color:#fff;font-size:15px;font-weight:600;cursor:pointer;touch-action:manipulation;transition:background 140ms,border-color 140ms;text-align:left}
.vipRide__payOption:active{background:rgba(255,255,255,.1)}
.vipRide__payOption.is-selected{border-color:rgba(232,197,71,.5);background:rgba(232,197,71,.08)}
.vipRide__payIcon{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;color:#fff}
.vipRide__payLabel{flex:1;min-width:0}
.vipRide__payCheck{width:22px;height:22px;border-radius:50%;border:1.5px solid rgba(255,255,255,.15);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:12px;transition:all 200ms}
.vipRide__payOption.is-selected .vipRide__payCheck{background:#E8C547;border-color:#E8C547;color:#000}
.vipRide__payOption.is-selected .vipRide__payCheck::after{content:'\2713';font-weight:800}

.vipRide__scheduleOverlay{position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,.15);backdrop-filter:blur(28px);-webkit-backdrop-filter:blur(28px);display:flex!important;flex-direction:column;padding-top:var(--vip-nav-h,0);transition:opacity 380ms cubic-bezier(.33,1,.68,1),transform 380ms cubic-bezier(.33,1,.68,1);transform:translateY(0) scale(1);will-change:opacity,transform}
.vipRide__scheduleOverlay.is-entering{opacity:0;transform:translateY(14px) scale(.985)}
.vipRide__scheduleOverlay[hidden]{display:none!important}
.vipRide__scheduleOverlay.is-closing{opacity:0;pointer-events:none}
.vipRide__schedPage{transition:opacity 300ms ease;opacity:1}
.vipRide__schedPage[hidden]{display:none!important}
.vipRide__schedPage.is-entering{opacity:0!important}
.vipRide__schedCalendar{padding:0 16px;flex:1;overflow-y:auto}
.vipRide__schedHeader{display:flex;align-items:flex-start;gap:12px;padding:20px 20px 12px}
.vipRide__schedHeader > div{flex:1}
.vipRide__schedTitle{margin:0;font-size:20px;font-weight:800;color:#fff}
.vipRide__schedSub{margin:4px 0 0;font-size:13px;color:rgba(255,255,255,.4)}
.vipRide__schedHeaderIcon{width:40px;height:40px;border-radius:12px;background:rgba(232,197,71,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.vipRide__schedBackBtn{width:32px;height:32px;border-radius:50%;background:none;border:none;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;margin-top:4px}
.vipRide__step{display:flex;flex-direction:column;overflow:visible;backface-visibility:hidden}
.vipRide__step[hidden]{display:none!important}
.vipRide__step.is-exiting,.vipRide__step.is-exiting-back{opacity:0;transition:opacity 300ms cubic-bezier(.4,0,1,1);pointer-events:none}
@keyframes vipStepIn{from{opacity:0}to{opacity:1}}
@keyframes vipStepInBack{
  from{opacity:0}
  to{opacity:1}
}
@keyframes vipCardIn{
  from{opacity:0;transform:translateY(10px)}
  to{opacity:1;transform:translateY(0)}
}
.vipRide__step.is-entering{animation:vipStepIn 400ms cubic-bezier(0,0,.2,1) both}
.vipRide__step.is-entering-back{animation:vipStepInBack 400ms cubic-bezier(0,0,.2,1) both}
.vipRide__marker{cursor:pointer;width:0;height:0;overflow:visible;position:relative}
.vipRide__markerInner{position:absolute;left:-20px;top:-38px;display:block;width:40px;height:38px;transform-origin:center bottom;animation:vipMarkerPop 700ms cubic-bezier(.175,.885,.32,1.275) forwards;backface-visibility:hidden}
.vipRide__markerInner svg{display:block;width:40px;height:38px;filter:drop-shadow(0 4px 6px rgba(0,0,0,.55)) drop-shadow(0 10px 14px rgba(0,0,0,.35)) drop-shadow(0 0 3px rgba(232,197,71,.25))}
@keyframes vipMarkerPop{0%{transform:scale(0);opacity:0}50%{transform:scale(1.1);opacity:1}70%{transform:scale(.95)}100%{transform:scale(1)}}

.vipRide__mapLabel{position:relative;display:flex;align-items:center;gap:8px;background:linear-gradient(135deg,rgba(15,17,32,.96),rgba(20,22,38,.94));border:1px solid rgba(232,197,71,.35);border-radius:12px;padding:7px 12px 7px 9px;opacity:0;pointer-events:none;font-family:-apple-system,BlinkMacSystemFont,sans-serif;color:#fff;line-height:1.2;box-shadow:0 4px 16px rgba(0,0,0,.55),0 0 22px rgba(232,197,71,.12);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition:opacity 520ms cubic-bezier(.22,1.2,.36,1),transform 620ms cubic-bezier(.34,1.56,.64,1);white-space:nowrap}
.vipRide__mapLabel--pickup{transform-origin:left center}
.vipRide__mapLabel--dropoff{transform-origin:right center}
.vipRide__mapLabel.is-visible{opacity:1;transform:perspective(400px) rotateY(0) scale(1)!important;animation:mapLabelBreathe 3.2s ease-in-out 900ms infinite}
@keyframes mapLabelBreathe{0%,100%{box-shadow:0 4px 16px rgba(0,0,0,.55),0 0 22px rgba(232,197,71,.12)}50%{box-shadow:0 6px 22px rgba(0,0,0,.6),0 0 36px rgba(232,197,71,.22)}}
.vipRide__mapLabel__tail{position:absolute;bottom:10px;width:9px;height:9px;background:rgba(15,17,32,.96);border:1px solid rgba(232,197,71,.35);transform:rotate(45deg)}
.vipRide__mapLabel--pickup .vipRide__mapLabel__tail{left:-5px;border-right:0;border-top:0}
.vipRide__mapLabel--dropoff .vipRide__mapLabel__tail{right:-5px;border-left:0;border-bottom:0}
.vipRide__mapLabel__ico{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:7px;flex-shrink:0;background:linear-gradient(135deg,#F5DC7A,#D4A800);color:#0a0e1a;box-shadow:0 2px 6px rgba(232,197,71,.4)}
.vipRide__mapLabel__txt{display:flex;flex-direction:column;gap:1px;min-width:0}
.vipRide__mapLabel__kind{font-size:8.5px;font-weight:800;letter-spacing:.14em;color:#E8C547;text-transform:uppercase}
.vipRide__labelText{font-size:clamp(11px,2.3vw,12.5px);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:rgba(255,255,255,.96);max-width:clamp(110px,32vw,200px)}
.vipRide__youLabel{position:absolute;left:50%;top:-64px;transform:translateX(-50%);background:linear-gradient(135deg,#F5DC7A,#E8C547);color:#0a0e1a;font-size:11px;font-weight:800;padding:4px 12px;border-radius:10px;white-space:nowrap;box-shadow:0 4px 14px rgba(232,197,71,.45);pointer-events:none;animation:youLabelIn 480ms cubic-bezier(.34,1.56,.64,1) 600ms both,youLabelPulse 2.8s ease-in-out 1400ms infinite}
.vipRide__youLabel::after{content:'';position:absolute;left:50%;bottom:-5px;transform:translateX(-50%);border-left:6px solid transparent;border-right:6px solid transparent;border-top:6px solid #E8C547}
@keyframes youLabelIn{0%{opacity:0;transform:translateX(-50%) translateY(-8px) scale(.6)}60%{transform:translateX(-50%) translateY(2px) scale(1.08)}100%{opacity:1;transform:translateX(-50%) translateY(0) scale(1)}}
@keyframes youLabelPulse{0%,100%{box-shadow:0 4px 14px rgba(232,197,71,.45)}50%{box-shadow:0 4px 22px rgba(232,197,71,.7)}}

@media(prefers-reduced-motion:reduce){.vipRide,.vipRide__sheet,.vipRide__rideCard,.vipRide__step,.vipRide__modeToggle,.vipRide__markerInner,.vipRide__mapLabel{animation:none!important;transition:none!important;opacity:1!important;transform:none!important}}
.template-index #vipRide-{{ section.id }}{margin-top:calc(var(--header-height,60px)*-1);padding-top:var(--header-height,60px)}
#vipRide-{{ section.id }} .vipRide__form[data-vipride-mode="hourly"] [data-vipride-dropoff-field]{display:none!important}
@media(max-width:340px){.vipRide__sheet{--sheet-margin:6px;padding:10px 8px calc(8px + env(safe-area-inset-bottom,0px))}.vipRide__modeBtn{font-size:clamp(8px,2vw,10px);padding:6px 4px}.vipRide__rideCard{grid-template-columns:clamp(80px,22vw,100px) 1fr;gap:8px;padding:10px 8px!important}}

@media(max-width:899px){
  .vipRide__step1Full{display:none!important}
  .vipRide__sheet[data-vipride-step="1"]{left:10px;right:10px;bottom:12px;padding:36px 22px calc(40px + env(safe-area-inset-bottom,0px));max-height:none!important;position:absolute;isolation:isolate;overflow:hidden;border-radius:22px;background:#111115!important;border-color:rgba(255,255,255,.05)!important;animation:vipSheetIn 400ms cubic-bezier(0,0,.2,1) 250ms both}
  .vipRide__sheet[data-vipride-step="1"] .vipRide__handle,.vipRide__sheet[data-vipride-step="1"] .vipRide__stepDots,.vipRide__sheet[data-vipride-step="3"] .vipRide__handle,.vipRide__sheet[data-vipride-step="3"] .vipRide__stepDots{display:none!important}
}
.vipRide__compactCard{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0}

  .vipRide__compactCard__body{flex:1;min-width:0;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;user-select:none}
  .vipRide__compactCard__title{margin:0 0 13px;font-family:'Poppins',sans-serif;font-size:clamp(24px,6.8vw,28px);font-weight:800;color:#fff;letter-spacing:-.04em;line-height:1.05;white-space:nowrap}
  .vipRide__compactPills{display:flex;align-items:center;gap:8px}
