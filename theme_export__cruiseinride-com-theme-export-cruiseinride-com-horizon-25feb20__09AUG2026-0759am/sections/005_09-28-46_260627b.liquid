{%- assign _ab = 'vipRide__authBtn vipRide__authBtn--outline vipRide__authBtn--icon' -%}
{% assign bp = section.settings.booking_product %}
{% if bp %}
  {% assign booked_raw = bp.metafields.vip.booked_slots.value | default: '[]' %}
{% else %}
  {% assign booked_raw = '[]' %}
{% endif %}
<script>
  window.__VIP_BOOKED_SLOTS__={{booked_raw}};
  window.__VIP_SVC_STATES__=('{% if section.settings.svc_al %}AL,{% endif %}{% if section.settings.svc_fl %}FL,{% endif %}{% if section.settings.svc_ga %}GA,{% endif %}{% if section.settings.svc_ms %}MS,{% endif %}{% if section.settings.svc_tn %}TN,{% endif %}{% if section.settings.svc_la %}LA,{% endif %}{% if section.settings.svc_sc %}SC,{% endif %}{% if section.settings.svc_nc %}NC,{% endif %}{% if section.settings.svc_tx %}TX,{% endif %}{% if section.settings.svc_ca %}CA,{% endif %}{% if section.settings.svc_ny %}NY,{% endif %}{% if section.settings.svc_nv %}NV,{% endif %}{{ section.settings.svc_extra_states | escape }}').toUpperCase().split(',').map(function(s){return s.trim()}).filter(function(s,i,a){return s&&a.indexOf(s)===i});
  window.__VIP_SVC_BLOCK__={titleEn:{{ section.settings.svc_block_title_en | json }},titleEs:{{ section.settings.svc_block_title_es | json }},msgEn:{{ section.settings.svc_block_msg_en | json }},msgEs:{{ section.settings.svc_block_msg_es | json }}};
  window.__VIP_CENT_VARIANT_ID__=48209875435775
  window.__VIP_VEHICLE_VARIANTS__ = {
    {% assign printed_vehicle_variant = false %}
    {% for block in section.blocks %}
      {% assign p = block.settings.product %}
      {% if p and p.variants.size > 0 %}
        {% if printed_vehicle_variant %},{% endif %}
        "{{ block.id }}": [
          {% for v in p.variants %}
            { "id": {{ v.id }}, "price": {{ v.price }} }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
        {% assign printed_vehicle_variant = true %}
      {% endif %}
    {% endfor %}
  };
</script>

<section id="vipRide-{{ section.id }}" class="vipRide">
  <div class="vipRide__bg" aria-hidden="true"></div>

  <div class="vipRide__wrap">
    <div class="vipRide__map">
      <div class="vipRide__mapInner" id="vipRideMap-{{ section.id }}"></div>
      <div class="vipRide__mapSkeleton" data-vr-mapsk><div class="vrMapGrid"></div><div class="vrMapPin"></div></div>
    </div>

    <button type="button" class="vipRide__mapBackBtn" data-vipride-map-back hidden aria-label="Back">
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 7H1M7 1L1 7l6 6"/></svg>
    </button>

    <div class="vipRide__sheet" data-vipride-sheet data-vipride-step="1">
      <div class="vipRide__handle" aria-hidden="true"></div>
      <div class="vipRide__stepDots" aria-hidden="true">
        <div class="vipRide__stepDot is-active"></div>
        <div class="vipRide__stepDot"></div>
        <div class="vipRide__stepDot"></div>
      </div>

      <!-- STEP 1 -->
      <div class="vipRide__step" data-vipride-step-panel="1">

        <div class="vipRide__compactCard" data-vipride-compact-card>
          <div class="vipRide__compactCard__body" data-vipride-open-locpicker>
            <h2 class="vipRide__compactCard__title" data-vipride-compact-heading>Where to?</h2>
            <div class="vipRide__seg" data-vipride-seg role="group" aria-label="Ride timing">
              <div class="vipRide__seg__rail" aria-hidden="true"></div>
              <button type="button" class="vipRide__seg__btn is-active" data-compact-mode="now" data-vipride-compact-mode-btn>
                <svg class="vipRide__pillIcon" width="9" height="13" viewBox="0 0 9 13" fill="currentColor" aria-hidden="true"><path d="M5.2 0L0 7.5h3.6L2.2 13 9 5H5.4L5.2 0z"/></svg><span data-vipride-mode-now>Now</span>
              </button>
              <button type="button" class="vipRide__seg__btn" data-compact-mode="later" data-vipride-compact-mode-btn>
                <svg class="vipRide__pillIcon" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="6.5" cy="6.5" r="5.5"/><path d="M6.5 3.5V6.5L8.5 8.5"/></svg><span data-vipride-mode-schedule>Schedule</span>
              </button>
            </div>
          </div>
          <button type="button" class="vipRide__compactArrow" data-vipride-compact-next aria-label="Continue">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 1l6 6-6 6"/></svg>
          </button>
        </div>

        <div class="vipRide__step1Full">
          <div class="vipRide__titleRow">
            <h2 class="vipRide__title" data-vipride-step1-heading>Where to?</h2>
          </div>
          <div class="vipRide__modeToggle" data-vipride-mode-toggle>
            <button type="button" class="vipRide__modeBtn is-active" data-mode="ride" data-vipride-mode-btn>{{ section.settings.ride_mode_text | default: 'Point to Point' }}</button>
            <button type="button" class="vipRide__modeBtn" data-mode="hourly" data-vipride-mode-btn>{{ section.settings.hourly_mode_text | default: 'By the Hour' }}</button>
          </div>
          <div class="vipRide__form" data-vipride-mode="ride">
            <div class="vipRide__field">
              <label class="vipRide__label" data-vipride-pickup-label>{{ section.settings.pickup_label }}</label>
              <div class="vipRide__inputWrap">
                <span class="vipRide__inputIcon">&#9679;</span>
                <input type="text" class="vipRide__input" placeholder="{{ section.settings.pickup_placeholder }}" data-vipride-pickup autocomplete="off">
                <button type="button" class="vipRide__clear" aria-label="Clear" data-vipride-clear="pickup">&times;</button>
              </div>
            </div>
            <div class="vipRide__field" data-vipride-dropoff-field>
              <label class="vipRide__label">{{ section.settings.dropoff_label }}</label>
              <div class="vipRide__inputWrap">
                <span class="vipRide__inputIcon">&#9632;</span>
                <input type="text" class="vipRide__input" placeholder="{{ section.settings.dropoff_placeholder }}" data-vipride-dropoff autocomplete="off">
                <button type="button" class="vipRide__clear" aria-label="Clear" data-vipride-clear="dropoff">&times;</button>
              </div>
            </div>
            <div class="vipRide__field vipRide__field--hours" data-vipride-hours-field hidden>
              <label class="vipRide__label">{{ section.settings.hours_label | default: 'Duration' }}</label>
              <div class="vipRide__hoursWrap">
                <button type="button" class="vipRide__hoursBtn" data-vipride-hours-minus>&#8722;</button>
                <div class="vipRide__hoursDisplay">
                  <span class="vipRide__hoursValue" data-vipride-hours-value>4</span>
                  <span class="vipRide__hoursUnit" data-vipride-hours-unit>{{ section.settings.hours_unit | default: 'hours' }}</span>
                </div>
                <button type="button" class="vipRide__hoursBtn" data-vipride-hours-plus>&#43;</button>
              </div>
              <input type="hidden" data-vipride-hours-input value="4">
              <div class="vipRide__hoursHint" data-vipride-hours-hint>{{ section.settings.hours_hint | default: 'Minimum 3 hours, maximum 12 hours' }}</div>
            </div>
            <button type="button" class="vipRide__stepNext" data-vipride-step1-next disabled>{{ section.settings.see_prices_text | default: 'Continue' }} &#8250;</button>
          </div>
        </div>

      </div>

      <input type="date" id="vipDate-{{ section.id }}" data-vipride-date style="display:none">
      <input type="time" data-vipride-time style="display:none">

      <div class="vipRide__step" data-vipride-step-panel="3" hidden>
        <div class="vipRide__prices" data-vipride-prices>
          <div class="vipRide__pricesHeader">
            <span class="vipRide__pricesTitle" data-vipride-prices-title>{{ section.settings.choose_ride_text }}</span>
          </div>
          <div class="vipRide__rideList" role="list">
            {% for block in section.blocks %}
              {% assign p = block.settings.product %}
              {% assign v = nil %}
              {% if p and p.variants.size > 0 %}{% assign v = p.selected_or_first_available_variant %}{% endif %}
              {% if forloop.index0 == 0 %}{% assign card_tier = 'vip' %}{% elsif forloop.index0 == 1 %}{% assign card_tier = 'premium' %}{% else %}{% assign card_tier = 'comfort' %}{% endif %}
              {% assign card_desc = block.settings.desc %}{% if card_desc == blank %}{% if card_tier == 'vip' %}{% assign card_desc = 'Spacious • Leather • Snacks & Drinks' %}{% elsif card_tier == 'premium' %}{% assign card_desc = 'Comfort • Climate • Charger' %}{% else %}{% assign card_desc = 'Clean • Safe • Efficient' %}{% endif %}{% endif %}
              <button type="button"
                class="vipRide__rideCard{% if block.settings.disabled %} vipRide__rideCard--disabled{% endif %}"
                role="listitem" data-vipride-card
                data-title="{{ block.settings.title | escape }}"
                data-seats="{{ block.settings.seats }}"
                data-desc="{{ block.settings.desc | default: card_desc | escape }}"
                data-price="{% if v %}{{ v.price | money }}{% else %}{{ block.settings.manual_price | escape }}{% endif %}"
                data-rate="{{ block.settings.vehicle_rate }}"
                data-variant-id="{% if v %}{{ v.id }}{% endif %}"
                data-block-id="{{ block.id }}"
                data-hourly-price="{{ block.settings.hourly_rate | default: block.settings.vehicle_rate }}"
                data-badge="{{ card_tier | upcase }}"
                {% if block.settings.disabled %}disabled data-disabled="true"{% endif %}>
                <div class="vipRide__rideImg">
                  {% if block.settings.image %}
                    {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', class: 'vipRide__rideImgTag', alt: block.settings.title }}
                  {% else %}
                    <div class="vipRide__rideImgPh">&#128664;</div>
                  {% endif %}
                </div>
                <div class="vipRide__rideMeta">
                  <div class="vipRide__rideNameRow"><div class="vipRide__rideName">{{ block.settings.title }}</div><span class="vipRide__badgeWrap" data-vipride-tier="{{ card_tier }}"><span class="vipRide__badge vipRide__badge--{{ card_tier }}"><i class="vipRide__badgeIcon{% if card_tier == 'comfort' %} vipRide__badgeIcon--lg{% endif %}">{% if card_tier == 'vip' %}<svg width="13" height="13" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" overflow="visible"><path d="M8 8h12l3.5 5-9.5 10L4.5 13zm-3.5 5h19M9 13l5 10M19 13l-5 10"/><path class="vrSpk" d="M3 4l1 2 2 1-2 1-1 2-1-2-2-1 2-1z" fill="currentColor" stroke="none"/><path class="vrSpk vrSpk2" d="M25 5l1 2 1.5.5L26 8l-1 2-1-2-1.5-.5L24 7z" fill="currentColor" stroke="none"/><path class="vrSpk vrSpk3" d="M3 22l1 2 1.5.5L4 25l-1 2-1-2-1.5-.5L2 24z" fill="currentColor" stroke="none"/></svg>{% elsif card_tier == 'premium' %}★{% else %}✦{% endif %}</i>{{ card_tier | upcase }}</span><span class="vipRide__tierTip vipRide__tierTip--{{ card_tier }}" hidden></span></span></div>
                  {% if card_desc != blank %}<div class="vipRide__rideDesc">{{ card_desc }}</div>{% endif %}
                  <div class="vipRide__rideEtaRow">
                    <div class="vipRide__rideEta" data-vipride-eta>--</div>
                    <span class="vipRide__seats"><span class="vipRide__personIcon">&#128100;</span>{{ block.settings.seats }}</span>
                  </div>
                  <div class="vipRide__ridePrice" data-vipride-card-price>{% if v %}{{ v.price | money }}{% else %}{{ block.settings.manual_price }}{% endif %}</div>
                </div>
              </button>
            {% endfor %}
          </div>
          <div class="vipRide__rideDetail" data-vipride-detail hidden>
            <div class="vipRide__rideDetail__desc" data-vipride-detail-desc></div>
            <div class="vipRide__rideDetail__row">
              <div class="vipRide__rideDetail__meta"><span data-vipride-detail-eta>--</span><span class="vipRide__rideDetail__sep">•</span><span data-vipride-detail-seats>--</span><svg width="13" height="13" viewBox="0 0 24 24" fill="rgba(255,255,255,.45)" style="margin-left:-2px"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg></div>
              <div class="vipRide__rideDetail__price" data-vipride-detail-price>--</div>
            </div>
          </div>
          <div class="vipRide__actionBtns" data-vipride-action-btns hidden role="group" aria-label="Ride actions">
            <button type="button" class="vipRide__paymentBtn" data-vipride-payment-btn aria-label="Select payment method">
              <span class="vipRide__payBtnIcon" aria-hidden="true" style="width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:rgba(255,255,255,.1)">
                <svg width="18" height="12" viewBox="0 0 18 12" fill="none"><rect x="1" y="1" width="16" height="10" rx="2" stroke="#fff" stroke-width="1.2"/><path d="M1 4.5h16" stroke="#fff" stroke-width="1.2"/></svg>
              </span>
              <span class="vipRide__payBtnLabel" data-vipride-rc-heading>Payment Method</span>
              <svg aria-hidden="true" width="7" height="12" viewBox="0 0 7 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:.4"><path d="M1 1l5 5-5 5"/></svg>
            </button>
            <button type="button" class="vipRide__requestBtn" data-vipride-request-btn disabled aria-label="Request ride"><span data-vipride-request-text>Request Ride</span></button>
          </div>

          <form class="vipRide__ctaForm" data-vipride-form style="display:none">
            <input type="hidden" name="id" value="" data-vipride-booking-variant>
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="properties[Booking Type]" value="ride" data-vipride-prop="bookingType">
            <input type="hidden" name="properties[Pickup]" value="" data-vipride-prop="pickup">
            <input type="hidden" name="properties[Dropoff]" value="" data-vipride-prop="dropoff">
            <input type="hidden" name="properties[Hours]" value="" data-vipride-prop="hours">
            <input type="hidden" name="properties[Date]" value="" data-vipride-prop="date">
            <input type="hidden" name="properties[Time]" value="" data-vipride-prop="time">
            <input type="hidden" name="properties[Vehicle]" value="" data-vipride-prop="vehicle">
            <input type="hidden" name="properties[Estimated Price]" value="" data-vipride-prop="price">
          </form>
        </div>
      </div>

      <div class="vipRide__payOverlay" data-vipride-pay-overlay hidden>
        <div class="vipRide__payOverlay__header">
          <button type="button" class="vipRide__payOverlay__back" data-vipride-pay-close aria-label="Back">
            <svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 7H1M7 1L1 7l6 6"/></svg>
          </button>
          <h3 class="vipRide__payOverlay__title" data-vipride-pay-heading>Payment Method</h3>
        </div>
        <div class="vipRide__payOverlay__list">
          <button type="button" class="vipRide__payOption" data-vipride-pay-option="apple_pay">
            <span class="vipRide__payIcon" style="background:#000;display:flex;align-items:center;justify-content:center">
              <svg width="14" height="17" viewBox="0 0 14 17" fill="#fff"><path d="M11.54 8.94c-.02-1.7 1.39-2.52 1.45-2.56-.79-1.16-2.02-1.32-2.46-1.34-1.04-.1-2.04.62-2.57.62-.54 0-1.36-.6-2.23-.59-1.15.02-2.2.67-2.79 1.7-1.2 2.07-.31 5.13.85 6.81.57.82 1.24 1.74 2.13 1.71.86-.04 1.18-.55 2.21-.55s1.33.55 2.23.53c.92-.01 1.51-.84 2.07-1.67.65-.96.92-1.88.94-1.93-.02-.01-1.81-.69-1.83-2.73zM9.79 3.82c.47-.57.79-1.37.7-2.16-.68.03-1.5.45-1.99 1.03-.43.5-.82 1.31-.72 2.08.76.06 1.54-.39 2.01-.95z"/></svg>
            </span>
            <span class="vipRide__payLabel" data-vipride-pay-apple>Apple Pay</span>
            <span class="vipRide__payCheck" aria-hidden="true"></span>
          </button>
          <button type="button" class="vipRide__payOption" data-vipride-pay-option="google_pay">
            <span class="vipRide__payIcon" style="background:#fff">
              <svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09A6.97 6.97 0 015.5 12c0-.72.12-1.42.34-2.09V7.07H2.18A11.96 11.96 0 001 12c0 1.94.46 3.77 1.18 5.42l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            </span>
            <span class="vipRide__payLabel" data-vipride-pay-google>Google Pay</span>
            <span class="vipRide__payCheck" aria-hidden="true"></span>
          </button>
          <button type="button" class="vipRide__payOption" data-vipride-pay-option="card">
            <span class="vipRide__payIcon" style="background:rgba(255,255,255,.1)">
              <svg width="22" height="16" viewBox="0 0 22 16" fill="none"><rect x="1" y="1" width="20" height="14" rx="2.5" stroke="#fff" stroke-width="1.3"/><path d="M1 5.5h20" stroke="#fff" stroke-width="1.3"/><rect x="3" y="9" width="5" height="2" rx="1" fill="rgba(255,255,255,.3)"/></svg>
            </span>
            <span class="vipRide__payLabel" data-vipride-pay-card>Debit / Credit Card</span>
            <span class="vipRide__payCheck" aria-hidden="true"></span>
          </button>
          <button type="button" class="vipRide__payOption vipRide__payOption--test" data-vipride-pay-option="test_mode" data-vr-test-only hidden>
            <span class="vipRide__payIcon" style="background:rgba(232,197,71,.1);border:1px solid rgba(232,197,71,.3)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E8C547" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>
            </span>
            <span class="vipRide__payLabel"><span data-vipride-pay-test-label>Test Mode</span><span data-vipride-pay-test-sub style="font-size:10px;color:rgba(232,197,71,.6);display:block;font-weight:500;margin-top:1px">Simulate payment</span></span>
            <span class="vipRide__payCheck" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <div class="vipRide__scheduleOverlay" data-vipride-schedule-overlay hidden>
        <div class="vipRide__schedPage" data-vipride-sched-page="date">
          <div class="vipRide__schedHeader">
            <button type="button" class="vipRide__schedBackBtn" data-vipride-sched-back-cal>
              <svg width="10" height="16" viewBox="0 0 10 16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2L2 8l6 6"/></svg>
            </button>
            <div>
              <h3 class="vipRide__schedTitle" data-vipride-sch-heading>Schedule a Ride</h3>
              <p class="vipRide__schedSub" data-vipride-sch-sub>Choose a date for your ride</p>
            </div>
            <span class="vipRide__schedHeaderIcon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#E8C547"><rect x="3" y="4" width="18" height="18" rx="2" stroke="#E8C547" stroke-width="1.5" fill="none"/><path d="M3 9h18" stroke="#E8C547" stroke-width="1.5"/><path d="M8 2v4M16 2v4" stroke="#E8C547" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
          </div>
          <div class="vipRide__schedQuickChips"><button class="vipRide__schedChip" data-quick-date="today" data-vipride-sch-today>Today</button><button class="vipRide__schedChip" data-quick-date="tomorrow" data-vipride-sch-tomorrow>Tomorrow</button><button class="vipRide__schedChip" data-quick-date="weekend" data-vipride-sch-weekend>Weekend</button></div>
          <div class="vipRide__schedCalendar" data-vipride-sched-calendar></div>
          <div class="vipRide__schedFooter">
            <label class="vipRide__schedToggle">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#E8C547"><path d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>
              <span data-vipride-sch-airport-label>Airport trip</span>
              <input type="checkbox" data-vipride-sched-airport>
              <span class="vipRide__schedToggleTrack"><span class="vipRide__schedToggleThumb"></span></span>
            </label>
            <button type="button" class="vipRide__schedNextBtn" data-vipride-sched-next disabled>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <span data-vipride-sch-seltime>Select Time</span>
            </button>
          </div>
        </div>
        <div class="vipRide__schedPage" data-vipride-sched-page="time" hidden>
          <div class="vipRide__schedHeader">
            <button type="button" class="vipRide__schedBackBtn" data-vipride-sched-back>
