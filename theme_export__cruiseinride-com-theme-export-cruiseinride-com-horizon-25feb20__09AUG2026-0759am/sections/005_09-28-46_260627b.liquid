      <div class="vipRide__authInput"><svg class="vipRide__authInput__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M22 7l-10 7L2 7"/></svg><input type="email" class="vipRide__authInput__field" data-vipride-reg-email data-vipride-su-email-input placeholder="Email address" autocomplete="email" inputmode="email"></div>
      <button type="button" class="vipRide__authBtn vipRide__authBtn--dark" data-vipride-reg-email-btn data-vipride-su-email>Continue with Email</button>
      <div class="vipRide__authDivider"><span data-vipride-or-label>OR</span></div>
      <button type="button" class="{{ _ab }}" data-vipride-reg-phone-btn data-vipride-su-phone><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>Continue with Phone</button>
      <button type="button" class="{{ _ab }}" data-vipride-reg-google-btn data-vipride-su-google>Continue with Google</button>
      <button type="button" class="{{ _ab }}" data-vipride-reg-apple-btn data-vipride-su-apple>Continue with Apple</button>
      <div class="vipRide__authDivider"><span data-vipride-or-label>OR</span></div>
      <button type="button" class="vipRide__authBtn vipRide__authBtn--gold" data-vipride-auth-goto-signin2 data-vipride-su-signin>Sign in</button>
      <p class="vipRide__authTerms" data-vipride-terms>By continuing, you agree to our <a href="/policies/terms-of-service" target="_blank">Terms</a> and <a href="/policies/privacy-policy" target="_blank">Privacy Policy</a></p>
    </div>
  </div>
  <div class="vipRide__authPage vipRide__wizard" data-vipride-wizard hidden>
    <button type="button" class="vipRide__authPage__back" data-vipride-wizard-back aria-label="Back"><svg width="10" height="18" viewBox="0 0 10 18" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 1L1 9l8 8"/></svg></button>
    <div class="vipRide__authPage__content vipRide__wizard__content" data-vipride-wizard-content>
    </div>
  </div>
  <div class="vipRide__authPage" data-vipride-auth-signin hidden>
    <button type="button" class="vipRide__authPage__back" data-vipride-auth-back-signin aria-label="Back"><svg width="10" height="18" viewBox="0 0 10 18" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 1L1 9l8 8"/></svg></button>
    <div class="vipRide__authPage__content">
      <h1 class="vipRide__authPage__heading" data-vipride-si-title>Sign in</h1>
      <p class="vipRide__authPage__sub" data-vipride-si-sub>Welcome back! Enter your credentials.</p>
      <div class="vipRide__authInput"><svg class="vipRide__authInput__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M22 7l-10 7L2 7"/></svg><input type="text" class="vipRide__authInput__field" data-vipride-login-id data-vipride-si-user placeholder="Email or phone number" autocomplete="email" inputmode="email"></div>
      <div class="vipRide__authInput"><svg class="vipRide__authInput__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg><input type="password" class="vipRide__authInput__field" data-vipride-login-pass data-vipride-si-pass placeholder="Password" autocomplete="current-password"></div>
      <button type="button" class="vipRide__authBtn vipRide__authBtn--primary" data-vipride-login-submit data-vipride-si-btn>Sign In</button>
      <div class="vipRide__authDivider"><span data-vipride-or-label>OR</span></div>
      <button type="button" class="{{ _ab }}" data-vipride-login-google data-vipride-si-google>Continue with Google</button>
      <button type="button" class="{{ _ab }}" data-vipride-login-apple data-vipride-si-apple>Continue with Apple</button>
      <div class="vipRide__authDivider"><span data-vipride-or-label>OR</span></div>
      <button type="button" class="vipRide__authBtn vipRide__authBtn--gold" data-vipride-auth-goto-create2 data-vipride-si-create>Create Account</button>
      <div class="vipRide__authError" data-vipride-login-error hidden></div>
    </div>
  </div>

  {% render 'ride-request-airport' %}

</section>

