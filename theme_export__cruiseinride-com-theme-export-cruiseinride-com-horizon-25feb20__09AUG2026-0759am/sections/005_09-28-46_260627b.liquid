.vipRide__hoursHint{font-size:var(--fs-xs);color:rgba(255,255,255,.45);text-align:center;margin-top:3px}

.vipRide__stepNext{width:100%;background:var(--gold)!important;color:#000!important;border:none!important;border-radius:var(--radius-sm);padding:clamp(11px,3vw,14px) 16px;font-size:var(--fs-sm);font-weight:800;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;touch-action:manipulation;box-shadow:0 5px 18px rgba(212,175,55,.3);transition:opacity 180ms,transform 180ms;margin-top:4px;overflow:visible}
.vipRide__stepNext[disabled]{background:rgba(212,175,55,.2)!important;color:rgba(255,255,255,.3)!important;box-shadow:none;cursor:not-allowed;pointer-events:none}
.vipRide__stepNext:not([disabled]):hover{opacity:.9;transform:translateY(-1px)}
.vipRide__stepBack{display:inline-flex;align-items:center;gap:4px;background:none;border:none;color:rgba(212,175,55,.8);font-size:var(--fs-sm);font-weight:600;cursor:pointer;padding:0 0 6px;touch-action:manipulation;overflow:visible}
