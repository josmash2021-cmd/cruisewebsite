.vR-app__shadow{position:absolute;bottom:-24px;left:50%;transform:translateX(-50%);width:72%;height:28px;border-radius:50%;background:radial-gradient(ellipse,rgba(0,0,0,.6),transparent 70%);filter:blur(18px);animation:vRshadow 15s ease-in-out infinite}
@keyframes vRshadow{0%,100%{width:72%;opacity:.78}50%{width:60%;opacity:.5}}
.vR-app__phone{position:absolute;inset:0;transform-style:preserve-3d;animation:vRfloat 5.5s ease-in-out infinite;will-change:transform;backface-visibility:hidden;-webkit-backface-visibility:hidden}
@keyframes vRfloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-8px,0)}}
.vR-app__rotor{position:absolute;inset:0;transform-style:preserve-3d;animation:vRsw 11s cubic-bezier(.445,.05,.55,.95) infinite;will-change:transform;backface-visibility:hidden;-webkit-backface-visibility:hidden}
@keyframes vRsw{
  0%,100%{transform:rotateY(-22deg) rotateX(6deg) rotateZ(2.5deg);}
  50%    {transform:rotateY(22deg)  rotateX(6deg) rotateZ(-2.5deg);}
}
.vR-app__frame{position:absolute;inset:0;border-radius:34px;background:linear-gradient(160deg,#1e1e20,#131315 40%,#0c0c0e);box-shadow:inset 0 .5px 0 rgba(255,255,255,.15),inset 0 0 0 1.5px #7d7d82,inset 0 0 0 2.5px #3e3e42,0 0 0 .5px rgba(0,0,0,.9),0 8px 24px rgba(0,0,0,.4),0 20px 50px rgba(0,0,0,.5),0 40px 80px rgba(0,0,0,.35);padding:5px;overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden}
