.vR-app__endCTA__icon{position:relative;width:62px;height:62px;border-radius:50%;background:linear-gradient(145deg,#fff,#f0f0f2);display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 3px rgba(232,197,71,.25),0 0 40px rgba(232,197,71,.5),0 8px 20px rgba(0,0,0,.5);animation:vRendB 1.8s ease-in-out infinite;overflow:hidden}
