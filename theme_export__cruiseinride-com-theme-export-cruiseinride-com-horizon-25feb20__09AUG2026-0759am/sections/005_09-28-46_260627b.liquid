.vipRide__driverCard{background:rgba(13,20,45,.96);border-radius:22px;padding:18px 18px 16px;display:flex;flex-direction:column;gap:14px;box-shadow:0 8px 40px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.06);animation:vipDriverCardIn 650ms cubic-bezier(.2,.8,.2,1) 200ms both}
