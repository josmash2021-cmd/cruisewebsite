.vipRide__driverCard__vehicle{font-size:clamp(13px,3.6vw,15px);color:rgba(255,255,255,.62);margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.2px;font-weight:500}
